{
  // Cloudflare Pages project phantomburn (phantomburn.net), in the same
  // shape as Harkfell's and Crash The Stack's sites: the wasm lives in R2,
  // content-addressed and never deleted, and a Pages Function
  // (functions/w/[[path]].js) serves it same-origin with CORP/COEP. The
  // binding is declared here and `wrangler pages deploy` applies it with the
  // deployment, so no dashboard setting is involved. The project and the
  // bucket are created once, by David: scripts/cloudflare-setup --create.
  //
  // The wasm's path, /w/<sha16>/phantom-burn.wasm, is at the root on purpose:
  // it is named by the wasm's own hash, so it stays the same whichever path
  // the game's page is served from (/badge-in/, and the older paths that
  // redirect there).
  //
  // scripts/publish-web deploys the tree check-site.mjs verified (a temporary
  // copy, the wasm moved to R2), so the directory below is only the default
  // for a bare `wrangler pages deploy`, which nothing here runs.
  "name": "phantomburn",
  "pages_build_output_dir": "build/site",
  // 2026-07-14 is the newest date this box's wrangler (4.112.0) workerd
  // supports; a later one makes `wrangler pages dev` refuse to start.
  "compatibility_date": "2026-07-14",
  "r2_buckets": [
    {
      "binding": "WASM",
      "bucket_name": "phantomburn-wasm"
    }
  ]
}
