;; floors/root-room.floor - the root key console's room at the top of the
;; tower (floor 60), as a placeholder: the title screen draws it live behind
;; the menu, so the player stares at the goal from the first second without
;; knowing it. Dark but for the console's violet glow, the racks' status
;; lights, the exit sign and the city through the window.
;;
;; Things are placed from the room (in: against: from:), so reshaping the
;; room carries them with it.
(floor
  level: 60
  intent: "the one machine the Net can't reach; the goal, seen before you know it"
  tier-in: admin  tier-out: root
  ambient: (hvac 0.2 servers 0.5 city 0.3)
  rooms:
  ((key-room   corners: ((0 0) (9 0) (9 7) (0 7))
               floor: 0    ceiling: 3.6  surface: raised  light: none))
  openings:
  ((window  in: key-room  along: ((2.5 0) (6.5 0))  sill: 0.9  head: 3.0)
   (exit    in: key-room  at: (4.5 7)  reader: admin))
  things:
  ((prop  kind: root-console  in: key-room  from: (centre (0 0.3)))
   (prop  kind: server-rack   in: key-room  against: west  from: (south 1.6))
   (prop  kind: server-rack   in: key-room  against: west  from: (south 2.2))
   (prop  kind: server-rack   in: key-room  against: west  from: (south 2.8))
   (prop  kind: server-rack   in: key-room  against: east  from: (north 1.6))
   (prop  kind: server-rack   in: key-room  against: east  from: (north 2.2))
   (prop  kind: cable-tray    in: key-room  from: (centre (0 -1.6))  z: 3.15)
   (prop  kind: cable-tray    in: key-room  from: (centre (0 1.9))  z: 3.15))
  views: ((title      at: (1.3 1.0 1.7)  look: (4.5 3.9 1.2)  lens: 24)
          (title-end  at: (7.6 1.3 1.6)  look: (4.5 3.9 1.2)  lens: 24))
  start: (4.5 5.8)  facing: 270)
