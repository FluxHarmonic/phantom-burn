(import (sigil test)
        (phantom app flow))

(test-group "One application across floors"
  (test "cold title delay consumes no selection or load, then INFILTRATE starts"
    (let ((flow (make-app-flow #f)))
      (assert-equal 'title (app-flow-phase flow))
      (assert-equal 0 (app-flow-selection flow))
      (app-flow-advance! flow 0.8)
      (assert-false (app-flow-menu! flow '(down return) #f))
      (assert-equal 0 (app-flow-selection flow))
      (app-flow-advance! flow 0.1)
      (assert-false (app-flow-menu! flow '(escape) #f))
      (assert-equal '(load 1 "14") (app-flow-menu! flow '(down return) #f))
      (assert-equal 'loading (app-flow-phase flow))
      (assert-false (app-flow-menu! flow '(up return) 0))
      (assert-true (app-flow-ready! flow 1 "14"))
      (assert-equal 'game (app-flow-phase flow))))

  (test "quit or results callbacks defer scene replacement to the next frame"
    (let ((flow (make-app-flow #f)))
      (app-flow-load! flow "14")
      (app-flow-ready! flow 1 "14")
      (app-flow-practice-done! flow)
      (app-flow-request-title! flow)
      (app-flow-request-title! flow)
      (assert-equal 'game (app-flow-phase flow))
      (assert-equal '(title) (app-flow-advance! flow 0.1))
      (assert-equal 'title (app-flow-phase flow))
      (assert-equal 2 (app-flow-generation flow))
      (assert-equal 1 (app-flow-selection flow))
      (assert-false (app-flow-menu! flow '(return) #f))))

  (test "cancelling a load rejects its late result and failure"
    (let ((flow (make-app-flow #f)))
      (app-flow-load! flow "14")
      (app-flow-request-title! flow)
      (assert-false (app-flow-current-load? flow 1 "14"))
      (app-flow-advance! flow 0.0)
      (assert-equal '(load 3 "sim") (app-flow-load! flow "sim"))
      (assert-false (app-flow-ready! flow 1 "14"))
      (assert-false (app-flow-failed! flow 1 "14" "late failure"))
      (assert-equal 'loading (app-flow-phase flow))
      (assert-false (app-flow-error flow))
      (assert-true (app-flow-ready! flow 3 "sim"))))

  (test "same-floor reentry is a new attempt, never an old transport completion"
    (let ((flow (make-app-flow #t)))
      (app-flow-load! flow "14")
      (app-flow-ready! flow 1 "14")
      (app-flow-request-title! flow)
      (app-flow-advance! flow 0.0)
      (app-flow-advance! flow 1.0)
      (assert-equal '(load 3 "14") (app-flow-menu! flow '(return) #f))
      (assert-false (app-flow-ready! flow 1 "14"))
      (assert-false (app-flow-ready! flow 3 "sim"))
      (assert-true (app-flow-ready! flow 3 "14"))))

  (test "a current failure can return to the title without relaunching"
    (let ((flow (make-app-flow #t)))
      (app-flow-load! flow "14")
      (assert-true (app-flow-failed! flow 1 "14" "network unavailable"))
      (assert-equal 'failed (app-flow-phase flow))
      (assert-equal "network unavailable" (app-flow-error flow))
      (app-flow-request-title! flow)
      (assert-equal '(title) (app-flow-advance! flow 0.0))
      (assert-false (app-flow-error flow))
      (assert-true (app-flow-practiced? flow))))

  (test "ordered activation and a tap on item zero preserve the selected floor"
    (let ((flow (make-app-flow #f)))
      (app-flow-advance! flow 1.0)
      (assert-equal '(load 1 "14")
                    (app-flow-menu! flow '(down return up) #f)))
    (let ((flow (make-app-flow #t)))
      (app-flow-advance! flow 1.0)
      (assert-equal '(load 1 "sim") (app-flow-menu! flow '() 0)))))

(run-tests)
