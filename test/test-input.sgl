;;; Physical/synthetic input and legacy phone payloads remain compatible.
(import (sigil test)
        (sigil math)
        (phantom input state))

(define (send-input input type payload)
  (assert-true (web-input-dispatch! input type payload)))

(test-group "Phantom input state compatibility"
  (test "the shell tap payload retains the same per-component fallback"
    (assert-equal '(10 . 20) (web-input-pair "10,20"))
    (assert-equal '(0 . 20) (web-input-pair "bad,20"))
    (assert-equal '(10 . 0) (web-input-pair "10,20,30"))
    (assert-equal '(0 . 0) (web-input-pair "missing-comma")))
  (test "auto-repeat is one edge, but a release and repress is another"
    (let ((input (make-web-input)))
      (send-input input "keydown" "w")
      (send-input input "keydown" "W")
      (assert-equal '(w) (web-input-pressed input))
      (assert-true (web-input-held? input 'w))
      (send-input input "keyup" "w")
      (send-input input "keydown" "w")
      (assert-equal '(w w) (web-input-pressed input))))
  (test "physical and synthetic presses retain their exact menu order"
    (let ((input (make-web-input)))
      (send-input input "keydown" "ArrowUp")
      (send-input input "press" "c")
      (send-input input "keydown" "ArrowDown")
      (send-input input "press" "start")
      (assert-equal '(start down c up) (web-input-pressed input))
      (assert-equal '(up c down start) (reverse (web-input-pressed input)))
      (assert-false (web-input-held? input 'start))))
  (test "Ctrl stays a press without enabling run and deck or T stays held"
    (let ((input (make-web-input)))
      (send-input input "keydown" "Control")
      (assert-equal '(control) (web-input-pressed input))
      (assert-false (web-input-held? input 'control))
      (send-input input "keydown" "deck")
      (send-input input "keydown" "T")
      (send-input input "keyup" "deck")
      (assert-true (web-input-held? input 'deck))
      (send-input input "keydown" "deck")
      (send-input input "keyup" "T")
      (assert-true (web-input-held? input 'deck))
      (send-input input "keyup" "deck")
      (assert-false (web-input-held? input 'deck))))
  (test "mouse deltas accumulate with legacy per-component fallback"
    (let ((input (make-web-input)))
      (send-input input "look" "2,3")
      (send-input input "look" "bad,4")
      (send-input input "look" "missing-comma")
      (web-input-clear-pressed! input)
      (assert-equal '(2 . 7) (web-input-take-look! input))
      (assert-equal '(0 . 0) (web-input-take-look! input))))
  (test "legacy sticks retain raw vectors and component reset semantics"
    (let ((input (make-web-input)))
      (send-input input "move" "bad,0.5")
      (assert-equal '(0 . 0.5) (web-input-stick input "move"))
      (send-input input "move" "1,2,3")
      (assert-equal '(1 . 0) (web-input-stick input "move"))
      (send-input input "lookstick" "0.5,bad")
      (assert-equal '(0.5 . 0) (web-input-stick input "look"))
      (send-input input "move" "3,4")
      (assert-equal '(3 . 4) (web-input-stick input "move"))
      (send-input input "move" "missing-comma")
      (assert-equal '(0 . 0) (web-input-stick input "move"))))
  (test "shared named sticks clamp and ignore malformed updates"
    (let ((input (make-web-input)))
      (send-input input "stick" "move,3,4")
      (let ((vector (web-input-stick input "move")))
        (assert-true (< (abs (- (car vector) 0.6)) 1e-12))
        (assert-true (< (abs (- (cdr vector) 0.8)) 1e-12))
        (send-input input "stick" "move,bad,0.5")
        (assert-equal vector (web-input-stick input "move")))
      (send-input input "stick" "look,0.25,-0.5")
      (assert-equal '(0.25 . -0.5) (web-input-stick input "look"))))
  (test "frame and flow resets retain the old distinction between state parts"
    (let ((input (make-web-input)))
      (send-input input "keydown" "w")
      (send-input input "move" "0.25,0.5")
      (send-input input "look" "9,-2")
      (web-input-clear-pressed! input)
      (assert-equal '() (web-input-pressed input))
      (assert-true (web-input-held? input 'w))
      (assert-equal '(9 . -2) (web-input-take-look! input))
      (send-input input "look" "5,6")
      (web-input-clear-keys! input)
      (assert-false (web-input-held? input 'w))
      (assert-equal '() (web-input-pressed input))
      (assert-equal '(0 . 0) (web-input-take-look! input))
      (assert-equal '(0.25 . 0.5) (web-input-stick input "move"))))
  (test "blur discards physical and synthetic edges, deltas and both sticks"
    (let ((input (make-web-input)))
      (send-input input "keydown" "w")
      (send-input input "press" "start")
      (send-input input "look" "9,-2")
      (send-input input "move" "0.5,0.5")
      (send-input input "lookstick" "0.25,-0.5")
      (send-input input "blur" "")
      (assert-false (web-input-held? input 'w))
      (assert-equal '() (web-input-pressed input))
      (assert-equal '(0 . 0) (web-input-take-look! input))
      (assert-equal '(0.0 . 0.0) (web-input-stick input "move"))
      (assert-equal '(0.0 . 0.0) (web-input-stick input "look"))
      (send-input input "keydown" "w")
      (assert-equal '(w) (web-input-pressed input))))
  (test "extra shared DOM names stay ignored and game events fall through"
    (let ((input (make-web-input)))
      (send-input input "keydown" "F1")
      (send-input input "keydown" "Tab")
      (assert-equal '() (web-input-pressed input))
      (assert-false (web-input-dispatch! input "frame" "16"))
      (assert-false (web-input-dispatch! input "tap" "10,20")))))
