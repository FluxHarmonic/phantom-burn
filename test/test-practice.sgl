;;; PRACTICE (D38; tasks/phantom-burn-practice; topics/phantom-burn-practice-api):
;;; Crash's sim, driven headless as the game drives it: the walker, then
;;; play-tick!, then practice-tick!.
;;;
;;; The gates: a scripted run through all eight rooms meets each lesson's
;;; goal; every Crash line fires exactly once, at its trigger; a capture
;;; resets only its room. Each has a sabotage.

(import (sigil test)
        (sigil math)
        (sigil list)
        (sigil fs)
        (phantom soup)
        (phantom walker)
        (phantom play data)
        (phantom play devices)
        (phantom play core)
        (phantom play practice)
        (phantom guard guard))

(define DIR "assets/floors/sim/")
(define C (pbc1->collision (read-file-bytes (string-append DIR "collide"))))
(define INFO (floor-info-from-string (read-file-string (string-append DIR "floor.sexp"))))
(define DATA (play-data-from-string (read-file-string (string-append DIR "play.sexp"))))
(define CIRCUITS (cdr (assq 'circuits INFO)))

;; The circuits: all on, switched by the deck's light commands.
(define *off* '())
(define (on? c) (not (memq c *off*)))
(define (switch! r)
  (when (and (pair? r) (eq? (car r) 'lights))
    (if (eq? (caddr r) 'lights-off)
        (set! *off* (cons (cadr r) *off*))
        (set! *off* (filter (lambda (c) (not (eq? c (cadr r)))) *off*)))))

;; The run's state: the play, the practice and the walker.
(define P #f) (define PR #f) (define W #f)
(define (fresh!)
  (set! *off* '())
  (set! P (play-reset! (make-play C DATA CIRCUITS)))
  (set! PR (make-practice DATA))
  (set! W (practice-start-walker PR P)))

(define PI2 (* 2.0 3.141592653589793))
(define (wrap a) (let loop ((a a)) (cond ((> a 3.141592653589793) (loop (- a PI2))) ((< a -3.141592653589793) (loop (+ a PI2))) (else a))))

;; One tick: the walker with input in, the rules, the lessons. The lessons'
;; caught (a camera's alarm) and the play's are the caller's to handle.
(define (tick! in)
  (set! W (walker-step W in TICK C))
  (play-tick! P W on? 1.0 2.0)
  (practice-tick! PR P))

(define (wait! n) (let loop ((i 0)) (when (< i n) (tick! NO-INPUT) (loop (+ i 1)))))

;; Walk (or sneak, or run) to (x y): face it, then forward. Stops within
;; 0.3 m or after n ticks. Returns #t when there.
(define (go! x y gait . n)
  (let ((limit (if (pair? n) (car n) 900)))
    (let loop ((i 0))
      (let* ((dx (- x (walker-x W))) (dy (- y (walker-y W))))
        (cond ((< (+ (* dx dx) (* dy dy)) 0.09) #t)
              ((>= i limit) #f)
              ((not (eq? (play-outcome P) 'playing)) #f)
              (else
               (let ((dyaw (wrap (- (atan (- dx) dy) (walker-yaw W)))))
                 (tick! (make-input 0.0 1.0 dyaw 0.0 (eq? gait 'sneak) (eq? gait 'run) #f 0))
                 (loop (+ i 1)))))))))

;; Look at (x y z) from where you stand.
(define (look-at! x y z)
  (let* ((dx (- x (walker-x W))) (dy (- y (walker-y W))) (dz (- z (walker-eye-z W)))
         (yaw (atan (- dx) dy)) (pitch (atan dz (sqrt (+ (* dx dx) (* dy dy))))))
    (tick! (make-input 0.0 0.0 (wrap (- yaw (walker-yaw W))) (- pitch (walker-pitch W)) #f #f #f 0))))

;; Hold the deck n ticks; the light commands switch the circuits.
(define (hold! n)
  (let loop ((i 0) (last #f))
    (if (< i n)
        (let ((r (play-deck! P W #t on?)))
          (switch! r)
          (when (and (pair? r) (memq (car r) '(run lights))) (practice-note-command! PR P (caddr r) 'deck))
          (tick! NO-INPUT)
          (loop (+ i 1) (or r last)))
        (begin (play-deck! P W #f on?) last))))

(define (lesson-now) (practice-lesson PR))
(define (said) (practice-lines-said PR))
(define (show label) (display (list label 'at (walker-x W) (walker-y W) 'lesson (lesson-now) 'outcome (play-outcome P)
                                    'unit (play-active-unit P) (guard-state (play-guard P)) 'vis (play-visibility P)))
                     (newline))

(define EXPECTED
  '((light . enter) (light . success) (sound . enter) (sound . success) (patrol . enter) (patrol . success)
    (deck . enter) (deck . success) (facilities . enter) (facilities . success) (camera . enter) (camera . success)
    (terminal . enter) (terminal . success) (exit . enter) (exit . success)))

(test-group "the practice gate"
  (test "THE RUN: all eight rooms, each lesson's goal met, every Crash line once at its trigger, the sim done"
    (fresh!)
    (wait! 2)
    (show 'start)
    ;; 1, light: into the dark alcove, crouched, still
    (go! 4.0 7.0 'walk) (go! 4.0 9.3 'walk)
    (tick! (make-input 0.0 0.0 0.0 0.0 #f #f #t 0))
    (wait! 90)
    (show 'alcove)
    ;; 2, sound: out, and through the bands sneaking
    (tick! (make-input 0.0 0.0 0.0 0.0 #f #f #t 0))
    (go! 4.0 6.0 'walk) (go! 7.5 4.0 'walk)
    (go! 9.0 4.0 'sneak) (show 'sound-in)
    (go! 15.5 4.0 'sneak) (show 'sound-end)
    (go! 16.8 4.0 'sneak) (show 'patrol-in)
    ;; 3, patrol: wait in the south-west corner for the unit to walk west along
    ;; the north wall, its back to the door; then walk for the door
    (go! 17.5 1.5 'walk)
    (let loop ((i 0))
      (let ((g (play-guard P)))
        (unless (or (>= i 1800) (and (> (guard-y g) 7.0) (< (guard-fx g) -0.5) (> (guard-x g) 21.5)))
          (tick! NO-INPUT) (loop (+ i 1)))))
    (show 'patrol-go)
    (go! 23.2 4.0 'walk) (go! 24.8 4.0 'walk) (show 'deck-in)
    ;; 4, the deck: ring the phone from the south-west, wait in the corner for
    ;; the unit to go to it, then along the south wall to the door
    (go! 26.0 2.5 'sneak)
    (look-at! 27.45 6.85 0.85)
    (let ((r (hold! 55))) (display (list 'deck r)) (newline))
    (go! 25.0 1.0 'sneak)
    (let loop ((i 0))
      (let* ((g (play-guard P)) (dx (- (guard-x g) 27.45)) (dy (- (guard-y g) 6.85)))
        (unless (or (>= i 900) (< (+ (* dx dx) (* dy dy)) 4.0))
          (tick! NO-INPUT) (loop (+ i 1)))))
    (show 'deck-unit-at-phone)
    (go! 31.0 1.0 'walk) (go! 31.2 4.0 'walk) (go! 32.8 4.0 'walk) (show 'facilities-in)
    ;; 5, FACILITIES: the badge, a ceiling light (the zone off), across in the dark
    (go! 33.25 7.4 'sneak) (go! 33.25 8.4 'sneak) (wait! 2) (show 'badge)
    (go! 33.25 7.7 'sneak)
    (look-at! 33.25 6.25 2.9)
    (let ((r (hold! 55))) (display (list 'lights r 'off *off*)) (newline))
    (look-at! 37.2 4.4 2.9)
    (let ((r (hold! 55))) (display (list 'vent r)) (newline))
    ;; round the south of the room, and to the door while it is at its north end
    (go! 36.0 2.5 'sneak) (go! 39.3 2.5 'sneak)
    (let loop ((i 0))
      (let ((g (play-guard P)))
        (unless (or (>= i 900) (> (guard-y g) 7.0))
          (tick! NO-INPUT) (loop (+ i 1)))))
    (go! 39.3 4.0 'sneak) (go! 40.8 4.0 'sneak) (show 'camera-in)
    ;; 6, the camera: along the north wall, under its view
    (go! 41.0 7.4 'walk) (go! 47.0 7.4 'walk) (go! 47.2 4.0 'walk) (go! 48.8 4.0 'walk) (show 'terminal-in)
    ;; 7, the terminal: sit, run a command, stand
    (go! 52.0 6.2 'walk)
    (let ((u (play-use! P W on?))) (display (list 'terminal-use u)) (newline))
    (play-terminal-key! P 'down on?)            ; the phone's row (the printer is not on this floor)
    (play-terminal-key! P 'run on?)
    (let loop ((i 0) (r #f))
      (if (and (< i 200) (not r))
          (let ((r2 (play-terminal-step! P on?)))
            (when r2 (practice-note-command! PR P (caddr r2) 'terminal))
            (tick! NO-INPUT)
            (loop (+ i 1) r2))
          (begin (display (list 'terminal-ran r (play-terminal P on?))) (newline))))
    (play-terminal-key! P 'close on?)
    (show 'terminal-done)
    (go! 55.2 4.0 'walk) (go! 56.8 4.0 'walk) (show 'exit-in)
    ;; 8, the exit: the reader
    (go! 63.2 4.0 'walk)
    (let ((u (play-use! P W on?))) (display (list 'reader u)) (newline))
    (tick! NO-INPUT)
    (show 'end)
    (display (list 'said (said) 'done (practice-done? PR))) (newline)
    (assert-true (equal? (said) EXPECTED))
    ;; each success line while you were still in its room (David: it came only
    ;; as you entered the next room, with that room's opening line)
    (let ((wrong (filter (lambda (e) (and (eq? (cadr e) 'success) (not (eq? (caddr e) (car e)))))
                         (practice-lines-where PR))))
      (display (list 'success-said-elsewhere wrong)) (newline)
      (assert-true (null? wrong)))
    (assert-true (practice-done? PR))
    (assert-equal 'won (play-outcome P)))
  (test "A CAPTURE RESETS ONLY ITS ROOM: caught in the patrol room, you and its unit start it again; the rooms before are as you left them"
    (fresh!)
    (go! 4.0 7.0 'walk) (go! 7.5 4.0 'walk) (go! 9.0 4.0 'sneak) (go! 15.5 4.0 'sneak) (go! 16.8 4.0 'sneak)
    (let ((booth-x (guard-x (play-unit-guard P 0))) (booth-y (guard-y (play-unit-guard P 0))))
      ;; stand in the patrol unit's path, lit, facing it: it hunts and catches
      (go! 22.5 3.0 'walk)
      (let loop ((i 0)) (when (and (< i 1800) (eq? (play-outcome P) 'playing)) (tick! NO-INPUT) (loop (+ i 1))))
      (display (list 'caught (play-outcome P) (said))) (newline)
      (assert-equal 'caught (play-outcome P))
      (set! W (practice-reset-room! PR P))
      (tick! NO-INPUT)
      (display (list 'reset 'at (walker-x W) (walker-y W) 'lesson (lesson-now) 'unit (guard-x (play-guard P)) (guard-y (play-guard P))
                     'booth booth-x booth-y (guard-x (play-unit-guard P 0)) (guard-y (play-unit-guard P 0)))) (newline)
      (assert-equal 'playing (play-outcome P))
      (assert-true (< (abs (- (walker-x W) 16.8)) 0.2))
      (assert-equal 3 (car (lesson-now)))
      ;; its unit back at its start (route point 0, (22.5 1))
      (assert-true (< (+ (abs (- (guard-x (play-guard P)) 22.5)) (abs (- (guard-y (play-guard P)) 1.0))) 0.3))
      ;; the sound room's unit untouched
      (assert-true (< (+ (abs (- (guard-x (play-unit-guard P 0)) booth-x)) (abs (- (guard-y (play-unit-guard P 0)) booth-y))) 1e-9))
      ;; the fail line once; the lessons before still succeeded
      (assert-equal 1 (length (filter (lambda (e) (equal? e '(patrol . fail))) (said))))
      (assert-true (member '(sound . success) (said))))))
