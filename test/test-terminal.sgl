;;; P3's terminal on floor 14 (design §3; topics/phantom-burn-device-api §3),
;;; through (phantom play core) as the game runs it: F opens it, it lists
;;; every device and lighting zone, a command takes 2.5 s from anywhere,
;;; your tier still applies, and the screen lights you while it is open.

(import (sigil test)
        (sigil math)
        (sigil fs)
        (phantom soup)
        (phantom walker)
        (phantom play data)
        (phantom play devices)
        (phantom play core))

(define DIR "assets/floors/14-slice/")
(define C (pbc1->collision (read-file-bytes (string-append DIR "collide"))))
(define INFO (floor-info-from-string (read-file-string (string-append DIR "floor.sexp"))))
(define DATA (play-data-from-string (read-file-string (string-append DIR "play.sexp"))))
(define CIRCUITS (cdr (assq 'circuits INFO)))
(define (on? c) #t)
(define DARK (lambda (c) (and (memq c '(emergency screens)) #t)))
(define PHONE (device-index DATA 'office-phone))

(define (fresh) (play-reset! (make-play C DATA CIRCUITS)))
;; in front of the FM office's terminal, 1 m from it (not near enough the badge to take it)
(define AT-DESK (make-walker 24.5 17.8 0.0 0.0))
(define (at-terminal on?)
  (let ((p (fresh)))
    (play-tick! p AT-DESK on? 1.0 2.0)
    (let ((r (play-use! p AT-DESK on?)))
      (list p r))))
(define (steps p n on?)
  (let loop ((i 0) (last #f))
    (if (< i n)
        (begin (play-tick! p AT-DESK on? 1.0 2.0)
               (loop (+ i 1) (or (play-terminal-step! p on?) last)))
        last)))
;; ticks until the terminal completes a command (at most n): its result
(define (steps-until p n on?)
  (let loop ((i 0))
    (if (>= i n)
        #f
        (begin (play-tick! p AT-DESK on? 1.0 2.0)
               (or (play-terminal-step! p on?) (loop (+ i 1)))))))
(define (row-index rows id)
  (let loop ((l rows) (i 0)) (cond ((null? l) -1) ((eq? (car (car l)) id) i) (else (loop (cdr l) (+ i 1))))))
(define (select! p i) (let loop ((k 0)) (when (< k 12) (play-terminal-key! p 'up on?) (loop (+ k 1))))
                      (let loop ((k 0)) (when (< k i) (play-terminal-key! p 'down on?) (loop (+ k 1)))))

(test-group "the terminal"
  (test "F at the FM office's terminal opens it; its rows are every device but itself, then each lighting zone"
    (let* ((r (at-terminal on?)) (p (car r)) (t (play-terminal p on?)))
      (display (list 'use (cadr r) 'terminal t)) (newline)
      (assert-true (equal? (cadr r) '(terminal-open)))
      (assert-true (play-terminal-open? p))
      (assert-equal 8 (length (car t)))
      (assert-equal -1 (row-index (car t) 'fm-terminal))
      (assert-true (>= (row-index (car t) 'lights-c1) 0))
      (assert-equal 'in-use (devices-state (play-devices-state p) (device-index DATA 'fm-terminal)))))
  (test "a ring from the terminal takes 2.5 s, from the FM office, with no line to the phone"
    (let* ((p (car (at-terminal on?))) (rows (car (play-terminal p on?))))
      (select! p (row-index rows 'office-phone))
      (play-terminal-key! p 'run on?)
      (steps p 140 on?)
      (assert-equal 'idle (devices-state (play-devices-state p) PHONE))
      (assert-equal 'running (car (list-ref (play-terminal p on?) 2)))
      ;; checked the tick it runs: the unit's route passes the phone, and he answers it
      (let ((r (steps-until p 20 on?)))
        (assert-true (equal? r (list 'run PHONE 'ring)))
        (assert-equal 'ringing (devices-state (play-devices-state p) PHONE))
        (assert-true (equal? (list-ref (play-terminal p on?) 2) '(done office-phone ring))))))
  (test "the vent is FACILITIES: STAFF is denied at the terminal too, and a lighting zone"
    (let* ((p (car (at-terminal on?))) (rows (car (play-terminal p on?))))
      (assert-false (list-ref (list-ref rows (row-index rows 'corridor-vent)) 3))
      (select! p (row-index rows 'corridor-vent))
      (play-terminal-key! p 'run on?)
      (assert-true (equal? (list-ref (play-terminal p on?) 2) '(denied corridor-vent)))
      (assert-false (steps p 200 on?))
      (assert-equal 'off (devices-state (play-devices-state p) (device-index DATA 'corridor-vent)))
      (assert-false (list-ref (list-ref rows (row-index rows 'lights-c2)) 3))))
  (test "the camera is SECURITY's: its row has no command"
    (let* ((p (car (at-terminal on?))) (rows (car (play-terminal p on?))))
      (assert-true (equal? (list-ref rows (row-index rows 'lift-camera)) '(lift-camera camera #f #f security)))))
  (test "its screen lights you: in a dark room, lit while it is open"
    (let* ((r (at-terminal DARK)) (p (car r)))
      (play-tick! p AT-DESK DARK 1.0 2.0)
      (display (list 'lit-at-terminal (play-light-01 p))) (newline)
      (assert-true (>= (play-light-01 p) 0.6))
      (play-terminal-key! p 'close DARK)
      (play-tick! p AT-DESK DARK 1.0 2.0)
      (display (list 'closed (play-light-01 p))) (newline)
      (assert-true (< (play-light-01 p) 0.6))
      (assert-false (play-terminal-open? p))
      (assert-equal 'idle (devices-state (play-devices-state p) (device-index DATA 'fm-terminal)))))
  (test "away from it, F does not open it"
    (let* ((p (fresh)) (w (make-walker 20.0 16.0 0.0 0.0)))
      (play-tick! p w on? 1.0 2.0)
      (play-use! p w on?)
      (assert-false (play-terminal-open? p)))))
