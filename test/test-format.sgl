;;; The real floor-14 slice and its props, legend and textures read with no
;;; problems, and the records hold what the files say.
(import (sigil test)
        (sigil fs)
        (sigil list)
        (phantom floor problem)
        (phantom floor format)
        (phantom floor sources))

(define (reader path) (and (file-exists? path) (read-file-string path)))
(define src (load-sources "floors/14-slice.floor" reader))

(test-group "the slice reads cleanly"
  (test "no problems"
    (for-each (lambda (p) (display (problem->string p)) (newline)) (sources-problems src))
    (assert-equal 0 (length (sources-problems src))))
  (test "six rooms, eight openings, one stair"
    (let ((fl (sources-floor src)))
      (assert-equal 6 (length (floor-rooms fl)))
      (assert-equal 8 (length (floor-openings fl)))
      (assert-equal 1 (length (floor-stairs fl)))))
  (test "the duct is over two rooms and crouch-only"
    (let ((duct (list-ref (floor-rooms (sources-floor src)) 5)))
      (assert-equal 'duct (room-name duct))
      (assert-equal '(corridor office) (room-over duct))
      (assert-true (room-crouch-only duct))
      (assert-equal (cons 22.8 13.8) (list-ref (room-corners duct) 1))))
  (test "room lines"
    (assert-equal '(11 13 15 17 19 21) (map room-line (floor-rooms (sources-floor src)))))
  (test "props and textures found"
    (assert-equal '(lift exit-door light-switch badge office-desk filing-cabinet) (map car (sources-props src)))
    (assert-equal 8 (length (sources-textures src)))))
