(import (sigil test)
        (phantom sound mix))

(define (pcm values)
  (let ((bytes (make-bytevector (* 4 (length values)) 0)))
    (let loop ((values values) (index 0))
      (unless (null? values)
        (bytevector-ieee-single-set! bytes (* 4 index) (car values) 'little)
        (loop (cdr values) (+ index 1))))
    bytes))

(test-group "Legacy sample playback contracts"
  (test "mono samples fill both channels and an ended voice leaves a zero tail"
    (let ((mixer (make-mixer))
          (out (make-bytevector 32 17)))
      (mixer-play! mixer (pcm '(0.5 -0.25)) 1.0 0.0)
      (mixer-render! mixer out 4)
      (assert-equal (pcm '(0.5 0.5 -0.25 -0.25 0.0 0.0 0.0 0.0)) out)
      (assert-equal 0 (mixer-voices mixer))
      (assert-true (mixer-silent? mixer))))
  (test "stereo loops preserve channels and wrap beyond the 4096-frame zero block"
    (let ((mixer (make-mixer))
          (out (make-bytevector (* 8 4097) 17)))
      (mixer-loop! mixer (pcm '(0.25 -0.5 0.75 0.125)) 1.0 2)
      (mixer-render! mixer out 4097)
      (let loop ((frame 0))
        (when (< frame 4097)
          (assert-equal
            (if (even? frame) (pcm '(0.25 -0.5)) (pcm '(0.75 0.125)))
            (bytevector-copy out (* 8 frame) (* 8 (+ frame 1))))
          (loop (+ frame 1))))
      (assert-equal 0 (mixer-voices mixer))
      (assert-false (mixer-silent? mixer))))
  (test "the seventeenth one-shot evicts the oldest rather than a loop"
    (let ((mixer (make-mixer))
          (out (make-bytevector 8 17)))
      (mixer-loop! mixer (pcm '(0.25)) 1.0)
      (let loop ((index 1))
        (when (<= index 17)
          (mixer-play! mixer (pcm (list (/ index 32.0))) 0.5 0.0)
          (loop (+ index 1))))
      (assert-equal 16 MAX-VOICES)
      (assert-equal 16 (mixer-voices mixer))
      (mixer-render! mixer out 1)
      (assert-equal (pcm '(2.625 2.625)) out)
      (assert-equal 0 (mixer-voices mixer))
      (assert-false (mixer-silent? mixer))))
  (test "missing samples stay silent and zero-frame rendering keeps live voices"
    (let ((mixer (make-mixer))
          (out (make-bytevector 8 17)))
      (mixer-play! mixer #f 1.0 0.0)
      (mixer-loop! mixer #f 1.0)
      (assert-true (mixer-silent? mixer))
      (mixer-play! mixer (pcm '(0.5)) 1.0 0.0)
      (mixer-render! mixer out 0)
      (assert-equal (make-bytevector 8 17) out)
      (assert-equal 1 (mixer-voices mixer))
      (mixer-render! mixer out 1)
      (assert-equal (pcm '(0.5 0.5)) out)
      (assert-true (mixer-silent? mixer)))))

(run-tests)
