;;; The walker on the compiled floor 14 (the floor compiler's output,
;;; assets/floors/14-slice/collide, brought in by scripts/floor-import):
;;; the ghost way's climb (office floor, onto the filing cabinet, up
;;; through the hatch into the duct), and the compiler's reach-probe case (a
;;; standing body placed in the 1 m duct crouches where it is). Run from the
;;; repo root.

(import (sigil test)
        (sigil math)
        (sigil fs)
        (phantom detmath)
        (phantom soup)
        (phantom walker))

(define C (pbc1->collision (read-file-bytes "assets/floors/14-slice/collide")))

(define (run w n input)
  (if (= n 0) w (run (walker-step w input TICK C) (- n 1) input)))

(define (run-until w input done? n)
  (cond ((done? w) w)
        ((= n 0) #f)
        (else (run-until (walker-step w input TICK C) input done? (- n 1)))))

(define FORWARD (make-input 0.0 1.0 0.0 0.0 #f #f #f 0))
(define (near? a b eps) (< (abs (- a b)) eps))
;; yaw that faces south-west, down the duct toward the grate (direction -1, -1)
(define DOWN-DUCT (* 0.75 PI))

(test-group "the compiled floor 14"
  (test "walking south in the office climbs the filing cabinet under the hatch"
    (let* ((m (run-until (make-walker 22.2 15.6 0.0 PI) FORWARD walker-mantling? 400))
           (w (and m (run m 90 NO-INPUT))))
      (assert-true (and w (near? (walker-z w) 1.3 0.05)))
      (assert-true (and w (< (abs (- (walker-x w) 22.2)) 0.35)))))
  (test "from the cabinet top, pushing down the duct climbs up through the hatch into it"
    (let* ((m (run-until (make-walker 22.2 15.6 0.0 PI) FORWARD walker-mantling? 400))
           (on (and m (run m 90 NO-INPUT)))
           (turned (and on (run (walker-step on (make-input 0.0 0.0 (- DOWN-DUCT PI) 0.0 #f #f #f 0) TICK C) 30 NO-INPUT)))
           (up (and turned (run-until turned FORWARD (lambda (w) (> (walker-z w) 2.9)) 600)))
           (w (and up (run up 90 NO-INPUT))))
      (assert-true (and on (near? (walker-z on) 1.3 0.05)))
      (assert-true (and w (near? (walker-z w) 3.0 0.05)))
      (assert-true (and w (walker-crouching? w)))))
  (test "a standing body placed in the duct crouches where it stands"
    (let ((w (walker-step (make-walker 18.0 9.5 3.0 DOWN-DUCT) NO-INPUT TICK C)))
      (assert-true (< (abs (- (walker-x w) 18.0)) 0.01))
      (assert-true (< (abs (- (walker-y w) 9.5)) 0.01))
      (assert-true (walker-crouching? w))
      (assert-true (near? (walker-z w) 3.0 0.01)))))

;;; The whole floor 14 (floors/14.floor, Phantom 0.1): assets/floors/14, the
;;; floor INFILTRATE plays. Both ends of the rerouted duct climb (the print
;;; room's filing cabinet under its hatch, the FM office's under its), and
;;; the patrol walks its loop through the new rooms (the lift lobby, the
;;; corridor, the open plan, the kitchen) as the game runs it.

(import (phantom play data)
        (phantom play core)
        (phantom guard guard)
        (phantom play devices))

(define DIR14 "assets/floors/14/")
(define C14 (pbc1->collision (read-file-bytes (string-append DIR14 "collide"))))
(define INFO14 (floor-info-from-string (read-file-string (string-append DIR14 "floor.sexp"))))
(define DATA14 (play-data-from-string (read-file-string (string-append DIR14 "play.sexp"))))

(define (run14 w n input)
  (if (= n 0) w (run14 (walker-step w input TICK C14) (- n 1) input)))
(define (run14-until w input done? n)
  (cond ((done? w) w)
        ((= n 0) #f)
        (else (run14-until (walker-step w input TICK C14) input done? (- n 1)))))

;; Walk forward from (x y) facing yaw onto the cabinet, settle, keep pushing
;; the same way up through the hatch, settle: (on-cabinet in-duct).
(define (climb14 x y yaw)
  (let* ((m (run14-until (make-walker x y 0.0 yaw) FORWARD walker-mantling? 600))
         (on (and m (run14 m 90 NO-INPUT)))
         (up (and on (run14-until on FORWARD (lambda (w) (> (walker-z w) 2.9)) 600)))
         (in (and up (run14 up 90 NO-INPUT))))
    (list on in)))

(define PATROL14 '((2 2) (12.5 1.5) (21 6.5) (34 10) (36 2.5)))

(test-group "the whole floor 14"
  (test "the print room: onto the filing cabinet from the north, up through the hatch into the duct"
    (let* ((r (climb14 15.5 10.8 PI)) (on (car r)) (in (cadr r)))
      (assert-true (and on (near? (walker-z on) 1.3 0.05)))
      (assert-true (and in (near? (walker-z in) 3.0 0.05)))
      (assert-true (and in (walker-crouching? in)))))
  (test "the FM office: onto the filing cabinet from the south, up through the hatch into the duct"
    (let* ((r (climb14 24.0 1.6 0.0)) (on (car r)) (in (cadr r)))
      (assert-true (and on (near? (walker-z on) 1.3 0.05)))
      (assert-true (and in (near? (walker-z in) 3.0 0.05)))
      (assert-true (and in (walker-crouching? in)))))
  (test "the patrol walks its loop: every waypoint within 0.5 m, twice, and never alarmed by a runner out of its way"
    ;; the runner still in meeting A's dark far corner
    (let* ((p (play-reset! (make-play C14 DATA14 (cdr (assq 'circuits INFO14)))))
           (w (walker-step (make-walker 19.6 11.5 0.0 0.0) NO-INPUT TICK C14))
           (g (play-guard p))
           (best (make-vector (length PATROL14) 99.0))
           (visits (make-vector (length PATROL14) 0))
           (near (make-vector (length PATROL14) #f))
           (worst 0))
      (let loop ((i 0))
        (when (< i (* 60 240))
          (play-tick! p w (lambda (c) #t) 1.0 2.0)
          (set! worst (max worst (guard-state g)))
          (let each ((k 0) (ps PATROL14))
            (unless (null? ps)
              (let* ((dx (- (guard-x g) (car (car ps)))) (dy (- (guard-y g) (cadr (car ps))))
                     (d (sqrt (+ (* dx dx) (* dy dy)))))
                (vector-set! best k (min (vector-ref best k) d))
                (cond ((and (< d 0.5) (not (vector-ref near k)))
                       (vector-set! near k #t)
                       (vector-set! visits k (+ 1 (vector-ref visits k))))
                      ((> d 2.0) (vector-set! near k #f))))
              (each (+ k 1) (cdr ps))))
          (loop (+ i 1))))
      (display (list 'patrol14 'best (vector->list best) 'visits (vector->list visits) 'worst worst)) (newline)
      (assert-true (= worst 0))
      (let each ((k 0))
        (when (< k (length PATROL14))
          (assert-true (>= (vector-ref visits k) 2))
          (each (+ k 1)))))))

;;; Three ways to FACILITIES (Phantom 0.1, item 2): the badge in the FM
;;; desk's drawer (F to take it), the sticky note's password at the FM
;;; terminal (a timed LOG IN), and the session left logged in on the server
;;; closet's terminal. The last two teach the deck FACILITIES with no badge
;;; to burn; only the badge opens readers.

(define ALL-ON (lambda (c) #t))
(define (fresh14) (play-reset! (make-play C14 DATA14 (cdr (assq 'circuits INFO14)))))
(define (stand x y) (walker-step (make-walker x y 0.0 0.0) NO-INPUT TICK C14))
(define (row-ids p) (map car (car (play-terminal p ALL-ON))))
;; run the selected row and step until it finishes: what the step returned
(define (run-row! p)
  (play-terminal-key! p 'run ALL-ON)
  (let loop ((i 0))
    (if (> i (+ 30 (inexact->exact (round (/ TERMINAL-TIME TICK))))) #f
        (or (play-terminal-step! p ALL-ON) (loop (+ i 1))))))

(test-group "three ways to FACILITIES"
  (test "the badge is in the FM desk's drawer: walking up to it takes nothing, F at the desk takes it"
    (let ((p (fresh14)) (w (stand 24.9 1.95)))
      (let loop ((i 0)) (when (< i 60) (play-tick! p w ALL-ON 1.0 2.0) (loop (+ i 1))))
      (assert-false (play-badge? p))
      (assert-true (eq? (play-tier p) 'staff))
      (assert-true (equal? (play-use! p w ALL-ON) '(badge)))
      (assert-true (play-badge? p))
      (assert-true (eq? (play-tier p) 'facilities))))
  (test "the FM terminal offers LOG IN; the password teaches the deck FACILITIES, and the readers still want the badge"
    (let ((p (fresh14)) (w (stand 25.9 2.0)))
      (play-tick! p w ALL-ON 1.0 2.0)
      (assert-true (equal? (play-use! p w ALL-ON) '(terminal-open)))
      (assert-true (eq? (car (row-ids p)) 'sticky-note))
      (assert-true (equal? (car (car (play-terminal p ALL-ON))) '(sticky-note login log-in #t staff)))
      (assert-true (eq? (play-tier p) 'staff))
      (assert-true (equal? (run-row! p) '(tier facilities)))
      (assert-true (eq? (play-tier p) 'facilities))
      (assert-true (eq? (play-learned-tier p) 'facilities))
      (assert-false (play-badge? p))
      (assert-false (memq 'sticky-note (row-ids p)))
      ;; a FACILITIES row is allowed now: the corridor's vent
      (assert-true (let ((r (assq 'corridor-vent (car (play-terminal p ALL-ON))))) (and r (list-ref r 3))))
      (play-terminal-key! p 'close ALL-ON)
      ;; the stairwell reader and the lobby's light panel want the badge
      (let ((at-exit (stand 3.0 9.2)))
        (play-tick! p at-exit ALL-ON 1.0 2.0)
        (assert-true (equal? (play-use! p at-exit ALL-ON) '(reader-deny))))
      (let ((at-panel (stand 20.0 5.9)))
        (play-tick! p at-panel ALL-ON 1.0 2.0)
        (assert-true (equal? (play-use! p at-panel ALL-ON) '(panel-deny c2))))
      (assert-true (eq? (play-outcome p) 'playing))))
  (test "the server closet's terminal: a session left logged in teaches the deck FACILITIES at once"
    (let ((p (fresh14)) (w (stand 16.1 3.4)))
      (play-tick! p w ALL-ON 1.0 2.0)
      (assert-true (equal? (play-use! p w ALL-ON) '(terminal-open session facilities)))
      (assert-true (eq? (play-tier p) 'facilities))
      (assert-false (play-badge? p))
      (assert-false (memq 'sticky-note (row-ids p)))))
  (test "with FACILITIES learned, the FM terminal has no LOG IN row; a restart forgets the tier"
    (let ((p (fresh14)))
      (let ((w (stand 16.1 3.4))) (play-tick! p w ALL-ON 1.0 2.0) (play-use! p w ALL-ON) (play-terminal-key! p 'close ALL-ON))
      (assert-true (eq? (play-learned-tier p) 'facilities))
      (let ((w (stand 25.9 2.0)))
        (play-tick! p w ALL-ON 1.0 2.0)
        (play-use! p w ALL-ON)
        (assert-false (memq 'sticky-note (row-ids p))))
      (play-reset! p)
      (assert-true (eq? (play-tier p) 'staff))
      (assert-false (play-learned-tier p)))))

;;; How the floor ends (Phantom 0.1, item 3): two ways out. The stairwell
;;; door takes the badge at its reader; the service lift behind the kitchen
;;; takes a call from the deck with FACILITIES from any source (the badge,
;;; the sticky note's password, the server closet's session). And the best
;;; kept of a floor: the least time and the fewest incidents, each on its own.

(define LIFT-SPOT (list (vector-ref (play-lift DATA14) 0) (vector-ref (play-lift DATA14) 1)))

(test-group "how the floor ends"
  (test "the service lift is the kitchen's, called with FACILITIES"
    (assert-true (eq? (vector-ref (play-lift DATA14) 2) 'facilities))
    (assert-true (< 38.5 (car LIFT-SPOT) 40.0))
    (assert-true (< 1.0 (cadr LIFT-SPOT) 3.5)))
  (test "without FACILITIES the service lift doesn't come"
    (let ((p (fresh14)) (w (stand (car LIFT-SPOT) (cadr LIFT-SPOT))))
      (play-tick! p w ALL-ON 1.0 2.0)
      (assert-true (play-near-lift? p))
      (assert-true (equal? (play-use! p w ALL-ON) '(lift-deny facilities)))
      (assert-true (eq? (play-outcome p) 'playing))
      (assert-false (play-way-out p))))
  (test "with the server closet's session, no badge, the deck calls the service lift: out by the lift"
    (let ((p (fresh14)))
      (let ((w (stand 16.1 3.4))) (play-tick! p w ALL-ON 1.0 2.0) (play-use! p w ALL-ON) (play-terminal-key! p 'close ALL-ON))
      (assert-false (play-badge? p))
      (let ((w (stand (car LIFT-SPOT) (cadr LIFT-SPOT))))
        (play-tick! p w ALL-ON 1.0 2.0)
        (assert-true (equal? (play-use! p w ALL-ON) '(lift-ok)))
        (assert-true (eq? (play-outcome p) 'won))
        (assert-true (eq? (play-way-out p) 'lift)))))
  (test "with the badge, the stairwell reader: out by the stairwell"
    (let ((p (fresh14)))
      (let ((w (stand 24.9 1.95))) (play-tick! p w ALL-ON 1.0 2.0) (play-use! p w ALL-ON))
      (let ((w (stand 3.0 9.2)))
        (play-tick! p w ALL-ON 1.0 2.0)
        (assert-true (equal? (play-use! p w ALL-ON) '(reader-ok)))
        (assert-true (eq? (play-way-out p) 'stairwell)))))
  (test "the best kept: the least time and the fewest incidents, each on its own"
    (assert-true (equal? (play-best-after #f 200 3) '(200 . 3)))
    (assert-true (equal? (play-best-after '(150 . 5) 200 3) '(150 . 3)))
    (assert-true (equal? (play-best-after '(150 . 0) 120 2) '(120 . 0)))))

;;; The patrol's flashlight (Phantom 0.1, item 4; design section 4: "It
;;; carries a flashlight into dark zones"). Its lamp is on where the light at
;;; its feet is dark and while it searches; in its cone, in range and in
;;; sight, it lights you; it never lights you through a wall; searching, it sweeps.

(define DARK-ON (lambda (c) (memq c '(emergency screens city))))   ; every switchable light off
;; a play whose unit stands at (gx gy) facing (fx fy), you at (x y): your light-01 after one tick
(define (lit-by-torch on? gx gy fx fy x y)
  (let ((p (fresh14)) (w (stand x y)))
    (guard-place! (play-guard p) gx gy fx fy)
    (play-tick! p w on? 1.0 2.0)
    (list (play-light-01 p) (vector-ref (play-torch p) 0))))

(test-group "the patrol's flashlight"
  (test "in the lit lobby, calm, its lamp is off"
    (let ((r (lit-by-torch ALL-ON 4.0 5.0 1.0 0.0 9.0 5.0)))
      (assert-false (cadr r))))
  (test "with the lobby dark its lamp is on, and it lights you in its beam; out of the beam you stay dark"
    (let ((in (lit-by-torch DARK-ON 4.0 5.0 1.0 0.0 9.0 5.0))
          (behind (lit-by-torch DARK-ON 4.0 5.0 -1.0 0.0 9.0 5.0)))
      (display (list 'torch-in in 'torch-behind behind)) (newline)
      (assert-true (cadr in))
      (assert-true (> (car in) 0.4))
      (assert-true (< (car behind) 0.2))))
  (test "it never lights you through a wall: the corridor's lamp, you behind the print room's wall"
    (let ((through (lit-by-torch DARK-ON 16.5 6.2 0.0 1.0 16.5 9.5)))
      (display (list 'torch-through-wall through)) (newline)
      (assert-true (cadr through))
      (assert-true (< (car through) 0.2))))
  (test "searching, its beam sweeps from side to side"
    (let* ((p (fresh14)) (w (stand 1.0 8.0)) (g (play-guard p)))
      (guard-place! g 6.0 5.0 1.0 0.0)
      (guard-notice! g 0.65 9.0 5.0 0.0)
      (let loop ((i 0) (lo 1.0) (hi -1.0))
        (if (< i 240)
            (begin (play-tick! p w ALL-ON 1.0 2.0)
                   (let* ((t (play-torch p)) (a (atan (vector-ref t 5) (vector-ref t 4)))
                          (rel (- a (atan (guard-fy g) (guard-fx g))))
                          (rel (cond ((> rel PI) (- rel TAU)) ((< rel (- PI)) (+ rel TAU)) (else rel))))
                     (if (and (vector-ref t 0) (= (guard-state g) SEARCHING))
                         (loop (+ i 1) (min lo rel) (max hi rel))
                         (loop (+ i 1) lo hi))))
            (begin (display (list 'sweep lo hi)) (newline)
                   (assert-true (< lo -0.3))
                   (assert-true (> hi 0.3))))))))

;;; The second camera (Phantom 0.1, item 5; design section 4: "another
;;; watches the stairwell door"): at the reader in the lit lobby it alarms
;;; in about 2.4 s; with the lobby dark (only the exit sign's glow there) it
;;; is half as quick, and 3 s at the reader is not an alarm.

(define (stair-camera-after on? x y secs)
  (let* ((p (fresh14)) (w (stand x y)) (i (device-index DATA14 'stair-camera)))
    (play-units-off! p #t)      ; the patrol out of it: the camera alone
    (let loop ((k 0) (hi 0.0) (alarmed #f))
      (if (>= k (* 60 secs))
          (list hi alarmed)
          (begin (play-tick! p w on? 1.0 2.0)
                 (loop (+ k 1) (max hi (play-camera-awareness p i))
                       (or alarmed (eq? (devices-state (play-devices-state p) i) 'alarmed))))))))

(test-group "the stairwell camera"
  (test "at the stairwell reader in the lit lobby, the camera alarms within 3 s"
    (let ((r (stair-camera-after ALL-ON 3.0 9.2 3)))
      (display (list 'stair-camera-lit-3s r)) (newline)
      (assert-true (cadr r))))
  (test "with the lobby dark, 3 s at the reader is not an alarm"
    (let ((r (stair-camera-after DARK-ON 3.0 9.2 3)))
      (display (list 'stair-camera-dark-3s r)) (newline)
      (assert-true (< (car r) 0.8))
      (assert-false (cadr r))))
  (test "by the lifts, out of its view, it sees nothing"
    (let ((r (stair-camera-after ALL-ON 2.0 2.0 3)))
      (assert-true (< (car r) 0.05)))))

;;; STAFF commands work once (Phantom 0.1, item 7; design section 5: "a
;;; distraction (a printer, a phone): guards ignore that kind of device").
;;; The meeting room's phone rings and the patrol goes to it; once it has
;;; stopped ringing the patrol ignores phones for the rest of the attempt,
;;; and the patch note says PATROLS IGNORE PHONES. A printer still works.

(test-group "STAFF works once"
  (test "the phone pulls the patrol once; rung again it is ignored; a printer still pulls it"
    (let* ((p (fresh14)) (w (stand 19.6 11.5)) (g (play-guard p)) (dv (play-devices-state p))
           (phone (device-index DATA14 'meeting-phone)) (printer (device-index DATA14 'print-printer))
           (tick (lambda () (play-tick! p w ALL-ON 1.0 2.0))))
      (devices-run! dv phone 'ring)
      ;; the first ring: noticed; answered or rung out; then the kind is patched
      (let loop ((k 0) (hi 0))
        (if (and (< k (* 60 120))
                 (not (and (memq 'phone (play-ignored-kinds p)) (= (guard-state g) CALM))))
            (begin (tick) (loop (+ k 1) (max hi (guard-state g))))
            (begin (display (list 'first-ring 'hi hi 'secs (/ k 60.0) 'ignored (play-ignored-kinds p))) (newline)
                   (assert-true (>= hi SEARCHING))
                   (assert-true (equal? (play-ignored-kinds p) '(phone))))))
      ;; the second ring: ignored
      (devices-run! dv phone 'ring)
      (let loop ((k 0) (hi 0))
        (if (< k (* 60 12))
            (begin (tick) (loop (+ k 1) (max hi (guard-state g))))
            (begin (display (list 'second-ring 'hi hi)) (newline)
                   (assert-equal CALM hi))))
      (assert-true (equal? (car (car (play-patches p))) "PATROLS IGNORE PHONES"))
      ;; a printer, near the unit, still pulls it
      (guard-place! g 17.0 6.5 0.0 1.0)
      (devices-run! dv printer 'print)
      (let loop ((k 0) (hi 0))
        (if (< k (* 60 6))
            (begin (tick) (loop (+ k 1) (max hi (guard-state g))))
            (begin (display (list 'printer 'hi hi)) (newline)
                   (assert-true (>= hi SEARCHING))))))))

;;; The night cleaner (Phantom 0.1, item 6; design section 4: "The night
;;; cleaner vacuums the open plan (a walking noise mask). If the cleaner sees
;;; you, they report you, but they won't chase.")

(define CLEANER-ROUTE '((29.2 7.0) (39.4 7.0) (39.4 12.8) (29.2 12.8)))
;; the distance from (x y) to the cleaner's route (its four sides)
(define (off-route x y)
  (let loop ((ps CLEANER-ROUTE) (best 99.0))
    (if (null? ps) best
        (let* ((a (car ps)) (b (if (null? (cdr ps)) (car CLEANER-ROUTE) (cadr ps)))
               (ax (car a)) (ay (cadr a)) (bx (car b)) (by (cadr b))
               (dx (- bx ax)) (dy (- by ay)) (l2 (+ (* dx dx) (* dy dy)))
               (t (max 0.0 (min 1.0 (/ (+ (* (- x ax) dx) (* (- y ay) dy)) l2))))
               (qx (+ ax (* t dx))) (qy (+ ay (* t dy))))
          (loop (cdr ps) (min best (sqrt (+ (* (- x qx) (- x qx)) (* (- y qy) (- y qy))))))))))

(test-group "the night cleaner"
  (test "it vacuums its loop round the desk pods, every corner, and stays on its route"
    ;; you in meeting room A's dark far corner, out of everyone's way
    (let* ((p (fresh14)) (w (stand 19.6 11.5)) (c (vector-ref (play-cleaners-state p) 0))
           (visits (make-vector 4 0)) (near (make-vector 4 #f)))
      (let loop ((k 0) (worst 0.0))
        (if (< k (* 60 110))
            (begin
              (play-tick! p w ALL-ON 1.0 2.0)
              (let each ((i 0) (ps CLEANER-ROUTE))
                (unless (null? ps)
                  (let ((d (sqrt (+ (expt (- (vector-ref c 0) (car (car ps))) 2) (expt (- (vector-ref c 1) (cadr (car ps))) 2)))))
                    (cond ((and (< d 0.2) (not (vector-ref near i))) (vector-set! near i #t) (vector-set! visits i (+ 1 (vector-ref visits i))))
                          ((> d 1.0) (vector-set! near i #f))))
                  (each (+ i 1) (cdr ps))))
              (loop (+ k 1) (max worst (off-route (vector-ref c 0) (vector-ref c 1)))))
            (begin (display (list 'cleaner-visits (vector->list visits) 'off-route worst)) (newline)
                   (assert-true (< worst 0.01))
                   (let each ((i 0)) (when (< i 4) (assert-true (>= (vector-ref visits i) 2)) (each (+ i 1)))))))))
  (test "it sees you standing lit in its way and reports you: an incident, and the patrol comes; it keeps its route"
    (let* ((p (fresh14)) (g (play-guard p)) (c (vector-ref (play-cleaners-state p) 0))
           ;; ahead of it on its first side (it starts at (29.2 7) heading east)
           (w (stand 33.5 6.2)))
      (let loop ((k 0) (reported #f) (hi 0) (worst 0.0))
        (if (< k (* 60 12))
            (begin
              (play-tick! p w ALL-ON 1.0 2.0)
              (loop (+ k 1) (or reported (and (assoc 'cleaner-saw (play-incidents p)) #t)) (max hi (guard-state g))
                    (max worst (off-route (vector-ref c 0) (vector-ref c 1)))))
            (begin (display (list 'cleaner-report reported 'patrol-hi hi 'off-route worst)) (newline)
                   (assert-true reported)
                   (assert-true (>= hi SEARCHING))
                   (assert-true (< worst 0.01)))))))
  (test "its vacuum masks: beside the patrol it raises the patrol's hearing threshold, far away barely"
    (let* ((p (fresh14)) (g (play-guard p)) (w (stand 1.0 8.0)))
      (play-units-off! p #t)                       ; the patrol held where it's put
      (guard-place! g 29.2 8.5 0.0 1.0)            ; beside the cleaner's start
      (play-tick! p w ALL-ON 1.0 2.0)
      (let ((near (play-mask p)))
        (guard-place! g 2.0 2.0 0.0 1.0)           ; the far end of the lobby
        (play-tick! p w ALL-ON 1.0 2.0)
        (display (list 'vacuum-mask 'near near 'far (play-mask p))) (newline)
        ;; heard faintly across the floor, strongly beside it
        (assert-true (> near 0.5))
        (assert-true (< (play-mask p) (* 0.25 near)))))))
