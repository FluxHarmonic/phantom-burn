;;; P1's guard on the compiled floor 14 (assets/floors/14-slice: collide,
;;; floor.sexp, play.sexp), through the real walker and the real guard, as
;;; the game runs them ((phantom play core)). Run from the repo root.
;;;
;;; The gate (design §8, P1): a scripted walk across the lit lobby is
;;; detected, and the same walk with the lights off is not.

(import (sigil test)
        (sigil math)
        (sigil time)
        (sigil gc)
        (sigil fs)
        (phantom detmath)
        (phantom soup)
        (phantom collide)
        (phantom walker)
        (phantom play data)
        (phantom play core)
        (phantom guard nav)
        (phantom guard sense)
        (phantom guard guard))

(define DIR "assets/floors/14-slice/")
(define C (pbc1->collision (read-file-bytes (string-append DIR "collide"))))
(define INFO (floor-info-from-string (read-file-string (string-append DIR "floor.sexp"))))
(define DATA (play-data-from-string (read-file-string (string-append DIR "play.sexp"))))
(define CIRCUITS (cdr (assq 'circuits INFO)))

(define (on-set names) (lambda (c) (and (memq c names) #t)))
(define ALL-ON (on-set '(c1 c2 c3 emergency screens city)))
(define DARK (on-set '(emergency screens city)))

(define (near? a b eps) (< (abs (- a b)) eps))

;; --- the light, measured -----------------------------------------------------

(define (light-table)
  (let ((ls (make-light-state)))
    (for-each
     (lambda (spot)
       (let ((x (cadr spot)) (y (caddr spot)) (z (cadddr spot)))
         (light-levels! ls CIRCUITS ALL-ON 1.0 2.0)
         (let ((on (light-at ls DATA x y z)))
           (light-levels! ls CIRCUITS DARK 1.0 2.0)
           (let ((off (light-at ls DATA x y z)))
             (display (list 'light (car spot) 'on on (light-01 on) 'off off (light-01 off)))
             (newline)))))
     '((lobby-mid 7.0 5.0 0.0) (lobby-window 6.0 0.6 0.0) (under-mezz 3.0 9.0 0.0)
       (mezzanine 6.0 8.5 3.0) (corridor 17.0 9.5 0.0) (office 19.0 16.0 0.0)
       (fm-office 24.0 18.0 0.0) (duct 18.5 9.8 3.0) (exit 3.0 9.6 0.0)
       (win-8-1.6 8.0 1.6 0.0) (win-8-2.4 8.0 2.4 0.0)
       (ex-3-8.5 3.0 8.5 0.0) (ex-3-7.5 3.0 7.5 0.0) (ex-3-6.5 3.0 6.5 0.0) (ex-4.5-8.5 4.5 8.5 0.0)
       (ex-6-9 6.0 9.0 0.0) (ex-6-8 6.0 8.0 0.0) (under-stair-11-4.5 11.0 4.5 0.0)))))

(light-table)

;; --- running an attempt -------------------------------------------------------

;; These are P1's sight, nav and capture tests: hearing (P2,
;; test/test-hearing.sgl) is off, so each measures sight alone.
(define (fresh-play) (play-set-hearing! (play-reset! (make-play C DATA CIRCUITS)) #f))

;; Step the walker with input-of (tick -> input) and the play, n ticks;
;; returns (walker . outcomes seen).
(define (run p w on? n input-of)
  (let loop ((i 0) (w w) (seen '()))
    (if (>= i n)
        (cons w (reverse seen))
        (let* ((w (walker-step w (input-of i) TICK C))
               (o (play-tick! p w on? 1.0 2.0)))
          (loop (+ i 1) w (if (and (not (eq? o 'playing)) (not (memq o seen))) (cons o seen) seen))))))

(define (max-awareness p w on? n input-of)
  (let loop ((i 0) (w w) (best 0.0) (state 0))
    (if (>= i n)
        (list best state)
        (let* ((w (walker-step w (input-of i) TICK C)))
          (play-tick! p w on? 1.0 2.0)
          (let ((g (play-guard p)))
            (loop (+ i 1) w (max best (guard-awareness g)) (max state (guard-state g))))))))

;; As max-awareness, with the guard held at (gx, gy) facing (fx, fy) every
;; tick (it still perceives and thinks; it does not walk or turn away).
(define (held-awareness p w on? n gx gy fx fy)
  (let ((g (play-guard p)) (gw (play-guard-world p)))
    (let loop ((i 0) (best 0.0) (state 0))
      (if (>= i n)
          (list best state)
          (begin
            (guard-place! g gx gy fx fy)
            (play-tick! p w on? 1.0 2.0)
            (loop (+ i 1) (max best (guard-awareness g)) (max state (guard-state g))))))))

(define FORWARD (make-input 0.0 1.0 0.0 0.0 #f #f #f 0))
(define EAST (- (/ PI 2.0)))
(define WEST (/ PI 2.0))

(test-group "the nav"
  (test "most of the ground floor is walkable, and every route point is reachable from the others"
    (let* ((p (fresh-play))
           (nav (guard-world-nav (play-guard-world p))))
      (display (list 'nav 'walkable (nav-walkable-count nav) 'of (* (nav-w nav) (nav-h nav)))) (newline)
      (assert-true (> (nav-walkable-count nav) 2500))
      (let* ((route (play-route DATA)) (f (make-field nav)))
        (nav-field! nav f (vector-ref route 0) (vector-ref route 1) #f #f)
        (let loop ((i 1) (ok #t))
          (if (>= i (quotient (vector-length route) 2))
              (assert-true ok)
              (loop (+ i 1)
                    (and ok (let ((s (nav-steer! nav f (vector-ref route (* 2 i)) (vector-ref route (+ 1 (* 2 i))))))
                              (display (list 'route-point i 'steps-to-point-0 s)) (newline)
                              (and s (> s 0))))))))))
  (test "the nav refuses the walls: the lobby's east wall between the arch and the corner"
    (let ((nav (guard-world-nav (play-guard-world (fresh-play)))))
      (assert-false (nav-walkable? nav 14.0 3.5))
      (assert-true (nav-walkable? nav 14.0 6.5)))))

(test-group "the patrol"
  (test "with nobody about, the guard walks its whole route in about a minute and stays calm"
    (let* ((p (fresh-play))
           (g (play-guard p))
           ;; the runner off the floor, far away (falling: no light, out of range)
           (w (make-walker 60.0 60.0 0.0 0.0))
           (legs '()))
      (let loop ((i 0) (w w) (last-leg (guard-leg g)))
        (when (< i (* 60 75))
          (let ((w (walker-step w NO-INPUT TICK C)))
            (play-tick! p w ALL-ON 1.0 2.0)
            (unless (= (guard-leg g) last-leg)
              (set! legs (cons (list (guard-leg g) (exact (round (/ i 60)))
                                     (/ (round (* 10 (guard-x g))) 10.0) (/ (round (* 10 (guard-y g))) 10.0)) legs)))
            (loop (+ i 1) w (guard-leg g)))))
      (display (list 'patrol-legs (reverse legs))) (newline)
      (assert-true (= (guard-state g) CALM))
      ;; it came back round to the point it started from, and each leg
      ;; ended at its route point (not merely timed out there)
      (assert-true (>= (length legs) 4))
      (let ((route (play-route DATA)))
        (for-each (lambda (l)
                    (let* ((reached (modulo (- (car l) 1) 4))
                           (dx (- (caddr l) (vector-ref route (* 2 reached))))
                           (dy (- (cadddr l) (vector-ref route (+ 1 (* 2 reached))))))
                      (assert-true (< (sqrt (+ (* dx dx) (* dy dy))) 0.8))))
                  legs)))))

;; The gate walk: the runner steps out from under the mezzanine and walks
;; east along the lobby's middle while the guard, put at its first route
;; point (2 2), walks east toward its second. 4 seconds.
(define (gate-walk on?)
  (let* ((p (fresh-play))
         (g (play-guard p)))
    (guard-reset! g (play-guard-world p) 0)
    (max-awareness p (make-walker 4.0 6.0 0.0 EAST) on? (* 60 4) (lambda (i) FORWARD))))

(test-group "the P1 gate: light"
  (test "walking across the lit lobby in view of the guard is noticed (suspicious or worse)"
    (let ((r (gate-walk ALL-ON)))
      (display (list 'gate-lit 'max-awareness (car r) 'max-state (cadr r))) (newline)
      (assert-true (>= (car r) 0.3))))
  (test "the same walk with the lobby's lights off is not noticed at all"
    ;; exactly 0: with decay applied while seen, a small sighting rate would
    ;; hide under any threshold above 0
    (let ((r (gate-walk DARK)))
      (display (list 'gate-dark 'max-awareness (car r) 'max-state (cadr r))) (newline)
      (assert-true (= (car r) 0.0)))))

(test-group "the P1 gate: graded light"
  (test "in half light (the exit sign's spill, the switchable lights off) you are noticed, but much more slowly than when lit"
    ;; the guard under the mezzanine facing north, the runner 6 m ahead of
    ;; it by the stairwell door, still, for two seconds
    (let* ((still (lambda (on?)
                    (let* ((p (fresh-play)) (g (play-guard p))
                           (w (make-walker 3.0 8.5 0.0 PI)))
                      (guard-reset! g (play-guard-world p) 0)
                      (let ((r (held-awareness p w on? 120 3.0 2.5 0.0 1.0)))
                        (list (car r) (play-light-01 p))))))
           (lit (still ALL-ON))
           (dim (still DARK)))
      (display (list 'half-light 'lit lit 'dim dim)) (newline)
      ;; the spot is half lit (this pins the light mapping: a scaled or
      ;; shifted light-01 moves it out), fully lit with the lights on, and
      ;; the awareness it builds there is real but a fraction of the lit one
      (assert-true (> (cadr dim) 0.3))
      (assert-true (< (cadr dim) 0.45))
      (assert-true (= (cadr lit) 1.0))
      (assert-true (> (car dim) 0.03))
      (assert-true (< (car dim) (* 0.35 (car lit)))))))

;; A runner crouched under the open stair's treads, at (11, 4.5): the treads
;; are about 1.5 m up there, room for a crouched body and not for a guard.
(define (under-stair-walker)
  (let loop ((i 0) (w (walker-step (make-walker 11.0 4.5 0.0 WEST) (make-input 0.0 0.0 0.0 0.0 #f #f #t 0) TICK C)))
    (if (>= i 90) w (loop (+ i 1) (walker-step w NO-INPUT TICK C)))))

(test-group "the open stair"
  (test "the space under the treads is a crouch spot: a runner fits crouched, a guard cannot stand there"
    (let* ((w (under-stair-walker)) (p (fresh-play)) (nav (guard-world-nav (play-guard-world p))))
      (display (list 'under-stair 'at (walker-x w) (walker-y w) (walker-z w) 'crouched (walker-crouching? w))) (newline)
      (assert-true (walker-crouching? w))
      (assert-true (< (abs (- (walker-x w) 11.0)) 0.3))
      (assert-false (nav-walkable? nav 11.0 4.5))))
  (test "the stair is open at the side: a guard beside it in the lit lobby sees you under it (held facing it: suspicious), and a hunt there catches you"
    (let* ((w (under-stair-walker)) (p (fresh-play)) (g (play-guard p))
           (glass (play-glass DATA)))
      (display (list 'under-stair-sight 'chest (sight-clear? C glass 7.0 4.5 1.65 (walker-x w) (walker-y w) (+ (walker-z w) (* 0.55 (walker-height w))))
                     'head (sight-clear? C glass 7.0 4.5 1.65 (walker-x w) (walker-y w) (walker-eye-z w))
                     'height (walker-height w)))
      (newline)
      (guard-reset! g (play-guard-world p) 0)
      (let ((seen (held-awareness p w ALL-ON (* 60 4) 7.0 4.5 1.0 0.0)))
        (display (list 'under-stair-held seen)) (newline)
        (assert-true (>= (car seen) 0.3)))
      ;; the hunt: from 4 m away, to the nearest place a guard can stand
      ;; (1.1 m from you, beside the stair), and the reach with a clear line
      (let* ((p (fresh-play)) (g (play-guard p)))
        (guard-reset! g (play-guard-world p) 0)
        (guard-place! g 7.0 4.5 1.0 0.0)
        (guard-alarm! g (walker-x w) (walker-y w))
        (let ((r (run p w ALL-ON (* 60 10) (lambda (i) NO-INPUT))))
          (display (list 'under-stair-hunt (cdr r) 'ticks (play-ticks p) 'guard (guard-x g) (guard-y g))) (newline)
          (assert-true (memq 'caught (cdr r)))))))
  (test "in the dark, under the treads, a guard 4 m away does not see you"
    (let* ((w (under-stair-walker)) (p (fresh-play)) (g (play-guard p)))
      (guard-reset! g (play-guard-world p) 0)
      (let ((r (held-awareness p w DARK (* 60 3) 7.0 4.5 1.0 0.0)))
        (display (list 'under-stair-dark r)) (newline)
        (assert-true (= (car r) 0.0))))))

(test-group "capture"
  (test "a hunting guard 0.7 m away through a wall does not catch you"
    ;; the corridor side of the corridor/office wall at y 13 (the door is at
    ;; x 19.9 to 21.1), and the office side
    (let* ((p (fresh-play)) (g (play-guard p)) (w (make-walker 19.3 13.35 0.0 0.0)))
      (guard-reset! g (play-guard-world p) 0)
      (guard-place! g 19.3 12.65 0.0 1.0)
      (guard-alarm! g 19.3 13.35)
      (play-tick! p w ALL-ON 1.0 2.0)
      (assert-false (eq? (play-outcome p) 'caught))))
  (test "the positive control: the same reach with nothing between catches you"
    (let* ((p (fresh-play)) (g (play-guard p)) (w (make-walker 7.0 4.2 0.0 0.0)))
      (guard-reset! g (play-guard-world p) 0)
      (guard-place! g 7.0 3.1 0.0 1.0)
      (guard-alarm! g 7.0 4.2)
      (play-tick! p w ALL-ON 1.0 2.0)
      (assert-true (eq? (play-outcome p) 'caught)))))

(test-group "crouching and circuits"
  (test "in full view and light, still, a crouched runner is noticed at about half the rate of a standing one"
    ;; the guard at its first point facing east along the lobby's south
    ;; side; the runner 6 m ahead of it, still, for one second
    (let* ((still (lambda (crouch?)
                    (let* ((p (fresh-play)) (g (play-guard p))
                           (w (make-walker 8.0 2.2 0.0 WEST))
                           (w (if crouch? (walker-step w (make-input 0.0 0.0 0.0 0.0 #f #f #t 0) TICK C) w))
                           (w (let loop ((i 0) (w w)) (if (>= i 60) w (loop (+ i 1) (walker-step w NO-INPUT TICK C))))))
                      (guard-reset! g (play-guard-world p) 0)
                      (list (car (max-awareness p w ALL-ON 60 (lambda (i) NO-INPUT))) (walker-crouching? w)))))
           (standing (still #f))
           (crouched (still #t)))
      (display (list 'still-1s 'standing standing 'crouched crouched)) (newline)
      (assert-true (cadr crouched))
      (assert-false (cadr standing))
      (assert-true (> (car crouched) 0.05))
      (assert-true (< (car crouched) (* 0.75 (car standing))))))
  (test "switching the lobby's circuit off lowers the light at your feet there"
    (let ((ls (make-light-state)))
      (light-levels! ls CIRCUITS ALL-ON 1.0 2.0)
      (let ((on (light-at ls DATA 7.0 5.0 0.0)))
        (light-levels! ls CIRCUITS (on-set '(c1 c3 emergency screens city)) 1.0 2.0)
        (let ((off (light-at ls DATA 7.0 5.0 0.0)))
          (display (list 'lobby-c2-on on 'off off)) (newline)
          (assert-true (< off (* 0.25 on))))))))

(test-group "the attempt"
  (test "standing in the lit lobby on the guard's way, you are hunted and caught"
    (let* ((p (fresh-play))
           (r (run p (make-walker 7.0 2.0 0.0 WEST) ALL-ON (* 60 90) (lambda (i) NO-INPUT))))
      (display (list 'caught-run (cdr r) 'ticks (play-ticks p))) (newline)
      (assert-true (memq 'caught (cdr r)))
      (assert-true (eq? (play-outcome p) 'caught))))
  (test "the badge is picked up from beside the FM office desk, and the exit then wins"
    (let* ((p (fresh-play))
           ;; the lights off, so the guard in the office next door is no threat
           (r1 (run p (make-walker 24.0 17.6 0.0 0.0) DARK 90 (lambda (i) FORWARD))))
      (display (list 'badge-run (cdr r1) 'at (walker-x (car r1)) (walker-y (car r1)))) (newline)
      (assert-true (play-badge? p))
      (let ((r2 (run p (make-walker 3.0 8.6 0.0 0.0) DARK 60 (lambda (i) FORWARD))))
        (display (list 'exit-run (cdr r2))) (newline)
        (assert-true (eq? (play-outcome p) 'won)))))
  (test "the exit without the badge does not win"
    (let* ((p (fresh-play))
           (r (run p (make-walker 3.0 8.6 0.0 0.0) DARK 60 (lambda (i) FORWARD))))
      (assert-false (eq? (play-outcome p) 'won))
      (assert-true (play-near-exit? p)))))

(test-group "cost"
  (test "a guard tick with the runner in view across the lobby: time and allocations (printed)"
    ;; in the cone, lit, 7.6 m away across the open lobby (the stairs are
    ;; not between them); the guard put back at its first point before each
    ;; tick, so the case stays the same
    (let* ((p (fresh-play)) (g (play-guard p)) (gw (play-guard-world p))
           (w (make-walker 9.0 5.0 0.0 WEST))
           (n 300)
           (allocs (lambda () (cdr (assq 'allocations (gc-stats)))))
           (glass (play-glass DATA))
           (measure (lambda (label thunk)
                      (let* ((a0 (allocs)) (t0 (current-jiffy)))
                        (let loop ((i 0)) (when (< i n) (thunk) (loop (+ i 1))))
                        (let ((ms (/ (* 1000.0 (- (current-jiffy) t0)) (jiffies-per-second)))
                              (al (- (allocs) a0)))
                          (display (list label 'us-per-call (/ (* 1000.0 ms) n) 'allocs-per-call (/ (* 1.0 al) n)))
                          (newline))))))
      ;; three ticks a call, so each call includes one perception (sight
      ;; runs every third tick)
      (measure 'play-3-ticks (lambda () (guard-reset! g gw 0) (play-tick! p w ALL-ON 1.0 2.0)
                                       (play-tick! p w ALL-ON 1.0 2.0) (play-tick! p w ALL-ON 1.0 2.0)))
      (measure 'sight-ray-8m (lambda () (sight-clear? C glass 2.0 2.0 1.65 9.0 5.0 1.0)))
      (let ((ls (make-light-state)))
        (measure 'light-levels+at (lambda () (light-levels! ls CIRCUITS ALL-ON 1.0 2.0) (light-at ls DATA 12.5 7.5 0.0))))
      (let ((nav (guard-world-nav gw)) (f (make-field (guard-world-nav gw))))
        (nav-field! nav f 12.5 1.5 #f #f)
        (measure 'nav-steer (lambda () (nav-steer! nav f 2.0 2.0)))
        (set! n 10)
        (measure 'nav-field-whole (lambda () (nav-field! nav f 12.5 1.5 #f #f)))
        (measure 'nav-field-chase-6m (lambda () (nav-field! nav f 8.0 4.0 2.0 2.0))))
      ;; and it does see the runner there (sight runs every third tick)
      (guard-reset! g gw 0)
      (play-tick! p w ALL-ON 1.0 2.0) (play-tick! p w ALL-ON 1.0 2.0) (play-tick! p w ALL-ON 1.0 2.0)
      (assert-true (guard-sees? g)))))
