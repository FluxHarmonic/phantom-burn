;; props/kitchen-counter.prop - a 2 m run of kitchen counter (floor 14):
;; laminate top over steel cupboards. Origin on the floor under its middle;
;; the cupboard doors face -y.
(prop kitchen-counter
  parts: ((box  size: (2.0 0.62 0.04)   at: (0 0 0.9)          material: laminate)
          (box  size: (1.96 0.58 0.84)  at: (0 0.02 0.44)      material: steel)
          (box  size: (0.01 0.01 0.7)   at: (-0.5 -0.271 0.46) material: dark)     ; the door seams
          (box  size: (0.01 0.01 0.7)   at: (0 -0.271 0.46)    material: dark)
          (box  size: (0.01 0.01 0.7)   at: (0.5 -0.271 0.46)  material: dark)
          (box  size: (1.96 0.02 0.06)  at: (0 -0.03 0.03)     material: dark))    ; the kick plate
  hides: crouched)
