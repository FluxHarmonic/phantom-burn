;; props/light-switch.prop - a circuit's panel (lights: ... panel: in a floor
;; file), on the wall nearest the point given.
(prop light-switch
  mount: wall
  parts: ((box  size: (0.4 0.08 0.3)    at: (0 0.04 1.35)     material: plastic)
          (box  size: (0.1 0.02 0.05)   at: (0.08 0.09 1.43)  material: led)))
