;; props/vent.prop - an HVAC ceiling diffuser (P3: FACILITIES runs it loud,
;; masking your steps in its room). Placed at the ceiling (z: the ceiling's
;; height): the origin is on the ceiling above its middle and the parts hang
;; below it. The status LED (name: led) is lit while it runs.
(prop vent
  parts: ((box  size: (0.66 0.66 0.04)   at: (0 0 -0.02)        material: steel)    ; the frame
          (box  size: (0.5 0.5 0.02)     at: (0 0 -0.03)        material: dark)     ; the throat
          (box  size: (0.5 0.04 0.02)    at: (0 -0.18 -0.045)   material: steel)    ; the louvres
          (box  size: (0.5 0.04 0.02)    at: (0 -0.06 -0.045)   material: steel)
          (box  size: (0.5 0.04 0.02)    at: (0 0.06 -0.045)    material: steel)
          (box  size: (0.5 0.04 0.02)    at: (0 0.18 -0.045)    material: steel)
          (box  size: (0.03 0.03 0.012)  at: (0.29 -0.29 -0.046) material: led  name: led)))
