;; props/cable-tray.prop - an overhead cable tray, 6 m, cables in it. Place
;; it with z: (its underside's height).
(prop cable-tray
  parts: ((box  size: (6.0 0.4 0.02)   at: (0 0 0.01)         material: steel)
          (box  size: (6.0 0.02 0.12)  at: (0 -0.2 0.06)      material: steel)
          (box  size: (6.0 0.02 0.12)  at: (0 0.2 0.06)       material: steel)
          (box  size: (5.9 0.32 0.07)  at: (0 0 0.055)        material: dark)))   ; the cables
