;; props/lift.prop - one lift's doors on a wall. mount: wall puts the origin on
;; the wall's face at the floor, x along the wall, +y into the room.
(prop lift
  mount: wall
  parts: ((box  size: (1.2 0.1 2.4)     at: (0 0.05 1.2)      material: steel)
          (box  size: (0.02 0.11 2.4)   at: (0 0.055 1.2)     material: dark)     ; the seam
          (box  size: (0.1 0.16 2.5)    at: (-0.65 0.08 1.25) material: steel)    ; jambs
          (box  size: (0.1 0.16 2.5)    at: (0.65 0.08 1.25)  material: steel)
          (box  size: (1.4 0.16 0.1)    at: (0 0.08 2.55)     material: steel)    ; head
          (box  size: (0.2 0.04 0.07)   at: (0 0.18 2.72)     material: led)))    ; the floor lamp
