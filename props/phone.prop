;; props/phone.prop - a desk phone (P3: STAFF rings it to pull the unit).
;; Sits on a desk: origin on the desk top under its middle, front -y. The LED
;; is its own named part (name: led -> ID-led in the floor): the shell blinks
;; it while the phone rings.
(prop phone
  parts: ((box  size: (0.2 0.18 0.05)    at: (0 0 0.025)        material: plastic)  ; the base
          (wedge size: (0.12 0.1 0.02)   at: (0.02 -0.03 0.06)  material: dark)     ; the keypad, rising to the back
          (box  size: (0.21 0.06 0.045)  at: (0 0.055 0.0725)   material: plastic)  ; the handset in its cradle
          (box  size: (0.04 0.05 0.03)   at: (-0.085 0.055 0.07) material: dark)    ; its earpiece end
          (box  size: (0.05 0.02 0.012)  at: (-0.06 -0.035 0.056) material: screen) ; the little display
          (box  size: (0.018 0.018 0.012) at: (0.075 -0.07 0.056) material: led  name: led)))
