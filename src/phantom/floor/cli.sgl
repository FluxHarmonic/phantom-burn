;;; (phantom floor cli) - The floor tools, in the game binary (native only),
;;; the way Harkfell's --room-check lives in harkfell's:
;;;
;;;   phantom-burn --floor-check FLOOR...     gates 1, 2 and 6; problems as
;;;                                           FILE:LINE: message [gate N]
;;;   phantom-burn --floor-compile FLOOR [--out DIR]
;;;                                           DIR/NAME.sgm, NAME.sgm.json,
;;;                                           NAME.collide, tex-*.png
;;;                                           (DIR defaults to build/floors)
;;;   phantom-burn --floor-sheet FLOOR [OUT.svg]
;;;                                           the plan from above
;;;   phantom-burn --floor-time FLOOR [N]     compile N times, print the times
;;;   phantom-burn --floor-replay FILE.collide[.b64] SCRIPT [--dt X]
;;;                                           gate 5's native leg: the trace, one line a tick
;;;                                           (--dt: the sabotage leg's other step)
;;;   phantom-burn --floor-reach FLOOR [--save-witness PATH] [--probe X Y Z]
;;;                                           gate 3: the exit reached from start: and
;;;                                           along each route: with the tier, and the
;;;                                           door holding without it (witnesses replayed
;;;                                           from their text through the real walker);
;;;                                           --probe prints one body settling at X Y Z
;;;
;;; Exit status: 0 clean, 1 problems, 2 a usage or file error.

(define-library (phantom floor cli)
  (import (sigil core)
          (sigil list)
          (sigil math)
          (sigil string)
          (sigil fs)
          (sigil time)
          (sigil process)
          (phantom floor problem)
          (phantom floor sources)
          (phantom floor compile)
          (phantom floor sheet)
          (phantom floor png)
          (phantom floor reach)
          (phantom floor replay)
          (phantom walker)
          (phantom soup))

  (export floor-command? floor-main read-text-file)

  (begin
    (define (args) (cdr (command-line)))

    (define (floor-command?)
      (let ((a (args)))
        (and (pair? a) (string? (car a)) (>= (string-length (car a)) 8)
             (string=? (substring (car a) 0 8) "--floor-"))))

    (define (read-text-file path) (and (file-exists? path) (read-file-string path)))

    (define (say . xs) (for-each display xs) (newline))

    (define (report cf)
      (let ((ps (problems-by-gate (compiled-floor-problems cf))))
        (for-each (lambda (p) (say (problem->string p))) ps)
        (say (compiled-floor-path cf) ": "
             (if (null? ps) "OK" (string-append (number->string (length ps)) " problem" (if (= (length ps) 1) "" "s")))
             "  gates 1:" (number->string (length (problems-of-gate ps 1)))
             " 2:" (number->string (length (problems-of-gate ps 2)))
             " 6:" (number->string (length (problems-of-gate ps 6)))
             (if (pair? (problems-of-gate ps 0)) (string-append " unreadable:" (number->string (length (problems-of-gate ps 0)))) ""))
        (null? ps)))

    (define (arg-after a flag default)
      (cond ((null? a) default)
            ((and (string=? (car a) flag) (pair? (cdr a))) (cadr a))
            (else (arg-after (cdr a) flag default))))

    ;; Each option and how many values follow it.
    (define OPTION-VALUES '(("--out" . 1) ("--save-witness" . 1) ("--probe" . 3) ("--dt" . 1)))

    (define (positional a)
      (let loop ((a a) (acc '()))
        (cond ((null? a) (reverse acc))
              ((and (>= (string-length (car a)) 2) (string=? (substring (car a) 0 2) "--"))
               (let ((k (let ((o (assoc (car a) OPTION-VALUES))) (if o (cdr o) 0))))
                 (loop (let drop ((a (cdr a)) (k k)) (if (or (= k 0) (null? a)) a (drop (cdr a) (- k 1)))) acc)))
              (else (loop (cdr a) (cons (car a) acc))))))

    (define (ms a b) (/ (round (/ (* 10000.0 (- b a)) (jiffies-per-second))) 10.0))

    ;; 2 when a floor file cannot be read, else 1 when any floor has problems.
    (define (check floors)
      (let ((ok (fold-left (lambda (ok f) (and (report (compile-floor f read-text-file (member "--raise" (args)))) ok)) #t floors)))
        (cond ((any (lambda (f) (not (file-exists? f))) floors) 2)
              (ok 0)
              (else 1))))

    (define (compile-to floor out)
      (let* ((t0 (current-jiffy))
             (cf (compile-floor floor read-text-file))
             (t1 (current-jiffy))
             (name (compiled-floor-name cf)))
        (report cf)
        (if (not (compiled-floor-vertices cf))
            2
            (begin
              (ensure-directory out)
              (write-file-bytes (string-append out "/" name ".sgm") (compiled-floor->sgm1 cf))
              (write-file-bytes (string-append out "/" name ".collide") (compiled-floor->collide cf))
              (write-file-string (string-append out "/" name ".sgm.json") (compiled-floor->json cf))
              (for-each (lambda (t)
                          (write-file-bytes (string-append out "/tex-" (car t) ".png")
                                            (rgba->png (cadr t) (caddr t) (cadddr t))))
                        (compiled-floor-textures cf))
              (say "wrote " out "/" name ".sgm (" (number->string (compiled-floor-vertex-count cf)) " vertices, "
                   (number->string (quotient (compiled-floor-index-count cf) 3)) " triangles, "
                   (number->string (length (compiled-floor-parts cf))) " parts), .collide ("
                   (number->string (collision-count (compiled-floor-collision cf))) " triangles), .sgm.json, "
                   (number->string (length (compiled-floor-textures cf))) " textures")
              (say "compiled in " (number->string (ms t0 t1)) " ms  " (stats-line cf))
              (if (null? (compiled-floor-problems cf)) 0 1)))))

    (define (stats-line cf)
      (string-join (map (lambda (s) (string-append (symbol->string (car s)) " " (number->string (cdr s))))
                        (compiled-floor-stats cf))
                   "  "))

    (define (sheet floor out)
      (let* ((cf (compile-floor floor read-text-file))
             (out (or out (string-append "build/floors/" (compiled-floor-name cf) "-sheet.svg"))))
        (report cf)
        (ensure-directory (path-dir out))
        (write-file-string out (floor-sheet-svg cf))
        (say "wrote " out)
        (if (null? (compiled-floor-problems cf)) 0 1)))

    (define (timing floor n)
      (let loop ((i 0) (acc '()))
        (if (< i n)
            (let* ((t0 (current-jiffy))
                   (cf (compile-floor floor read-text-file))
                   (t1 (current-jiffy)))
              (say "run " (number->string (+ i 1)) ": " (number->string (ms t0 t1)) " ms  " (stats-line cf))
              (loop (+ i 1) (cons (ms t0 t1) acc)))
            (begin
              (say "min " (number->string (fold-left min 1e30 acc)) " ms over " (number->string n) " runs")
              0))))

    ;; Where route NAME's witness goes, given --save-witness PATH: PATH for
    ;; the start's, PATH with ".NAME" before its extension for a route's
    ;; (build/floors/replay-14-slice.the-long-way.txt).
    (define (witness-path save name)
      (if (string=? name "start")
          save
          (let loop ((i (- (string-length save) 1)))
            (cond ((or (< i 0) (char=? (string-ref save i) #\/)) (string-append save "." name))
                  ((char=? (string-ref save i) #\.)
                   (string-append (substring save 0 i) "." name (substring save i (string-length save))))
                  (else (loop (- i 1)))))))

    ;; save: #f, or a path for the witness scripts (gate 5's input).
    (define (reach floor save)
      (let* ((t0 (current-jiffy))
             (cf (compile-floor floor read-text-file)))
        (if (not (null? (compiled-floor-problems cf)))
            (begin (report cf) (say "gate 3 not run: the floor has problems") 1)
            (let* ((r (reach-check cf))
                   (t1 (current-jiffy))
                   (ps (cadr r)))
              (for-each say (car r))
              (for-each (lambda (p) (say (problem->string p))) ps)
              (when save
                (for-each (lambda (w)
                            (let ((p (witness-path save (car w))))
                              (write-file-string p (cdr w))
                              (say "wrote the " (car w) " witness to " p)))
                          (caddr r)))
              (say floor ": gate 3 " (if (null? ps) "OK" (string-append (number->string (length ps)) " problems"))
                   " in " (number->string (ms t0 t1)) " ms")
              (if (null? ps) 0 1)))))

    ;; Gate 5's native leg: a script replayed through the walker over the
    ;; floor's PBC1 collision file (the bytes the page ships), one line per
    ;; tick, as the web leg prints them.
    ;; collide-path: a .collide file, or the page's base64 of one (.b64), so
    ;; the native leg reads the very bytes the web leg loads. dt: TICK for
    ;; the gate; any other is gate 5's sabotage leg (it must diverge).
    (define (replay collide-path script-path dt)
      (let* ((b64? (let ((n (string-length collide-path)))
                     (and (> n 4) (string=? (substring collide-path (- n 4) n) ".b64"))))
             (bytes (and (file-exists? collide-path)
                         (if b64?
                             (base64->bytevector (string-trim (read-file-string collide-path)))
                             (read-file-bytes collide-path))))
             (text (read-text-file script-path))
             (script (and text (parse-script text))))
        (cond ((not bytes) (say "SETUP-FAILED: no collision file " collide-path) 2)
              ((not script) (say "SETUP-FAILED: " script-path " is not a replay script") 2)
              ((not dt) (say "SETUP-FAILED: --dt takes a number") 2)
              (else
               (let ((lines (replay-trace (pbc1->collision bytes) script dt)))
                 (for-each (lambda (l) (say "replay " l)) lines)
                 (say "replay-done " (number->string (length lines)))
                 0)))))

    (define (usage)
      (say "usage: phantom-burn --floor-check FLOOR... | --floor-compile FLOOR [--out DIR] |")
      (say "       --floor-sheet FLOOR [OUT.svg] | --floor-time FLOOR [N] |")
      (say "       --floor-reach FLOOR [--save-witness PATH] [--probe X Y Z] |")
      (say "       --floor-replay FILE.collide[.b64] SCRIPT [--dt X]")
      2)

    (define (floor-main)
      (let* ((a (args))
             (cmd (car a))
             (pos (positional (cdr a)))
             (status
               (cond ((and (string=? cmd "--floor-check") (pair? pos)) (check pos))
                     ((and (string=? cmd "--floor-compile") (pair? pos))
                      (compile-to (car pos) (arg-after (cdr a) "--out" "build/floors")))
                     ((and (string=? cmd "--floor-sheet") (pair? pos))
                      (sheet (car pos) (and (pair? (cdr pos)) (cadr pos))))
                     ((and (string=? cmd "--floor-reach") (member "--probe" a) (pair? pos))
                      (let* ((m (member "--probe" a)) (n (lambda (i) (string->number (list-ref m i)))))
                        (for-each say (reach-probe (compile-floor (car pos) read-text-file) (n 1) (n 2) (n 3)))
                        0))
                     ((and (string=? cmd "--floor-reach") (pair? pos))
                      (reach (car pos) (let ((m (member "--save-witness" a))) (and m (pair? (cdr m)) (cadr m)))))
                     ((and (string=? cmd "--floor-replay") (= (length pos) 2))
                      (replay (car pos) (cadr pos) (let ((d (arg-after (cdr a) "--dt" #f))) (if d (string->number d) TICK))))
                     ((and (string=? cmd "--floor-time") (pair? pos))
                      (timing (car pos) (or (and (pair? (cdr pos)) (string->number (cadr pos))) 3)))
                     (else (usage)))))
        (exit status)))))
