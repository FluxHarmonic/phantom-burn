;;; Phantom's legacy walker row codec; Substratic owns script iteration
;;; and tick trace collection. Physics and number formatting stay here.
(define-library (phantom floor replay)
  (import (sigil list)
          (sigil string)
          (substratic input replay)
          (phantom walker))
  (export script->string parse-script replay-trace replay-walker)

  (begin
    (define (flag value) (if value "1" "0"))

    (define (encode-start start)
      (string-append
        "start " (number->string (list-ref start 0)) " "
        (number->string (list-ref start 1)) " "
        (number->string (list-ref start 2)) " "
        (number->string (list-ref start 3))
        (if (list-ref start 4) " crouched" "")))

    (define (encode-input input)
      (string-append
        (number->string (input-move-x input)) " "
        (number->string (input-move-y input)) " "
        (number->string (input-look-yaw input)) " "
        (number->string (input-look-pitch input)) " "
        (flag (input-sneak? input)) " "
        (flag (input-run? input)) " "
        (flag (input-crouch? input)) " "
        (number->string (input-lean input))))

    (define (script->string start inputs)
      (replay-script->text start inputs encode-start encode-input))

    (define (words line)
      (filter (lambda (word) (not (string=? word "")))
              (string-split line " ")))

    (define (decode-start line)
      (let ((head (words line)))
        (and (>= (length head) 5)
             (string=? (car head) "start")
             (let ((start
                     (list
                       (string->number (list-ref head 1))
                       (string->number (list-ref head 2))
                       (string->number (list-ref head 3))
                       (string->number (list-ref head 4))
                       (and (> (length head) 5)
                            (string=? (list-ref head 5) "crouched")))))
               (and (every (lambda (value) value) (take start 4)) start)))))

    (define (decode-input line)
      (let ((row (words line)))
        (and (= (length row) 8)
             (make-input
               (string->number (list-ref row 0))
               (string->number (list-ref row 1))
               (string->number (list-ref row 2))
               (string->number (list-ref row 3))
               (string=? (list-ref row 4) "1")
               (string=? (list-ref row 5) "1")
               (string=? (list-ref row 6) "1")
               (string->number (list-ref row 7))))))

    (define (parse-script text)
      ;; Empty lines were ignored; whitespace-only rows were invalid.
      ;; Keep that distinction and reject newly versioned headers.
      (and
        (every
          (lambda (line)
            (or (string=? line "") (not (string=? (string-trim line) ""))))
          (string-split text "\n"))
        (let ((parsed
                (replay-parse-text text decode-start decode-input
                                   accept-version?: (lambda (version) #f))))
          (and parsed (cdr parsed)))))

    (define (replay-walker start)
      (make-walker (list-ref start 0) (list-ref start 1)
                   (list-ref start 2) (list-ref start 3) (list-ref start 4)))

    (define (trace-line tick walker)
      (string-append
        (number->string tick) " "
        (number->string (walker-x walker)) " "
        (number->string (walker-y walker)) " "
        (number->string (walker-z walker)) " "
        (number->string (walker-yaw walker)) " "
        (number->string (walker-height walker))))

    (define (replay-trace collision script dt)
      (replay-lines
        (replay-walker (car script)) (cdr script)
        (lambda (walker input) (walker-step walker input dt collision))
        trace-line initial?: #t))))
