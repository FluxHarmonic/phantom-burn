;;; (phantom shell native) - The desktop window.
;;;
;;;   phantom-burn [--floor DIR] [--size WxH] [--frames N] [--seconds S] [--view K]
;;;                [--shot K] [--hud 0|1|2] [--dither on|off] [--spread S]
;;;                [--bayer 4|8] [--palette NAME] [--fog M] [--card]
;;;                [--snap] [--affine] [--trace] [--auto] [--night N] [--no-lift] [--pools G]
;;;                [--on all|none|c1,c3]
;;;                [--hide PART] [--deck-preview] [--terminal-preview]
;;;                [--look X,Y,Z,TX,TY,TZ] [--deck-held] [--press KEY@SECONDS,...] [--look-sim]
;;;                [--guard X,Y[,Z[,R]]] [--guard-speed V] [--guard-state S] [--guard-light L]
;;;                [--skin N] [--skin-freeze F] [--skin-look X,Y,Z]
;;;   phantom-burn --skin-bench N                      G1: time N poses of the skinned guard, no window
;;;   phantom-burn --title [--title-at T] [--freeze]   the title screen
;;;   phantom-burn --play [...]                        P1: the guard, the badge, the exit
;;;                [--mute]                            S1's sound off
;;;
;;; --play has S1's sound ((phantom sound game): your steps, the guard, the
;;; hum, the events; assets/tunes/*.cts), except with --mute and in the
;;; automated runs (--frames, --seconds, --shot), which open no audio device.
;;;
;;; --trace prints a stats line every 120 frames (frame, CPU, world and post
;;; pass CPU, draws, allocations per frame); --auto walks forward, turning.
;;;
;;; --floor names the floor's directory: by default assets/floors/14,
;;; the floor compiler's floor 14 (floor.sgm, collide, floor.sexp, the
;;; textures, city.sgm; scripts/floor-import brings it in); assets/stand-in
;;; is G0's Blender export (floor14.sgm, floor14.collide). The floor reloads
;;; by itself when its files change (checked twice a second), with the
;;; walker where it stands and the circuits as they were switched.
;;; --card shows the test card (a sweep of the colour cube) instead of the
;;; world, through the same post pass (scripts/gate-dither's fourth frame).
;;; --frames and --seconds quit after that many frames or seconds of play.
;;; --view starts at one of the floor's views (0 arrival, 1 overlook,
;;; 2 office, then the dark rooms: 3 lobby-dark, 4 office-night, 5
;;; corridor-dark); --shot holds the camera exactly there, for floor shots.
;;;
;;; --hide leaves out a named part of the compiled floor (floor.sexp's parts;
;;; P2 hides the badge this way once it is taken, (render-hide-part!)).
;;; --guard previews the guard's body (models/guard/guard.py, loaded from
;;; assets/guard/guard.sgm) walking a circle of radius R (default 2) around
;;; X,Y at floor height Z (default 0), 1.3 m/s (--guard-speed, 0 stands him),
;;; visor S (0 calm to 3 hunting; default -1 steps through them), lit by grey
;;; L (default 0.7). No AI: P1's play draws the real guard.
;;;
;;; --skin N opens G1's skin door ((phantom guard skin-draw)): the guard is
;;; the skinned one (assets/guard/guard-skin.sgm), and N-1 demo guards follow
;;; his trail; the HUD's SKIN line has the posing cost. --skin-freeze F holds
;;; the walk at fraction F of its cycle, --skin-look X,Y,Z turns the heads
;;; toward a point instead of the camera (both for shots).
;;;
;;; Click to capture the mouse for looking (sigil-desktop 0.12's cursor
;;; capture); Escape gives it back, and quits when it is not captured.

(define-library (phantom shell native)
  (import (sigil math)
          (sigil process)
          (sigil io)
          (sigil list)
          (sigil fs)
          (sigil desktop)
          (sigil graphics)
          (phantom soup)
          (phantom render)
          (phantom game)
          (phantom guard body)
          (phantom guard skin-draw)
          (phantom deck preview)
          (phantom title)
          (phantom play mode)
          (only (phantom play core) play-guard)
          (only (phantom guard guard) guard-place!)
          (phantom sound game)
          (phantom store save))

  (export native-main)

  (begin

    (define (arg-value args flag default)
      (cond ((null? args) default)
            ((and (string=? (car args) flag) (pair? (cdr args))) (cadr args))
            (else (arg-value (cdr args) flag default))))

    (define (size-of s)
      (let ((x-at (let find ((i 0))
                    (cond ((>= i (string-length s)) #f)
                          ((char=? (string-ref s i) #\x) i)
                          (else (find (+ i 1)))))))
        (if x-at
            (cons (or (string->number (substring s 0 x-at)) 1440)
                  (or (string->number (substring s (+ x-at 1) (string-length s))) 810))
            (cons 1440 810))))

    (define *dir* "assets/floors/14")
    (define (compiled?) (file-exists? (path "floor.sexp")))
    (define (path name) (string-append *dir* "/" name))

    (define (load-mesh* layout name) (load-mesh layout (path name)))

    (define (load-texture* name)
      (let* ((img (load-image (path name)))
             (tex (load-texture img)))
        (image-free! img)
        tex))

    (define (load-collision)
      (pbc1->collision (read-file-bytes (path (if (compiled?) "collide" "floor14.collide")))))

    (define (load-info)
      (and (compiled?) (floor-info-from-string (read-file-string (path "floor.sexp")))))

    (define (watched) (if (compiled?) '("floor.sgm" "collide" "floor.sexp") '("floor14.sgm" "floor14.collide")))
    (define (stamps) (map (lambda (n) (or (file-mtime-ns (path n)) 0)) (watched)))

    ;; The keys whose presses the game reads (style lab, crouch, views).
    (define PRESS-KEYS
      (map string->symbol '("c" "p" "[" "]" "/" "b" "n" "-" "=" "h" "v" "x" "7" "8" "9"
                            "j" "k" "l" "1" "2" "3" "4" "5" "6" "0" "," "." "g" ";" "'" "f"
                            ;; the terminal's selection (P3): play takes them while it is open
                            "w" "s" "up" "down")))

    ;; --press KEY@SECONDS,...: presses at those times of play (shots of the
    ;; terminal and the deck), as if typed then
    (define *presses* '())      ; ((seconds . key) ...), earliest first
    (define (presses-from s)
      (let loop ((items (split-commas s)) (acc '()))
        (if (null? items)
            (let sort ((l acc) (out '()))     ; insertion, by time
              (if (null? l) out
                  (sort (cdr l) (let put ((o out))
                                  (cond ((null? o) (list (car l)))
                                        ((< (car (car l)) (car (car o))) (cons (car l) o))
                                        (else (cons (car o) (put (cdr o)))))))))
            (let* ((item (car items)) (at (let find ((i 0)) (cond ((= i (string-length item)) #f)
                                                                   ((char=? (string-ref item i) #\@) i)
                                                                   (else (find (+ i 1)))))))
              (loop (cdr items)
                    (if at
                        (cons (cons (or (string->number (substring item (+ at 1) (string-length item))) 0.0)
                                    (string->symbol (substring item 0 at)))
                              acc)
                        acc))))))
    (define (split-commas s)
      (let loop ((i 0) (start 0) (acc '()))
        (cond ((= i (string-length s)) (reverse (cons (substring s start i) acc)))
              ((char=? (string-ref s i) #\,) (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
              (else (loop (+ i 1) start acc)))))
    (define (due-presses! elapsed)
      (let loop ((acc '()))
        (if (and (pair? *presses*) (<= (car (car *presses*)) elapsed))
            (let ((k (cdr (car *presses*)))) (set! *presses* (cdr *presses*)) (loop (cons k acc)))
            acc)))

    (define (pressed-keys)
      (let loop ((ks PRESS-KEYS) (acc '()))
        (cond ((null? ks) acc)
              ((key-pressed? (car ks)) (loop (cdr ks) (cons (car ks) acc)))
              (else (loop (cdr ks) acc)))))

    (define (apply-settings! args)
      (let ((d (arg-value args "--dither" #f))
            (s (string->number (arg-value args "--spread" "none")))
            (b (string->number (arg-value args "--bayer" "none")))
            (p (arg-value args "--palette" #f))
            (f (string->number (arg-value args "--fog" "none")))
            (h (string->number (arg-value args "--hud" "none")))
            (v (string->number (arg-value args "--view" "none")))
            (shot (string->number (arg-value args "--shot" "none"))))
        (when d (render-dither! (string=? d "on")))
        (when (member "--card" args) (render-card! #t))
        (when (member "--snap" args) (render-snap! 1.0))
        (when (member "--affine" args) (render-affine! #t))
        (when (member "--trace" args) (game-set-trace! #t))
        (let ((n (string->number (arg-value args "--night" "none")))) (when n (render-night! n)))
        (when (member "--no-lift" args) (render-lift! #f))
        (let ((g (string->number (arg-value args "--pools" "none")))) (when g (render-pools! g)))
        (when (member "--auto" args) (game-set-auto! #t))
        (when s (render-spread! s))
        (when b (render-bayer! b))
        (when p (render-palette! (string->symbol p)))
        (when f (render-fog! f))
        (when h (game-set-hud! h))
        (when v (game-set-view! v))
        (when shot (game-set-shot! shot))
        (let ((on (arg-value args "--on" #f))) (when on (game-set-on! on)))
        (let ((h (arg-value args "--hide" #f))) (when h (render-hide-part! (string->symbol h) #t)))))

    ;; --play: P1's game ((phantom play mode)) on a compiled floor with a
    ;; play.sexp (scripts/play-import.mjs): the guard, the badge, the exit.
    (define (start-play! args info)
      (when (and (member "--play" args) info (file-exists? (path "play.sexp")))
        (play-mode-start! (game-collision) info (read-file-string (path "play.sexp"))
                          (not (arg-value args "--view" #f)))
        (game-set-play! (vector play-hold? play-after-tick! play-frame! play-hud! play-press! play-held!))
        (play-mode-set-dev! (and (member "--dev" args) #t))
        ;; the floor's best (Phantom 0.1), kept in the save file
        (let ((b (save-best-entry (read-save-all) (floor-name))))
          (play-mode-set-best! (and b (cons (caddr b) (cadddr b)))))
        (play-mode-set-on-record! (lambda (secs incidents) (record-best! (floor-name) secs incidents)))
        ;; the pause panel's rows: RESUME takes the mouse again; FULLSCREEN;
        ;; QUIT (natively, there is no title flow here: it quits)
        (play-mode-set-on-resume! (lambda () (set-cursor-captured! #t #f)))
        (play-mode-set-on-fullscreen! toggle-fullscreen!)
        (play-mode-set-on-quit! request-quit "QUIT")
        ;; --place-guard X,Y,FX,FY: the unit put there, facing so (for looking
        ;; at it and its flashlight; it walks back to its route from there)
        (let ((g (arg-value args "--place-guard" #f)))
          (when g
            (let ((v (numbers g)))
              (when (and (= (length v) 4) (not (memq #f v)))
                (guard-place! (play-guard (play-mode-core)) (car v) (cadr v) (caddr v) (cadddr v))))))
        ;; --end-card SECS: straight to the 0.1 end card (for looking at it)
        (let ((e (arg-value args "--end-card" #f)))
          (when e (play-mode-show-end! (or (string->number e) 0))))
        (unless (member "--hud" args) (game-set-hud! 0))))

    ;; --- the save (Phantom 0.1): what is remembered, natively ---------------------
    ;; $XDG_DATA_HOME/phantom-burn/save.sexp (else ~/.local/share/...): one
    ;; datum, ((best FLOOR SECS INCIDENTS) ...), each floor's best time and
    ;; fewest incidents (the page keeps the same in localStorage).
    (define (save-dir)
      (legacy-save-directory (getenv "XDG_DATA_HOME") (getenv "HOME")))
    (define (save-path) (string-append (save-dir) "/save.sexp"))
    (define (floor-name)
      (let loop ((i (- (string-length *dir*) 1)))
        (cond ((< i 0) *dir*)
              ((char=? (string-ref *dir* i) #\/) (substring *dir* (+ i 1) (string-length *dir*)))
              (else (loop (- i 1))))))
    ;; the whole save: ((best FLOOR SECS INCIDENTS) ... (fullscreen #t|#f))
    (define (read-save-all)
      (legacy-save->entries
        (and (file-exists? (save-path))
             (guard (exception (#t #f))
               (read-file-string (save-path))))))

    (define (write-save! entries)
      (guard (exception (#t #f))
        (ensure-directory (save-dir))
        (write-file-string (save-path) (entries->legacy-save entries))))

    (define (record-best! floor seconds incidents)
      (write-save!
        (save-with-best (read-save-all) floor seconds incidents)))

    ;; fullscreen (Substratic's toggle, (substratic view window): F11 or
    ;; Alt+Enter, remembered between runs; without its 2D view fit)
    (define (fullscreen-remembered?)
      (let ((e (find (lambda (x) (eq? (car x) 'fullscreen)) (read-save-all)))) (and e (pair? (cdr e)) (cadr e) #t)))
    (define (toggle-fullscreen!)
      (let ((on (not (fullscreen?))))
        (set-fullscreen! on)
        (write-save! (cons (list 'fullscreen on) (filter (lambda (x) (not (eq? (car x) 'fullscreen))) (read-save-all))))))

    ;; The guard's body (G1's skinned robot, one for every floor), and the
    ;; skin door's demo (--skin N). The baked guard (assets/guard/guard.sgm)
    ;; is no longer loaded.
    (define SKIN-FILE (string-append "assets/" SKIN-SGM))
    (define (skin-setup! args)
      (let ((n (string->number (arg-value args "--skin" "none"))))
        (when (file-exists? SKIN-FILE)
          (when (and n (> n 0)) (skin-door! n))
          (skin-load! (lambda (layout) (load-mesh layout SKIN-FILE)))
          (let ((f (string->number (arg-value args "--skin-freeze" "none")))) (when f (skin-freeze! (* 1.0 f))))
          (let ((l (arg-value args "--skin-look" #f)))
            (when l (let ((ns (map (lambda (v) (* 1.0 (or v 0))) (numbers l))))
                      (when (= (length ns) 3) (apply skin-look-at! ns))))))))

    (define (numbers s)     ; "1,2.5,3" -> (1 2.5 3); #f for a word that is not one
      (let loop ((i 0) (start 0) (acc '()))
        (if (or (= i (string-length s)) (char=? (string-ref s i) #\,))
            (let ((acc (cons (string->number (substring s start i)) acc)))
              (if (= i (string-length s)) (reverse acc) (loop (+ i 1) (+ i 1) acc)))
            (loop (+ i 1) start acc))))

    (define (guard-preview! args)
      (let ((g (arg-value args "--guard" #f)))
        (when g
          (let* ((ns (numbers g))
                 (at (lambda (k d) (if (and (> (length ns) k) (list-ref ns k)) (* 1.0 (list-ref ns k)) d)))
                 (num (lambda (flag d) (let ((v (string->number (arg-value args flag "none")))) (if v (* 1.0 v) d)))))
            (if (skin-ready?)
                (begin
                  (guard-preview-set! (at 0 0.0) (at 1 0.0) (at 2 0.0) (at 3 2.0)
                                      (num "--guard-speed" 1.3)
                                      (exact (round (num "--guard-state" -1.0)))
                                      (num "--guard-light" 0.7))
                  (render-set-extra-draw! guard-preview-draw!))
                (begin (display (string-append "phantom-burn: --guard: no " SKIN-FILE)) (newline)))))))

    ;; S1's sound: with --play, not muted, and not an automated run
    (define (sound-wanted? args frames seconds)
      (and (member "--play" args) (not (member "--mute" args))
           (not frames) (not seconds) (not (arg-value args "--shot" #f))))

    ;; What is held: the keyboard, and the deck (P3): T or the right mouse button.
    (define *deck-held* #f)      ; --deck-held: the deck held all along (shots)
    (define (held? k)
      (if (eq? k 'deck)
          (or *deck-held* (key-down? 't) (mouse-down? 'right))
          (key-down? k)))

    (define (game-loop args frames seconds)
      (lambda ()
        (gfx-setup)
        ;; --look-sim: any compiled floor in the sim's look (PRACTICE, D38)
        (when (member "--look-sim" args) (render-force-sim! #t))
        (game-init! load-mesh* load-texture* (load-collision) (load-info))
        (skin-setup! args)
        (apply-settings! args)
        (start-play! args (load-info))
        (when (sound-wanted? args frames seconds)
          (sound-game-init! (lambda (name)
                              (let ((f (string-append "assets/tunes/" name ".cts")))
                                (and (file-exists? f) (read-file-string f)))))
          (sound-game-gesture!))                 ; natively no gesture is needed: start now

        (guard-preview! args)
        ;; shots of the deck: stand at X,Y (eyes at Z) looking at TX,TY,TZ; hold the deck
        (let ((l (arg-value args "--look" #f)))
          (when l
            (let ((n (map (lambda (v) (* 1.0 (or v 0))) (numbers l))))
              (when (= (length n) 6) (apply game-place! n)))))
        (when (member "--deck-held" args) (set! *deck-held* #t))
        (let ((p (arg-value args "--press" #f))) (when p (set! *presses* (presses-from p))))
        ;; P3: the deck's prompt or the terminal from made-up data (no play logic)
        (cond ((member "--terminal-preview" args) (game-set-play! (deck-preview-hooks #t)))
              ((member "--deck-preview" args) (game-set-play! (deck-preview-hooks #f))))
        ;; fullscreen as last time (not for automated runs: shots, --frames, --seconds)
        (when (and (fullscreen-remembered?) (not frames) (not seconds) (not (arg-value args "--shot" #f)))
          (set-fullscreen! #t))
        (let loop ((n 0) (seen (stamps)) (elapsed 0.0))
          (let* ((dt (wait-frame))
                 (elapsed (+ elapsed dt))
                 (captured? (cursor-captured?)))
            (when (and (not captured?) (mouse-pressed? 'left))
              (set-cursor-captured! #t #f))
            (game-frame! dt (frame-width) (frame-height)
                         (make-controls held? (append (due-presses! elapsed) (pressed-keys))
                                        (if captured? (mouse-dx) 0) (if captured? (mouse-dy) 0)
                                        0.0 0.0 0.0 0.0))
            (sound-game-frame! dt (game-walker))
            ;; ready once the first frame is drawn (shots wait for this line)
            (when (= n 0) (display "phantom-burn: ready") (newline))
            (let ((seen (if (= 0 (modulo n 30))
                            (let ((now (stamps)))
                              (unless (equal? now seen)
                                (display "phantom-burn: floor changed, reloading") (newline)
                                (game-reload! load-mesh* load-texture* (load-collision) (load-info))
                                (start-play! args (load-info)))
                              now)
                            seen)))
              ;; F11 or Alt+Enter: fullscreen, remembered
              (when (or (key-pressed? 'f11)
                        (and (key-pressed? 'return) (or (key-down? 'alt) (key-down? 'right-alt))))
                (toggle-fullscreen!))
              (cond ((and (key-pressed? 'escape) captured?) (set-cursor-captured! #f) (loop (+ n 1) seen elapsed))
                    ;; in play Escape is the pause panel's (its QUIT row quits)
                    ((and (key-pressed? 'escape) (play-mode-active?)) (loop (+ n 1) seen elapsed))
                    ((key-pressed? 'escape) (request-quit))
                    ((quit-requested?) #t)
                    ((and frames (>= n frames)) (request-quit))
                    ((and seconds (>= elapsed seconds)) (request-quit))
                    (else (loop (+ n 1) seen elapsed))))))
        (display "phantom-burn: status ") (write (game-status)) (newline)
        (gfx-shutdown)))

    ;; The title screen (--title): its own loop, in the root-console room
    ;; (assets/floors/root-room, or --floor DIR; a DIR with no floor.sexp,
    ;; e.g. --floor none, gives the stand-in room built in title.sgl). --title-at T
    ;; starts its clock at T seconds, --freeze holds it there (shots of one
    ;; moment of the animation).
    (define (title-loop args frames seconds)
      (lambda ()
        (gfx-setup)
        (title-init! load-mesh* load-texture* (load-info))
        ;; --menu: the flow's menu, for shots (the desktop has no flow yet)
        (when (member "--menu" args) (title-set-menu! (list "PRACTICE" "INFILTRATE") (if (member "--practiced" args) 1 0) (if (member "--practiced" args) #f "NEW HERE? START WITH PRACTICE")))
        (apply-settings! args)
        (let ((freeze? (member "--freeze" args))
              (t0 (or (string->number (arg-value args "--title-at" "none")) 0.0)))
        (let loop ((n 0) (t t0) (elapsed 0.0))
          (let* ((dt (wait-frame))
                 (elapsed (+ elapsed dt))
                 (t (if freeze? t (+ t dt))))
            (title-frame! t (frame-width) (frame-height))
            (when (= n 0) (display "phantom-burn: ready title") (newline))
            (cond ((key-pressed? 'escape) (request-quit))
                  ((quit-requested?) #t)
                  ((and frames (>= n frames)) (request-quit))
                  ((and seconds (>= elapsed seconds)) (request-quit))
                  (else (loop (+ n 1) t elapsed))))))
        (gfx-shutdown)))

    (define (native-main . _args)
      (let* ((args (cdr (command-line)))
             (frames (string->number (arg-value args "--frames" "none")))
             (seconds (string->number (arg-value args "--seconds" "none")))
             (size (size-of (arg-value args "--size" "1440x810"))))
        (set! *dir* (arg-value args "--floor" (if (member "--title" args) "assets/floors/root-room" *dir*)))
        (let ((b (string->number (arg-value args "--skin-bench" "none"))))
          (when b (skin-bench! (exact b)) (exit 0)))
        (run-game "Phantom Burn" (car size) (cdr size)
                  (if (member "--title" args)
                      (title-loop args frames seconds)
                      (game-loop args frames seconds)))
        0))))
