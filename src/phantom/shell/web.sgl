;;; (phantom shell web) - The browser shell: one frame per
;;; requestAnimationFrame dispatch.
;;;
;;; At boot it fetches the floor's meshes and textures through the gles3
;;; bridge, from assets/floors/FLOOR/ (a compiled floor; 14 by
;;; default) or assets/stand-in/ (?floor=stand-in). The page fetches the
;;; collision and a compiled floor's floor.sexp and hands them over as
;;; strings, because the bridge has no fetch into a bytevector. The game
;;; starts once all of it has landed.
;;;
;;; The page's events, besides the loader's keydown and keyup:
;;;   ("params", "k=v&...")  the page's query: floor, view, shot, hud,
;;;                          dither, spread, bayer, palette, fog, card, snap, affine, trace, auto,
;;;                          skin (G1's skin door: N skinned guards, (phantom
;;;                          guard skin-draw)), skinfreeze F, skinlook X,Y,Z
;;;   ("look", "dx,dy")      pointer-locked mouse motion, CSS pixels
;;;   ("move", "x,y")        the left stick, -1..1, y down
;;;   ("lookstick", "x,y")   the right stick
;;;   ("press", "KEY")       a button on the page (the crouch button sends c)
;;;   ("dpr", "N")           window.devicePixelRatio, at boot and on a resize
;;;   ("floorinfo", TEXT)    a compiled floor's floor.sexp (before its assets load)
;;;   ("playinfo", TEXT)     the floor's play.sexp, P1's game (not with ?play=0), before the collision
;;;   ("nofloor", "")        ?title=1: the room's floor.sexp did not load (the
;;;                          title then uses its stand-in room)
;;;   ("titleinfo", TEXT)    the flow (flow=1 in the params, the site's
;;;                          default): the root room's floor.sexp, for the title
;;;                          before play; ("notitle", "") when it did not load
;;;
;;; The flow: the title in the root-console room until a key, a click or a
;;; tap ("press", "start"), then P1's game on the floor; a win's card, then
;;; the title again. The title's room and the floor load side by side, each
;;; with its own info and fetches, because the renderer holds one floor at a
;;; time: each switch reloads the one it goes to.

(define-library (phantom shell web)
  (import (sigil math)
          (sigil graphics)
          (sigil graphics image)
          (sigil browser gles3)
          (phantom soup)
          (phantom render)
          (phantom game)
          (phantom title)
          (phantom stand-in)
          (phantom walker)
          (phantom input state)
          (phantom store browser)
          (phantom web params)
          (phantom floor replay)
          (phantom play mode)
          (phantom sound game)
          (phantom sound tunes)
          (substratic audio tunes)
          (phantom guard skin-draw))

  (export web-main web-dispatch)

  (begin

    (define *floor* "14")
    (define *info* #f)           ; a compiled floor's floor.sexp datum
    (define *info-text* #f)
    (define *params* '())        ; ((key . value) ...) from the page's query
    (define *params-seen* #f)    ; nothing is fetched before the page names the floor
    (define *fetches* '())       ; (name . handle)
    (define *collide* #f)        ; the base64 text, once the page sends it
    (define *play-text* #f)      ; the floor's play.sexp, sent before the collision
    (define *replay-text* #f)    ; a gate-5 script that came before the game started
    (define *started* #f)        ; #f, #t, or 'failed
    (define *said-ready* #f)
    (define *waited* 0.0)        ; seconds since the page named the floor, until start
    (define *said-stuck* #f)
    (define *last-ms* #f)
    (define *input* (make-web-input))

    ;; S1's sound ((phantom sound game)): the page fetches its tunes
    ;; (SOUND-TUNES) and hands each over as ("tune", "NAME\nTEXT"); the loader
    ;; answers from what has landed. ?mute=1: no sound at all. ?trace=1: a
    ;; line of the sound's costs every 120 frames.
    (define *tunes* (make-tunes))
    (define (tune-loader name) (tunes-text *tunes* name))
    (define *sound-frames* 0)
    (define (sound-traced!)
      (set! *sound-frames* (+ *sound-frames* 1))
      (when (and (param "trace") (= 0 (modulo *sound-frames* 120)))
        (let ((t (sound-game-trace)))
          (when t (display (string-append "phantom-burn: sound " t)) (newline)))))

    (define (param key)
      (web-param *params* key))
    ;; "SECS_INCIDENTS" -> (secs . incidents), or #f
    (define (best-param v)
      (and v (let loop ((i 0))
               (cond ((>= i (string-length v)) #f)
                     ((char=? (string-ref v i) #\_)
                      (let ((a (string->number (substring v 0 i))) (b (string->number (substring v (+ i 1) (string-length v)))))
                        (and a b (cons a b))))
                     (else (loop (+ i 1)))))))

    (define (stand-in?) (string=? *floor* "stand-in"))

    ;; the floor's meshes and textures, and the guard's body (assets/guard, for
    ;; every floor: P1's play draws it)
    ;; The body is G1's skinned robot (the baked guard's guard.sgm is no
    ;; longer fetched).
    (define GUARD-SGM "guard/guard.sgm")
    (define (asset-names) (cons SKIN-SGM (floor-asset-names)))
    ;; ?skin=N: the skin door's demo, N guards (absent or 0: play's one guard)
    (define (skin-n) (let ((v (and (param "skin") (string->number (param "skin"))))) (if (and v (> v 0)) (exact v) 0)))
    (define (skin-setup!)
      (when (> (skin-n) 0) (skin-door! (skin-n)))
      (skin-load! (lambda (layout) (load-mesh* layout SKIN-SGM)))
      (when (> (skin-n) 0)
        (let ((f (and (param "skinfreeze") (string->number (param "skinfreeze"))))) (when f (skin-freeze! (* 1.0 f))))
        (let ((l (param "skinlook")))
          (when l (let ((ns (map (lambda (v) (* 1.0 (or v 0))) (map string->number (string-split l ",")))))
                    (when (= (length ns) 3) (apply skin-look-at! ns)))))))
    (define (floor-asset-names)
      (if (stand-in?)
          (append '("floor14.sgm" "city.sgm")
                  (let loop ((ds stand-in-draws))
                    (cond ((null? ds) '())
                          ((caddr (car ds)) (cons (caddr (car ds)) (loop (cdr ds))))
                          (else (loop (cdr ds))))))
          (append '("floor.sgm" "city.sgm")
                  (filter (lambda (t) t) (map (lambda (p) (list-ref p 3)) (cdr (assq 'parts *info*)))))))

    (define (url name)
      (cond ((or (string=? name GUARD-SGM) (string=? name SKIN-SGM)) (string-append "assets/" name))
            (else (floor-url name))))
    (define (floor-url name)
      (if (stand-in?)
          (string-append "assets/stand-in/" name)
          (string-append "assets/floors/" *floor* "/" name)))
    (define (handle name) (cdr (assoc name *fetches*)))

    (define (load-mesh* layout name)
      (let ((h (handle name)))
        (load-mesh-from-memory layout (gles3-image-ptr h) (gles3-image-size h))))

    (define (load-texture* name)
      (let* ((h (handle name))
             (img (load-image-from-memory (gles3-image-ptr h) (gles3-image-size h)))
             (tex (load-texture img)))
        (image-free! img)
        tex))

    (define (fetched?)
      (and (pair? *fetches*)
           (let loop ((fs *fetches*))
             (or (null? fs)
                 (and (gles3-image-ready? (cdar fs)) (loop (cdr fs)))))))
    (define (all-ready?) (and *collide* (fetched?)))

    ;; Phantom aliases and browser Ctrl policy live in the input adapter.
    (define (held? key)
      (web-input-held? *input* key))

    (define (frame-dt payload)
      (let* ((ms (or (string->number payload) 0.0))
             (dt (if *last-ms* (/ (- ms *last-ms*) 1000.0) (/ 1.0 60.0))))
        (set! *last-ms* ms)
        (if (or (< dt 0.0) (> dt 0.25)) (/ 1.0 60.0) dt)))

    (define (apply-params!)
      (let ((d (param "dither"))
            (s (and (param "spread") (string->number (param "spread"))))
            (b (and (param "bayer") (string->number (param "bayer"))))
            (p (param "palette"))
            (f (and (param "fog") (string->number (param "fog"))))
            (h (and (param "hud") (string->number (param "hud"))))
            (v (and (param "view") (string->number (param "view"))))
            (shot (and (param "shot") (string->number (param "shot")))))
        (when d (render-dither! (not (string=? d "off"))))
        (when (param "card") (render-card! #t))
        (when (param "snap") (render-snap! (or (string->number (param "snap")) 1.0)))
        (when (param "affine") (render-affine! #t))
        (when (param "trace") (game-set-trace! #t))
        (when (param "pools") (render-pools! (or (string->number (param "pools")) 2.0)))
        (when (param "lift") (render-lift! (not (string=? (param "lift") "0"))))
        (when (param "night") (render-night! (or (string->number (param "night")) 1.0)))
        (when (param "auto") (game-set-auto! #t))
        (when s (render-spread! s))
        (when b (render-bayer! b))
        (when p (render-palette! (string->symbol p)))
        (when f (render-fog! f))
        ;; the HUD (stats, style lab state) only with ?dev; ?hud=N overrides.
        ;; The keys stay live either way (H shows it).
        (game-set-hud! (or h (if (param "dev") 1 0)))
        (when v (game-set-view! v))
        (when shot (game-set-shot! shot))
        (when (param "on") (game-set-on! (param "on")))))

    (define (start!)
      ;; one attempt: a failure is reported once, not retried per frame
      (set! *started* 'failed)
      (game-init! load-mesh* load-texture* (pbc1->collision (base64->bytevector *collide*)) *info*)
      (skin-setup!)
      (set! *collide* #f)
      (apply-params!)
      (when (and *play-text* *info*)
        (play-mode-start! (game-collision) *info* *play-text* (not (param "view")))
        (set! *play-text* #f)
        (game-set-play! (vector play-hold? play-after-tick! play-frame! play-hud! play-press! play-held!))
        (play-mode-set-dev! (and (param "dev") #t))
        (when (param "flow") (play-mode-set-on-win! (lambda () (set! *want-title* #t))))
        ;; the pause panel's rows (Phantom 0.1): RESUME takes the pointer again,
        ;; FULLSCREEN is the page's, and in the flow QUIT TO TITLE
        (play-mode-set-on-resume! (lambda () (display "phantom-burn: lock") (newline)))
        (play-mode-set-on-fullscreen! (lambda () (display "phantom-burn: fullscreen") (newline)))
        (when (param "flow") (play-mode-set-on-quit! (lambda () (set! *want-title* #t))))
        ;; Crash suggests the sim to a player who has not finished PRACTICE
        (play-mode-set-practiced! (and (param "practiced") #t))
        (when (param "touch") (play-mode-set-touch! #t))
        ;; the floor's best (Phantom 0.1): the page's localStorage, as &best=SECS_INCIDENTS;
        ;; a finish goes back to it as a line
        (play-mode-set-best! (best-param (param "best")))
        (play-mode-set-on-record!
         (lambda (secs incidents)
           ;; one display: on the web each display call is its own console line,
           ;; and the page reads the protocol a line at a time
           (display (string-append "phantom-burn: floor-done " *floor* " "
                                   (number->string secs) " " (number->string incidents)))
           (newline)))
        (unless (or (param "hud") (param "dev")) (game-set-hud! 0)))
      (set! *started* #t)
      (when *replay-text* (run-replay! *replay-text*) (set! *replay-text* #f)))

    ;; Gate 5: step a replay script through the real walker at TICK over the
    ;; loaded floor's collision, one line per tick (the native tool prints the
    ;; same lines; the gate compares them byte for byte).
    (define (run-replay! text)
      (let ((script (parse-script text)))
        (if (not script)
            (begin (display "phantom-burn: replay-error not a script") (newline))
            (let ((lines (replay-trace (game-collision) script TICK)))
              (for-each (lambda (l) (display (string-append "phantom-burn: replay " l)) (newline)) lines)
              (display (string-append "phantom-burn: replay-done " (number->string (length lines)))) (newline)))))

    ;; ?title=1: the title screen, in the root-console room (the page sends
    ;; assets/floors/root-room's floor.sexp; no collision). It starts once the
    ;; room's meshes and textures land, or in its stand-in room when the page
    ;; says the floor did not load, or after 10 s of waiting.
    (define *title-t* #f)
    (define *no-floor* #f)
    (define (title-start! info)
      (if info
          (title-init! load-mesh* load-texture* info)
          (title-init!))
      (apply-params!)
      (set! *title-t* 0.0))
    (define (title-tick payload)
      (let ((dt (frame-dt payload)))
        (when (and (not *title-t*) (not *info*) *info-text*)
          (let ((text *info-text*))
            (set! *info-text* #f)
            (set! *info* (guard (e (#t (display "phantom-burn: title: floor.sexp does not read") (newline) #f))
                           (floor-info-from-string text)))
            (unless *info* (set! *no-floor* #t))))
        (when (and (not *title-t*) *info* (null? *fetches*))
          (set! *fetches* (map (lambda (n) (cons n (gles3-fetch-image (url n)))) (asset-names))))
        (unless *title-t*
          (set! *waited* (+ *waited* dt))
          (cond ((and *info* (fetched?)) (title-start! *info*))
                ((or *no-floor* (> *waited* 10.0))
                 (display "phantom-burn: title: no room, the stand-in room instead") (newline)
                 (title-start! #f))))
        (if *title-t*
            (begin
              (set! *title-t* (+ *title-t* dt))
              (title-frame! *title-t* (gles3-canvas-width) (gles3-canvas-height))
              (unless *said-ready*
                (set! *said-ready* #t)
                (display "phantom-burn: ready title") (newline)))
            (begin
              (begin-frame)
              (clear-screen 0.0 0.0 0.0)
              (end-frame)))))

    (define (web-tick payload)
      (cond ((and *params-seen* (param "title"))
             (gles3-resize-to-display)
             (title-tick payload))
            ((and *params-seen* (param "flow") (eq? *mode* 'title))
             (gles3-resize-to-display)
             (flow-title-tick payload))
            (else
             (web-tick* payload)
             (when *want-title*
               (set! *want-title* #f)
               (flow-to-title!)))))

    ;; --- the flow: title, then play, then the title --------------------------

    (define *mode* 'title)           ; the flow's: title or game (?go= starts in game)
    ;; The menu (PRACTICE, D38): PRACTICE is floor sim, INFILTRATE floor 14.
    ;; The page loads one floor behind the title (sim for a first-timer, else
    ;; 14); picking the other says "go FLOOR" and the page reloads with ?go=.
    (define MENU-ITEMS '("PRACTICE" "INFILTRATE"))
    (define MENU-FLOORS '("sim" "14"))
    (define *menu-sel* 1)
    (define *tap* #f)                ; (x . y): a tap or click on the title, canvas pixels
    (define *going* #f)              ; asked the page for the other floor
    (define *want-title* #f)         ; a win's card is done: back to the title
    (define *said-practiced* #f)     ; "practice done" printed
    (define *t-info-text* #f)
    (define *t-info* #f)
    (define *t-fetches* '())
    (define *t-none* #f)             ; the room's floor.sexp did not load
    (define *t-bare* #f)             ; the title is up without its room (yet)
    (define *t-waited* 0.0)
    (define *t-time* #f)             ; seconds on the title, once it is up
    (define (t-url name) (string-append "assets/floors/root-room/" name))
    (define (t-handle name) (cdr (assoc name *t-fetches*)))
    (define (t-load-mesh* layout name)
      (let ((h (t-handle name))) (load-mesh-from-memory layout (gles3-image-ptr h) (gles3-image-size h))))
    (define (t-load-texture* name)
      (let* ((h (t-handle name))
             (img (load-image-from-memory (gles3-image-ptr h) (gles3-image-size h)))
             (tex (load-texture img)))
        (image-free! img)
        tex))
    (define (t-asset-names)
      (append '("floor.sgm" "city.sgm")
              (filter (lambda (t) t) (map (lambda (p) (list-ref p 3)) (cdr (assq 'parts *t-info*))))))
    (define (t-fetched?)
      (and (pair? *t-fetches*)
           (let loop ((fs *t-fetches*))
             (or (null? fs) (and (gles3-image-ready? (cdar fs)) (loop (cdr fs)))))))

    ;; The title (again): the root room when it has loaded, else the
    ;; stand-in room. It reloads the renderer's floor.
    (define (flow-title-start!)
      ;; the guard belongs to the floor, not the title's room
      (render-set-extra-draw! #f)
      (if (and *t-info* (t-fetched?))
          (title-init! t-load-mesh* t-load-texture* *t-info*)
          (title-init!))
      ;; started without its room (it had not landed within 10 s: a slow
      ;; network, the game's own files loading too): put the room in when it
      ;; lands (David, 2026-09-29: the first title after a cold load showed
      ;; only the console; a title after PRACTICE had the room)
      (set! *t-bare* (not (and *t-info* (t-fetched?))))
      (apply-params!)
      (web-input-clear-pressed! *input*)
      (set! *tap* #f)
      ;; PRACTICE finished (now or before): the menu points at INFILTRATE
      (set! *menu-sel* (if (and (string=? *floor* "sim") (not (practiced?))) 0 1))
      (title-set-menu! MENU-ITEMS *menu-sel* (menu-hint))
      (set! *t-time* 0.0)
      (set! *mode* 'title)
      (display "phantom-burn: mode title") (newline))

    ;; practiced: on this browser before (the page's localStorage), or just now
    (define (practiced?) (or (and (param "practiced") #t) *said-practiced* (play-mode-practice-done?)))
    (define (menu-hint) (if (practiced?) #f "NEW HERE? START WITH PRACTICE"))

    (define (flow-to-title!)
      (sound-game-stop!)
      (flow-title-start!))

    ;; The floor's game, from the title: the first time as the game starts
    ;; (once its files have landed: web-tick* waits for them), after that by
    ;; reloading its floor into the renderer and a fresh attempt.
    (define (flow-to-game!)
      (set! *mode* 'game)
      (web-input-clear-keys! *input*)
      (when (eq? *started* #t)
        (game-reload! load-mesh* load-texture* (game-collision) *info*)
        (apply-params!)
        (play-mode-reset!))
      (display "phantom-burn: mode game") (newline))

    (define (menu-input!)
      (let ((go? #f))
        (for-each (lambda (p)
                    (case p
                      ((up w) (set! *menu-sel* (max 0 (- *menu-sel* 1))))
                      ((down s) (set! *menu-sel* (min (- (length MENU-ITEMS) 1) (+ *menu-sel* 1))))
                      ((tap) #f)
                      (else (set! go? #t))))
                  (reverse (web-input-pressed *input*)))
        (when *tap*
          (let ((hit (title-menu-hit (gles3-canvas-width) (gles3-canvas-height) (car *tap*) (cdr *tap*))))
            (when hit (set! *menu-sel* hit) (set! go? #t))))
        (title-set-menu! MENU-ITEMS *menu-sel* (menu-hint))
        (when go?
          (let ((want (list-ref MENU-FLOORS *menu-sel*)))
            (cond ((string=? want *floor*) (flow-to-game!))
                  ((not *going*)
                   (set! *going* #t)
                   (display (string-append "phantom-burn: go " want)) (newline)))))))

    (define (flow-title-tick payload)
      (let ((dt (frame-dt payload)))
        ;; the floor's files load behind the title (once the title is up, so the
        ;; title's room lands first), and the sound's bank renders
        (when *t-time* (prefetch-game!))
        (sound-game-idle!)
        (when (and (not *t-info*) *t-info-text*)
          (let ((text *t-info-text*))
            (set! *t-info-text* #f)
            (set! *t-info* (guard (e (#t (display "phantom-burn: title: floor.sexp does not read") (newline) #f))
                             (floor-info-from-string text)))
            (unless *t-info* (set! *t-none* #t))))
        (when (and *t-info* (null? *t-fetches*))
          (set! *t-fetches* (map (lambda (n) (cons n (gles3-fetch-image (t-url n)))) (t-asset-names))))
        (unless *t-time*
          (set! *t-waited* (+ *t-waited* dt))
          (when (or (and *t-info* (t-fetched?)) *t-none* (> *t-waited* 10.0))
            (flow-title-start!)))
        ;; the room landed after the title started without it: in it goes
        (when (and *t-time* *t-bare* *t-info* (t-fetched?))
          (set! *t-bare* #f)
          (title-init! t-load-mesh* t-load-texture* *t-info*)
          (apply-params!)
          (display "phantom-burn: title room") (newline))
        (if *t-time*
            (begin
              (set! *t-time* (+ *t-time* dt))
              (title-frame! *t-time* (gles3-canvas-width) (gles3-canvas-height))
              (unless *said-ready*
                (set! *said-ready* #t)
                (display "phantom-burn: ready title") (newline))
              ;; the menu, after a moment (a press that ended the last game
              ;; does not skip the title): up/down (or W/S) move, any other
              ;; key starts the choice, a tap starts the item under it
              (when (> *t-time* 0.8) (menu-input!))
              (web-input-clear-pressed! *input*)
              (set! *tap* #f))
            (begin
              (web-input-clear-pressed! *input*)
              (begin-frame)
              (clear-screen 0.0 0.0 0.0)
              (end-frame)))))

    ;; What the start still waits for, for the load-failed line.
    (define (missing)
      (append (if *collide* '() '("collision"))
              (if (or (stand-in?) *info*) '() '("floor.sexp"))
              (let loop ((fs *fetches*))
                (cond ((null? fs) '())
                      ((gles3-image-ready? (cdar fs)) (loop (cdr fs)))
                      (else (cons (caar fs) (loop (cdr fs))))))))

    ;; Start the floor's info and fetches as soon as they can start (the
    ;; flow runs this behind its title, so play starts without a wait).
    (define (prefetch-game!)
      (when (and *params-seen* (not *info*) *info-text*)
        (let ((text *info-text*))
          (set! *info-text* #f)
          (set! *info* (guard (e (#t (display "phantom-burn: load failed: floor.sexp does not read") (newline) #f))
                         (floor-info-from-string text)))))
      (when (and *params-seen* (null? *fetches*) (or (stand-in?) *info*))
        (set! *fetches* (map (lambda (n) (cons n (gles3-fetch-image (url n)))) (asset-names)))))

    (define (web-tick* payload)
      ;; one attempt: a floor.sexp that does not read is said once
      (prefetch-game!)
      (gles3-resize-to-display)
      (let ((dt (frame-dt payload)))
        (cond ((eq? *started* #t)
               (let* ((look (web-input-take-look! *input*))
                      (move (web-input-stick *input* "move"))
                      (stick (web-input-stick *input* "look"))
                      (pressed (web-input-pressed *input*)))
                 (web-input-clear-pressed! *input*)
                 ;; a tap in play: the pause panel's rows, or dismissing Crash's transmission
                 (when (and *tap* (eq? *mode* 'game))
                   (play-mode-tap! (car *tap*) (cdr *tap*))
                   (set! *tap* #f))
                 (game-frame! dt (gles3-canvas-width) (gles3-canvas-height)
                              (make-controls held? pressed
                                             (car look) (cdr look)
                                             (car move) (cdr move)
                                             (car stick) (cdr stick)))
                 ;; the sound: P2's feed for this frame (steps, events, you, the guard)
                 (sound-game-frame! dt (game-walker))
                 (sound-traced!)
                 ;; PRACTICE finished: once, so the page remembers the player
                 ;; has practised (localStorage phantomburn.practiced)
                 (when (and (not *said-practiced*) (play-mode-practice-done?))
                   (set! *said-practiced* #t)
                   (display "phantom-burn: practice done") (newline))
                 ;; ready once the first frame is drawn (shots wait for this line)
                 (unless *said-ready*
                   (set! *said-ready* #t)
                   (display (string-append "phantom-burn: ready " *floor*)) (newline))))
              ((eq? *started* 'failed) #f)
              ((all-ready?) (start!))
              (else
               (sound-game-idle!)
               ;; a fetch that fails never becomes ready, and the bridge
               ;; cannot tell Sigil it failed: after 20 s, say what is missing
               (when *params-seen* (set! *waited* (+ *waited* dt)))
               (when (and (> *waited* 20.0) (not *said-stuck*))
                 (set! *said-stuck* #t)
                 (display (string-append "phantom-burn: load failed, still waiting for: "
                                         (apply string-append (map (lambda (n) (string-append n " ")) (missing)))))
                 (newline))
               (begin-frame)
               (clear-screen (/ 13 255) (/ 10 255) (/ 26 255))
               (end-frame)))))

    (define (web-main)
      (browser-save-ready!)
      (unless (gles3-use-canvas "#stage")
        (error "phantom-burn: no WebGL2 context for #stage"))
      (gles3-resize-to-display)
      (gfx-setup)
      (gles3-start-loop "phantom-burn-tick")
      0)

    (define (web-dispatch type payload)
      (cond ((string=? type "frame") (web-tick payload) 0)
            ((web-input-dispatch! *input* type payload)
             ;; Focus loss also discards a pending product menu tap.
             (when (string=? type "blur")
               (set! *tap* #f))
             0)
            ((string=? type "tap")
             (set! *tap* (web-input-pair payload))
             0)
            ;; the page: the pointer lock was lost in play (Escape): the pause panel
            ((string=? type "pause")
             (when (eq? *mode* 'game) (play-mode-pause!))
             0)
            ;; the page: a touch screen (the pause panel lists the phone's controls)
            ((string=? type "touch")
             (play-mode-set-touch! #t)
             0)
            ((string=? type "save-practice")
             (browser-practice-done!)
             0)
            ((string=? type "save-best")
             (browser-record-packet! payload)
             0)
            ((string=? type "params")
             ;; The shared page sends raw params first; Phantom sends them
             ;; again with flow/practice/best state. The second delivery wins
             ;; and must arrive last, before any floor data is dispatched.
             (set! *params* (legacy-query->params payload))
             (set! *params-seen* #t)
             ;; ?go=FLOOR (the menu's other floor, after a reload): straight to it
             (when (and (param "flow") (param "go")) (set! *mode* 'game) (display "phantom-burn: mode game") (newline))
             (when (param "floor") (set! *floor* (param "floor")))
             (unless (param "mute")
               (sound-game-init! tune-loader)
               ;; ?rate=24|28|32: the music's render rate in kHz (David's A/B; 28 by default, his pick)
               (let ((r (and (param "rate") (string->number (param "rate")))))
                 (when (and r (>= r 8) (<= r 48)) (sound-game-set-music-rate! (exact (round (* 1000 r)))))))
             0)
            ((string=? type "tune")
             (legacy-tune-provide! *tunes* payload)
             0)
            ((member type '("tune-begin" "tune-chunk" "tune-done" "tune-failed"))
             (tunes-dispatch! *tunes* type payload)
             0)
            ((string=? type "gesture")
             ;; a user gesture (the page sends pointerup, touchend, click, keydown):
             ;; a browser starts audio only inside one
             (sound-game-gesture!)
             0)
            ((string=? type "dpr")
             (render-set-dpr! (string->number payload))
             (render-spread-auto! (render-spread-auto?))
             0)
            ((string=? type "floor")
             ;; the page's own (sanitised) floor name, which it fetches by
             (set! *floor* payload)
             0)
            ((string=? type "floorinfo")
             (set! *info-text* payload)
             0)
            ((string=? type "nofloor")
             (set! *no-floor* #t)
             0)
            ((string=? type "collide")
             (set! *collide* payload)
             0)
            ((string=? type "playinfo")
             (set! *play-text* payload)
             0)
            ((string=? type "titleinfo")
             (set! *t-info-text* payload)
             0)
            ((string=? type "notitle")
             (set! *t-none* #t)
             0)
            ((string=? type "replay")
             (if (eq? *started* #t) (run-replay! payload) (set! *replay-text* payload))
             0)
            (else 0)))))
