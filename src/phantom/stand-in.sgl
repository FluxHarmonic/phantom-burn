;;; (phantom stand-in) - generated by scripts/stand-in.mjs from G0's export
;;; of the floor-14 slice (assets/stand-in/). Do not edit. The stand-in floor
;;; until the floor compiler's output lands.
(define-library (phantom stand-in)
  (import (sigil core))
  (export stand-in-draws stand-in-city-count stand-in-lights stand-in-views
          stand-in-surfaces stand-in-triangles)
  (begin
    ;; (first count texture-file-or-#f glass?): each textured material, then
    ;; the untextured ones merged into ranges, the glass (pane, rail) apart.
    (define stand-in-draws
      '((0 696 "tex-marble.png" #f)
        (696 828 "tex-wall.png" #f)
        (1524 1212 "tex-steel.png" #f)
        (2736 72 "tex-grate.png" #f)
        (2808 96 "tex-tile.png" #f)
        (2904 132 "tex-ceiling.png" #f)
        (3036 96 "tex-carpet.png" #f)
        (3132 108 "tex-laminate.png" #f)
        (3240 84 #f #f)
        (3324 72 #f #t)
        (3396 288 #f #f)
        (3684 108 #f #t)
        (3792 9912 #f #f)))
    (define stand-in-city-count 16344)
    ;; (x y z radius r g b circuit), design coordinates (z up)
    (define stand-in-lights
      '((3.0 2.0 6.0 13.247 1.28 1.4431 1.6 1.0)
        (3.0 5.0 6.0 13.247 1.28 1.4431 1.6 1.0)
        (7.0 2.0 6.0 13.247 1.28 1.4431 1.6 1.0)
        (7.0 5.0 6.0 13.247 1.28 1.4431 1.6 1.0)
        (12.8 6.0 6.0 11.6603 1.28 1.4431 1.6 1.0)
        (5.0 8.5 2.75 7.7434 1.28 1.4431 1.6 1.0)
        (16.5 8.5 2.8 7.7434 1.28 1.4431 1.6 1.0)
        (19.5 11.5 2.8 7.7434 1.28 1.4431 1.6 1.0)
        (18.0 15.0 2.7 8.9161 1.28 1.4431 1.6 0.0)
        (18.0 19.0 2.7 8.9161 1.28 1.4431 1.6 0.0)
        (20.5 17.0 2.7 8.9161 1.28 1.4431 1.6 0.0)
        (24.0 19.0 2.7 5.958 1.28 1.4431 1.6 2.0)
        (24.58 19.48 1.05 5.5 1.5184 0.7216 0.1631 2.0)
        (3.0 9.75 2.45 4.7321 1.6 0.9976 0.1631 3.0)))
    ;; (name x y z yaw pitch fov-y-degrees), design coordinates; yaw 0 faces
    ;; north (+y) and grows counter-clockwise seen from above
    (define stand-in-views
      '((arrival 1.3 1.3 1.6 -0.9749 0.057 61.5551)
        (overlook 4.2 9.3 4.6 -3.0624 -0.1013 56.1058)
        (office 20.5 12.2 1.6 0.1651 -0.0894 61.5551)))
    ;; the surface tags in floor14.collide
    (define stand-in-surfaces '(solid marble carpet tile grate glass))
    (define stand-in-triangles 1728)))
