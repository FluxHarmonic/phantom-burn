;;; (phantom sound) - The game's sound: footsteps, the guard, the hum, the events
;;;
;;; S1 (tasks/phantom-burn-s1-sound), from S0's sketchbook. What the game calls:
;;;
;;;   (make-sound rate loader [headless? [music]])   loader: (name) -> a tune's text
;;;                                          or #f ("event-KIND", and the music's name);
;;;                                          headless: no sink, sound-render! mixes
;;;                                          everything instead; music: a track's name,
;;;                                          default MUSIC-TUNE, False Identity (David
;;;                                          approved it for the game, 2026-09-26: "False
;;;                                          Identity is great"; the score is Codex's,
;;;                                          docs/music/false-identity-game.cts). #f: no music.
;;;   (sound-set-music! s name)  another track (or #f): the old player is closed first,
;;;                          never two at once; PRACTICE plays Heat Trace (David's split)
;;;   (sound-prepare! s)     a frame's slice (~BANK-IDLE-MS) of the bank's rendering, and nothing
;;;                          else (the title's frames, before play)
;;;   (sound-gesture! s)     every user gesture: the first starts the sound (opens
;;;                          the audio context and the streams; not headless), the
;;;                          rest resume the context if the browser suspended it
;;;   (sound-start! s)       the start alone
;;;   (sound-frame! s dt you guards [sounding])   once a frame; sounding: P3's devices
;;;       sounding ((id kind x y atten muffled? path-m level) ...): each camera pips
;;;               there, faster as its awareness (level) rises
;;;       you     (x y yaw moved surface speed crouched?)   moved: metres this frame;
;;;               surface: the floor's surface name (a symbol)
;;;       guards  ((x y moved state occluded?) ...)          state: 0..3 (CALM .. HUNTING);
;;;               occluded?: a wall between the guard and you
;;;   (sound-stop! s)
;;;   (sound-render! s out n)   headless: n stereo f32 frames of everything, mixed
;;;   (sound-trace s)           the ms each part spent since the last call:
;;;                             ((bank . ms) (sfx . ms) (music . ms) (bed . ms) (frames . n)), n the
;;;                             frames the sinks were given (the trace divides)
;;;
;;; How it sounds, and why (David's S0 bench, 2026-09-25: each motif player costs
;;; ~2 ms a frame on his phone even when silent):
;;;   - your steps, the guard's steps, the events and robot speak are SAMPLES from (phantom sound
;;;     bank), rendered once on one player, a slice of it each frame until done,
;;;     and mixed by (phantom sound mix): near-free per frame, positional per event;
;;;   - a guard through a wall plays the muffled sample (S0's finding: a per-step
;;;     choice is enough for footsteps). Released motif (0.7.0) cannot move a
;;;     sounding voice's cutoff; this needs nothing from it;
;;;   - at most ONE motif player, for the music track, rendered at MUSIC-RATE (the
;;;     sink upsamples: sigil-audio 0.13's rate:), its states (calm, aware, alert)
;;;     from the guards through (phantom sound sections); the hum and the room
;;;     air are a seamless 10 s loop rendered into the bank and played by the mixer
;;;     (1.86 ms a frame as a player).
;;; Floor 14's duct has no S0 sound: it plays the grate's metal at half gain
;;; (the leader's approval, 2026-09-25; David's call later).

(define-library (phantom sound)
  (import (sigil core)
          (sigil math)
          (sigil time)
          (sigil audio sink)
          (motif tune)
          (motif tune player)
          (phantom sound logic)
          (phantom sound bank)
          (phantom sound mix)
          (phantom sound sections))
  (export make-sound sound-start! sound-gesture! sound-prepare! sound-frame! sound-step! sound-event! sound-stop!
          sound-render! sound-trace sound-started? sound-bank sound-mixer sound-bed-mixer sound-last-events
          sound-section sound-music-playing? sound-set-music! sound-set-music-rate! music-lift MUSIC-RATE
          sound-set-bed! sound-bed sound-bed-loop sound-device-loops LOOP-S sound-bed-fill! sound-bed-playing
          sound-cue-plays pip-interval MUSIC-TUNE SURFACE-MAP)
  ;; On the web, one-shots play as the audio bridge's CUES: uploaded once, mixed
  ;; in the AudioWorklet (sigil-wasm-audio's load-audio-cue / play-audio-cue), so
  ;; a sounding step costs nothing per sample in Sigil (the mixer, per sample in
  ;; Sigil, cost ~3 ms a frame while walking: the S1 integration's probe). Natively
  ;; (sigil-audio 0.12.2 has no cues) and headless, the mixer plays them.
  (cond-expand
    (wasm (import (only (sigil browser audio-sink) load-audio-cue play-audio-cue)))
    (else))
  (cond-expand
    (wasm (begin
            (define CUES? #t)
            (define (cue-load bv) (load-audio-cue bv channels: 2))
            (define (cue-play c v p) (play-audio-cue c volume: v pan: p))))
    (else (begin
            (define CUES? #f)
            (define (cue-load bv) #f)
            (define (cue-play c v p) #f))))
  (begin
    (define MUSIC-TUNE "music-false-identity")   ; INFILTRATE's track (see make-sound)
    ;; the music renders at this rate and the sink upsamples (the phone budget:
    ;; False Identity costs ~0.8x at 24 kHz what it does at 32). David picked 28 kHz
    ;; after the A/B on his phone (2026-09-28: "a fine middle ground, they all worked
    ;; fine and sounded good"); ?rate=24|28|32 still switches it. At 24 kHz his phone
    ;; spent 1.13 ms a frame on the music at p95. Headless, the sound's own rate.
    (define MUSIC-RATE 28000)
    (define BANK-MS 3)                    ; the bank renders ~3 ms a frame of play until complete
    (define BANK-IDLE-MS 8)               ; and ~8 ms a frame before play (the title: nothing else runs)
    (define SFX-DEPTH-S 0.1)              ; the steps' sink stays shallow: heard ~0.1 s late
    (define MUSIC-DEPTH-S 0.35)
    (define BUFFER 32768)
    (define PUSH 1024)
    (define MUSIC-GAIN 0.7)
    (define BED-GAIN 1.0)                 ; the bed's level is in its tune (bank.sgl: David's "a drone in the air")
    (define GUARD-GAIN 0.9)
    (define GUARD-STRIDE-WALK 0.78)       ; the guard's walk (1.3 m/s) at a step every 0.6 s
    (define GUARD-STRIDE-HUNT 1.2)

    ;; the floor's surface names -> (bank surface . gain)
    (define SURFACE-MAP
      '((carpet carpet . 1.0) (tile tile . 1.0) (marble marble . 1.0) (grate grate . 1.0)
        (raised raised . 1.0) (duct grate . 0.5)))
    (define (surface-for name)
      (let ((e (assq name SURFACE-MAP))) (if e (cdr e) (cons 'tile 1.0))))

    ;; --- state ------------------------------------------------------------------------
    ;; #(rate loader headless? bank mixer you-steps guards music-rule seed
    ;;   ctx sfx-stream music-stream bed-started? music-player bed-mixer sections
    ;;   last-events costs started? steps-handed? listener music bed-stream bed-pos
    ;;   cues cue-plays cameras)
    ;; cameras: ((id . seconds-to-its-next-pip) ...), the cameras in the last feed
    ;; cues: ((key . cue) ...), each bank sample uploaded as a cue on its first play
    ;; (the web); cue-plays: how many one-shots went to the worklet so far
    ;; music: the track's name, or #f (no music: no player and no music stream)
    ;; steps-handed?: the game has called sound-step! (playback stops deriving
    ;; your steps); listener: (x y yaw) from the last frame, for placed events
    ;; The bed (the hum and the room air) is a loop in bed-mixer, from the bank
    ;; (bank-bed-loop), started once the bed's stage is done: no player of its own.
    ;; Live, the loop is copied natively into its own stereo stream (bed-stream, at
    ;; BED-GAIN as the stream's volume; bed-pos its place in the loop): mixing it
    ;; in per sample cost more than everything else (the S1 integration's trace);
    ;; the bed-mixer is the headless render's.

    ;; guards: a vector per guard index: #(steps prev-state mutter-in), mutter-in the
    ;; seconds to its next bored mutter while it is calm, #f otherwise
    (define (make-sound rate loader . opt)
      (vector rate loader (and (pair? opt) (car opt)) (make-bank rate loader) (make-mixer) (make-steps)
              '() (make-music-rule) 20260925
              #f #f #f #f #f (make-mixer) #f
              '() (list (cons 'bank 0.0) (cons 'sfx 0.0) (cons 'music 0.0) (cons 'bed 0.0) (cons 'frames 0)) #f #f (list 0.0 0.0 0.0)
              (if (and (pair? opt) (pair? (cdr opt))) (cadr opt) MUSIC-TUNE)
              #f 0 '() 0 '() 1.0 MUSIC-RATE 'floor '() #f))

    ;; Which bed plays (slot 29): floor, the building's hum and air, or sim,
    ;; PRACTICE's air (the bank's bed-sim, once rendered; the hum until then),
    ;; or dark (Phantom 0.1): the building's bed with your room's lights off, no
    ;; tube buzz. The loops are the same length, so the bed's place carries
    ;; over; the stream crossfades a switch (slot 31: the loop it last played).
    (define (sound-set-bed! s which) (vector-set! s 29 which))
    (define (sound-bed s) (vector-ref s 29))
    (define (sound-bed-loop s) (bed-loop s))
    (define (bed-loop s)
      (let ((alt (case (vector-ref s 29)
                   ((sim) (bank-sim-bed-loop (sound-bank s)))
                   ((dark) (bank-dark-bed-loop (sound-bank s)))
                   (else #f))))
        (or alt (bank-bed-loop (sound-bank s)))))

    (define (sound-music-playing? s) (and (vector-ref s 13) #t))

    (define (sound-bed-mixer s) (vector-ref s 14))

    (define (s-rate s) (vector-ref s 0))
    (define (sound-bank s) (vector-ref s 3))
    (define (sound-mixer s) (vector-ref s 4))
    (define (sound-started? s) (vector-ref s 18))
    (define (sound-last-events s) (vector-ref s 16))
    (define (sound-section s) (let ((sec (vector-ref s 15))) (if sec (sections-playing sec) 'none)))

    ;; MINSTD for the variations (a step's sample and a little of its gain)
    (define (rand! s)
      (let ((n (modulo (* 48271 (vector-ref s 8)) 2147483647)))
        (vector-set! s 8 n)
        (/ n 2147483647.0)))

    (define (cost! s part ms)
      (let ((e (assq part (vector-ref s 17)))) (set-cdr! e (+ (cdr e) ms))))

    ;; --- start and stop -------------------------------------------------------------------
    ;; the music's player, once its text has arrived (on the web the page
    ;; fetches the tunes, so it may come after the start); none without a track
    ;; the music's rate: ?rate on the web (sound-set-music-rate!), MUSIC-RATE by default;
    ;; headless, the sound's own (the tests mix it in without resampling)
    (define (music-rate s) (if (vector-ref s 2) (s-rate s) (vector-ref s 28)))

    (define (open-players! s)
      (let* ((name (vector-ref s 21))
             (text (and name (not (vector-ref s 13)) ((vector-ref s 1) name))))
        (when text
          (let ((p (open-tune-player (read-tune-string text) (music-rate s) loop: #t))
                (routes (track-routes name)))
            (vector-set! s 13 p)
            (vector-set! s 15 (and routes (make-sections p routes (music-rate s))))))))

    (define (close-players! s)
      (let ((p (vector-ref s 13))) (when p (player-close! p)))
      (vector-set! s 13 #f)
      (vector-set! s 15 #f))

    ;; another track, or #f: the old player closed first (never two), the new
    ;; one opened now if the sound has started (else at the start), in calm
    (define (sound-set-music! s name)
      (unless (equal? name (vector-ref s 21))
        (close-players! s)
        (vector-set! s 21 name)
        (when (sound-started? s)
          (open-players! s)
          (unless (vector-ref s 2)
            (when (and name (not (vector-ref s 11)))
              (vector-set! s 11 (open-music-stream s)))))))

    ;; the music's render rate (?rate=24|28|32 on the web: David A/Bs the lo-fi):
    ;; a player already open is reopened at the new rate, in calm, and the
    ;; stream told (the sink upsamples whatever it is fed)
    (define (sound-set-music-rate! s hz)
      (unless (= hz (vector-ref s 28))
        (vector-set! s 28 hz)
        (when (vector-ref s 13)
          (close-players! s)
          (open-players! s))
        (let ((st (vector-ref s 11)))
          (when st (guard (e (#t #f)) (set-audio-stream-rate! st hz))))))

    (define (open-stream)
      (guard (e (#t #f)) (open-audio-stream channels: 2 buffer-frames: BUFFER)))
    (define (open-music-stream s)
      (guard (e (#t #f)) (open-audio-stream channels: 2 buffer-frames: BUFFER volume: MUSIC-GAIN rate: (music-rate s))))

    (define (sound-start! s)
      (unless (sound-started? s)
        (open-players! s)
        (unless (vector-ref s 2)
          ;; one context for the sound's life: a stop closes the streams, not it
          (unless (vector-ref s 9)
            (vector-set! s 9 (guard (e (#t #f)) (audio-context-open))))
          (let ((ctx (vector-ref s 9)))
            (when ctx (guard (e (#t #f)) (audio-context-resume ctx))))
          (vector-set! s 10 (open-stream))
          (vector-set! s 22 (guard (e (#t #f)) (open-audio-stream channels: 2 buffer-frames: BUFFER volume: BED-GAIN)))
          (when (vector-ref s 21)
            (vector-set! s 11 (open-music-stream s))))
        (vector-set! s 18 #t)))

    ;; a user gesture: start, or resume a context the browser suspended
    (define (sound-gesture! s)
      (if (sound-started? s)
          (let ((ctx (vector-ref s 9)))
            (when (and ctx (not (eq? (guard (e (#t #f)) (audio-context-state ctx)) 'running)))
              (guard (e (#t #f)) (audio-context-resume ctx))))
          (sound-start! s)))

    ;; the bank's slice of a frame: ~BANK-IDLE-MS before play (the title's
    ;; frames, sound-prepare! s), ~BANK-MS during it (sound-frame!)
    (define (bank-slice! s ms)
      (unless (bank-ready? (sound-bank s))
        (let ((t0 (current-milliseconds)))
          (bank-render-for! (sound-bank s) ms)
          (cost! s (quote bank) (- (current-milliseconds) t0)))))
    (define (sound-prepare! s) (bank-slice! s BANK-IDLE-MS))

    (define (sound-stop! s)
      (for-each (lambda (i) (let ((st (vector-ref s i))) (when st (guard (e (#t #f)) (set-audio-stream-volume! st 0.0)) (guard (e (#t #f)) (close-audio-stream! st))) (vector-set! s i #f)))
                '(10 11 22))
      (vector-set! s 23 0)
      (vector-set! s 27 1.0)                ; the alert lift: a new music stream starts level
      (let ((p (vector-ref s 13))) (when p (player-close! p)) (vector-set! s 13 #f))
      (vector-set! s 12 #f)
      (vector-set! s 14 (make-mixer))
      (vector-set! s 15 #f)
      (vector-set! s 18 #f))

    ;; --- a frame --------------------------------------------------------------------------------
    ;; a one-shot under MIN-GAIN (-50 dB: a far guard's step) is not mixed at all
    (define MIN-GAIN 0.003)
    (define (play! s key gain pan)
      (let ((sample (and (>= gain MIN-GAIN) (bank-sample (sound-bank s) key))))
        (when sample
          (unless (cue-played! s key sample gain pan)
            (mixer-play! (sound-mixer s) sample gain pan 2))
          (vector-set! s 16 (cons (list key gain pan) (vector-ref s 16))))))

    (define (sound-cue-plays s) (vector-ref s 25))

    ;; the web, once the sound is started: the sample as a cue (uploaded on its
    ;; first play), at our gains: pan-gains is equal power (1 a side at the
    ;; centre), the worklet's cue pan a balance (left = vol x (1 - pan) for pan > 0,
    ;; right = vol x (1 + pan) for pan < 0), so vol is the louder side and the pan
    ;; the quieter side's share of it; the same two gains exactly, but vol is
    ;; capped at 1 (a near, hard-panned, loud step plays a little quieter). #f when
    ;; there are no cues (natively, headless, or refused): the mixer plays it.
    (define (cue-played! s key sample gain pan)
      (and CUES? (not (vector-ref s 2)) (sound-started? s)
           (let* ((e (assoc key (vector-ref s 24)))
                  (cue (if e (cdr e)
                           (let ((c (cue-load sample)))
                             (when c (vector-set! s 24 (cons (cons key c) (vector-ref s 24))))
                             c))))
             (and cue
                  (let* ((g (pan-gains pan)) (l (* gain (car g))) (r (* gain (cdr g)))
                         (v (max l r))
                         (p (cond ((<= v 0.0) 0.0) ((>= r l) (- 1.0 (/ l r))) (else (- (- 1.0 (/ r l)))))))
                    (and (cue-play cue (min 1.0 v) p)
                         (begin (vector-set! s 25 (+ 1 (vector-ref s 25))) #t)))))))

    (define (guard-entry s i)
      (let loop ((gs (vector-ref s 6)))
        (cond ((null? gs) (let ((e (vector (make-steps) 0 #f))) (vector-set! s 6 (append (vector-ref s 6) (list (cons i e)))) e))
              ((= (car (car gs)) i) (cdr (car gs)))
              (else (loop (cdr gs))))))

    ;; (gain . pan) for a sound at (x, y) from the last listener: the path's gain
    ;; (atten, from the game's sector graph: no distance in it) times 2/d, d the
    ;; walked path length when the game gives one, else the straight line; the
    ;; pan on the straight line (the agreed API, topics/phantom-sound-api)
    (define (placed s x y atten path-m)
      (let* ((l (vector-ref s 20))
             (sp (sound-space x y (car l) (cadr l) (caddr l)))
             (dist-gain (if path-m (if (<= path-m 2.0) 1.0 (/ 2.0 path-m)) (car sp))))
        (cons (* atten dist-gain) (cdr sp))))

    ;; one of your steps: surface (bank surface) at its gain, heel or toe
    (define (step! s surface surface-gain gait foot)
      (let* ((k (if (eq? foot 'heel) (min 2 (exact (floor (* 3 (rand! s))))) (min 1 (exact (floor (* 2 (rand! s)))))))
             (g (* surface-gain (if (eq? foot 'heel) (gait-heel gait) (gait-toe gait)) (+ 0.9 (* 0.2 (rand! s))))))
        (play! s (list 'step surface foot k) g 0.0)))

    ;; YOUR step, timed by the game ((phantom sound logic)'s steps-advance! on
    ;; its tick): surface a floor surface name, gait sneak|walk|run, foot heel|toe.
    ;; The first call switches playback's own derivation off for good.
    (define (sound-step! s surface gait foot)
      (vector-set! s 19 #t)
      (let ((sf (surface-for surface)))
        (step! s (car sf) (cdr sf) gait foot)))

    ;; a placed one-shot the game fires (door-open door-close panel-on panel-off
    ;; reader-ok reader-deny badge caught note): the bank's (event KIND) sample (the tune David approved,
    ;; assets/tunes/event-KIND.cts), its muffled variant (event KIND muffled) when there is one
    ;; (none yet: a muffled event plays the clear one at atten); a kind not rendered
    ;; yet, or unknown, is silence (the game may fire it before its sound exists)
    (define (sound-event! s kind x y atten muffled?)
      (let* ((sp (placed s x y atten #f))
             (bank (sound-bank s))
             (mood (assq kind SPEAK-MOODS)))
        (if mood
            ;; robot speak (API v9): one of the mood's three variants, at random
            (play! s (speak-key s (cdr mood)) (* SPEAK-GAIN (car sp)) (cdr sp))
            (let ((key (or (and muffled? (bank-sample bank (list 'event kind 'muffled)) (list 'event kind 'muffled))
                           (list 'event kind))))
              (play! s key (car sp) (cdr sp))))))

    ;; --- robot speak (David picked EDGE, 2026-09-26: "go with EDGE for the robot
    ;; voice, this is more what I had in mind") ---------------------------------------------
    ;; The unit's state changes come as sound events (API v9); each plays one of its
    ;; mood's three variants at random, at the unit (event speak-MOOD-K, the tunes
    ;; the sketchbook's (sketchbook robotspeak) makes for the game: EDGE, the phrase at
    ;; once). The bored mutter is the sound side's: a calm unit mutters every 20-40 s.
    (define SPEAK-MOODS
      '((robot-suspicious . suspicious) (robot-searching . searching) (robot-there . there)
        (robot-lost . lost) (robot-back . settle)))
    (define SPEAK-GAIN 0.9)
    (define MUTTER-MIN-S 20.0)
    (define MUTTER-MAX-S 40.0)

    ;; one of the mood's three variants, at random; the first while the one drawn
    ;; is not rendered yet (the bank renders every mood's first variant before
    ;; the bed, the other two after it)
    (define (speak-key s mood)
      (let* ((k (+ 1 (min 2 (exact (floor (* 3 (rand! s)))))))
             (key (lambda (k) (list 'event (string->symbol (string-append "speak-" (symbol->string mood) "-"
                                                                          (number->string k))))))
             (drawn (key k)))
        (if (bank-sample (sound-bank s) drawn) drawn (key 1))))

    (define (mutter-wait s) (+ MUTTER-MIN-S (* (- MUTTER-MAX-S MUTTER-MIN-S) (rand! s))))

    ;; a guard entry's mutter, once a frame: calm (state 0) counts down and mutters
    ;; at its place; any other state clears the count (it starts again when calm)
    (define (mutter! s e state sp dt)
      (if (= state 0)
          (let ((left (- (or (vector-ref e 2) (mutter-wait s)) dt)))
            (if (> left 0.0)
                (vector-set! e 2 left)
                (begin
                  (play! s (speak-key s 'bored) (* SPEAK-GAIN (car sp)) (cdr sp))
                  (vector-set! e 2 (mutter-wait s)))))
          (vector-set! e 2 #f)))

    ;; --- the cameras (P3; David: "a soft beeping ... a specific noise pattern"; he
    ;; picked pip B, the relay's double tick) ---------------------------------------------
    ;; Each camera in the feed's sounding list (API v8: (id camera x y atten muffled?
    ;; path-m level), level its awareness 0..1) pips where it is, every
    ;; (pip-interval level) seconds: 2 s while it only watches, closing in
    ;; Geiger-style to 0.12 s as it becomes sure; camera-alert (a sound event) is
    ;; the confirmed moment. A camera no longer in the list stops at once.
    (define PIP-SLOW 2.0)
    (define PIP-FAST 0.12)
    (define PIP-GAIN 0.8)
    (define (pip-interval level)
      (* PIP-SLOW (expt (/ PIP-FAST PIP-SLOW) (max 0.0 (min 1.0 (or level 0.0))))))

    (define (cameras! s dt sounding)
      (let ((cams (filter (lambda (e) (eq? (list-ref e 1) 'camera)) sounding)))
        (vector-set! s 26
          (map (lambda (c)
                 (let* ((id (list-ref c 0))
                        (level (and (> (length c) 7) (list-ref c 7)))
                        (iv (pip-interval level))
                        (old (assoc id (vector-ref s 26)))
                        ;; a camera first seen pips within its interval, not at once
                        (left (- (if old (cdr old) (* iv (rand! s))) dt)))
                   (if (> left 0.0)
                       (cons id (min left iv))       ; a rising level shortens the wait
                       (let ((sp (placed s (list-ref c 2) (list-ref c 3) (list-ref c 4) (list-ref c 6))))
                         (play! s '(event camera-pip) (* PIP-GAIN (car sp)) (cdr sp))
                         (cons id (+ left iv))))))
               cams))))

    ;; The devices' loops (Phantom 0.1): a phone ringing, the printer running,
    ;; the vent on, each in the feed's sounding list (API v8) while it sounds.
    ;; A loop is one LOOP-S cycle banked as an event (s0's sketchbook loops),
    ;; played as a placed one-shot at once and again every LOOP-S while its
    ;; device stays in the list: the web's cues and the native mixer play it like
    ;; any one-shot, so a loop costs no more than a step. A device that leaves the
    ;; list is not played again (its cycle already playing finishes). Slot 30:
    ;; ((id . seconds-to-its-next-cycle) ...).
    (define LOOP-S 3.0)
    ;; each loop's gain: the printer's loop is paper ticks and a low motor
    ;; (RMS 0.027 against the phone's 0.046), and under the music it went
    ;; unheard (David, 2026-09-28: "the printer did not make a noise"); +6 dB
    ;; puts it a little above the phone's ring where you command it from
    (define (device-gain kind) (case kind ((printer) 2.0) (else 1.0)))
    (define (device-loop-key kind)
      (case kind
        ((phone) '(event device-phone-ring))
        ((printer) '(event device-printer))
        ((vent) '(event device-vent))
        ((fridge) '(event device-fridge))     ; not a device: the floor's hums (play-sounding)
        ((vacuum) '(event device-vacuum))     ; the night cleaner's (play-sounding)
        (else #f)))
    (define (devices! s dt sounding)
      (let ((ds (filter (lambda (e) (device-loop-key (list-ref e 1))) sounding)))
        (vector-set! s 30
          (map (lambda (d)
                 (let* ((id (list-ref d 0))
                        (old (assoc id (vector-ref s 30)))
                        (left (- (if old (cdr old) 0.0) dt)))
                   (if (> left 0.0)
                       (cons id left)
                       (let ((sp (placed s (list-ref d 2) (list-ref d 3) (list-ref d 4) (list-ref d 6))))
                         (play! s (device-loop-key (list-ref d 1)) (* (device-gain (list-ref d 1)) (car sp)) (cdr sp))
                         (cons id (+ left LOOP-S))))))
               ds))))
    (define (sound-device-loops s) (vector-ref s 30))

    (define (sound-frame! s dt you guards . more)
      (vector-set! s 16 '())
      ;; the bank renders ~BANK-MS a frame until it is complete (the title's
      ;; frames can do it before play); the bed's loop starts, once, when its stage is done
      (bank-slice! s BANK-MS)
      (when (sound-started? s) (open-players! s))
      (when (and (sound-started? s) (bank-bed-loop (sound-bank s)) (not (vector-ref s 12)))
        (mixer-loop! (sound-bed-mixer s) (bank-bed-loop (sound-bank s)) BED-GAIN 2)
        (vector-set! s 12 #t))
      (let* ((lx (list-ref you 0)) (ly (list-ref you 1)) (yaw (list-ref you 2)))
        (vector-set! s 20 (list lx ly yaw))
        ;; your steps, derived here only until the game hands them over
        ;; (sound-step!), and only from a 7-field `you`
        (when (and (not (vector-ref s 19)) (>= (length you) 7))
          (let ((surface (surface-for (list-ref you 4)))
                (gait (gait-for (list-ref you 5) (list-ref you 6))))
            (for-each (lambda (ev) (step! s (car surface) (cdr surface) gait (car ev)))
                      (steps-advance! (vector-ref s 5) (list-ref you 3) dt (car surface) gait))))
        ;; the guards: their steps positioned, the path's gain, a wall muffling them, their
        ;; mutter; no music stings (the leader, 2026-09-26: the robot's own voice, the
        ;; v9 events, carries the "?" and THERE moments now; doubling muddied both)
        (let loop ((gs guards) (i 0) (states '()))
          (if (null? gs)
              (let ((sec (vector-ref s 15)))
                ;; the music: the most aware guard's state, no timer of our own
                (when sec
                  (sections-want! sec (desire-from-states states))
                  (sections-tick! sec))
                (music-lift! s dt))
              (let* ((g (car gs)) (e (guard-entry s i))
                     (gx (list-ref g 0)) (gy (list-ref g 1)) (gmoved (list-ref g 2))
                     (state (list-ref g 3))
                     (atten (if (> (length g) 4) (list-ref g 4) 1.0))
                     (muffled? (and (> (length g) 5) (list-ref g 5)))
                     (path-m (and (> (length g) 6) (list-ref g 6)))
                     (sp (placed s gx gy atten path-m))
                     (stride (if (>= state 3) GUARD-STRIDE-HUNT GUARD-STRIDE-WALK)))
                (for-each
                  (lambda (ev)
                    (when (eq? (car ev) 'heel)
                      (play! s (list 'guard (if muffled? 'muffled 'clear) (min 2 (exact (floor (* 3 (rand! s))))))
                             (* GUARD-GAIN (car sp) (+ 0.9 (* 0.2 (rand! s)))) (cdr sp))))
                  (steps-advance! (vector-ref e 0) (* gmoved (/ 1.248 stride)) dt 'guard 'walk))
                (mutter! s e state sp dt)
                (vector-set! e 1 state)
                (loop (cdr gs) (+ i 1) (cons state states))))))
      ;; the devices sounding (P3): the cameras' pips
      (cameras! s dt (if (pair? more) (car more) '()))
      (devices! s dt (if (pair? more) (car more) '()))
      (unless (vector-ref s 2) (pump! s)))

    ;; --- the sinks ------------------------------------------------------------------------------
    (define *buf* (make-bytevector (* 8 PUSH) 0))

    (define (pump-stream! s st depth-s fill part . rate)
      (when st
        (let loop ()
          (let* ((depth (audio-stream-depth st))
                 (want (exact (floor (* depth-s (if (pair? rate) (car rate) (s-rate s))))))
                 (n (min PUSH (audio-stream-room st) (- want depth))))
            (when (> n 0)
              (let ((t0 (current-milliseconds)))
                (fill *buf* n)
                (push-audio-samples st *buf* n)
                (cost! s part (- (current-milliseconds) t0))
                (when (eq? part (quote sfx)) (cost! s (quote frames) n)))
              (loop))))))

    ;; tmp += g x src, n stereo frames
    (define (add-into! out src n g)
      (let add ((i 0))
        (when (< i (* 2 n))
          (bytevector-ieee-single-set! out (* 4 i)
                                       (+ (bytevector-ieee-single-ref out (* 4 i) 'little)
                                          (* g (bytevector-ieee-single-ref src (* 4 i) 'little)))
                                       'little)
          (add (+ i 1)))))

    ;; the bed's stereo stream: n frames of the loop from bed-pos, copied
    ;; (wrapping). When the bed has switched since the last fill, its first
    ;; BED-SWITCH-S crossfade from the loop it was playing, at the same place
    ;; (the lights going out: the buzz fades instead of clicking off).
    (define BED-SWITCH-S 0.05)
    (define (bed-fill! s b n)
      (let* ((l (bed-loop s)) (was (vector-ref s 31))
             (start (vector-ref s 23)))
        (let loop ((at 0))
          (when (< at n)
            (let* ((len (quotient (bytevector-length l) 8))
                   (pos (if (>= (vector-ref s 23) len) 0 (vector-ref s 23)))
                   (k (min (- n at) (- len pos))))
              (bytevector-copy! b (* 8 at) l (* 8 pos) (* 8 (+ pos k)))
              (vector-set! s 23 (+ pos k))
              (loop (+ at k)))))
        (when (and was (not (eq? was l)) (= (bytevector-length was) (bytevector-length l)))
          (let* ((len (quotient (bytevector-length l) 8))
                 (xf (min n (exact (round (* BED-SWITCH-S (vector-ref s 0)))))))
            (let mix ((i 0))
              (when (< i xf)
                (let ((t (/ (+ i 0.5) xf))
                      (src (* 8 (modulo (+ (if (>= start len) 0 start) i) len))))
                  (let ch ((c 0))
                    (when (< c 2)
                      (bytevector-ieee-single-set!
                       b (+ (* 8 i) (* 4 c))
                       (+ (* (- 1.0 t) (bytevector-ieee-single-ref was (+ src (* 4 c)) 'little))
                          (* t (bytevector-ieee-single-ref b (+ (* 8 i) (* 4 c)) 'little)))
                       'little)
                      (ch (+ c 1)))))
                (mix (+ i 1))))))
        (vector-set! s 31 l)))
    (define (sound-bed-playing s) (vector-ref s 31))
    ;; for the tests: the bed's stream, n frames into b
    (define (sound-bed-fill! s b n) (bed-fill! s b n))

    (define (pump! s)
      ;; the steps' stream: the one-shots (zeroed natively when none sounds)
      (pump-stream! s (vector-ref s 10) SFX-DEPTH-S (lambda (b n) (mixer-render! (sound-mixer s) b n)) 'sfx)
      ;; the bed's own mono stream, once its loop is rendered
      (when (bank-bed-loop (sound-bank s))
        (pump-stream! s (vector-ref s 22) SFX-DEPTH-S (lambda (b n) (bed-fill! s b n)) 'bed))
      (when (vector-ref s 13)
        (pump-stream! s (vector-ref s 11) MUSIC-DEPTH-S (lambda (b n) (music-pull! s b n)) 'music
                      (music-rate s))))

    ;; the music's n frames: through the controller (a pickup cuts in on the beat),
    ;; or the player alone for a track without routes
    (define (music-pull! s b n)
      (let ((sec (vector-ref s 15)))
        (if sec (sections-pull! sec b n) (player-pull! (vector-ref s 13) b 0 n))))

    ;; THE ALERT LIFT (David, 2026-09-26: yes): the music's gain rises MUSIC-LIFT-DB
    ;; while the walk is headed for alert (the detected pickup, alert itself), over
    ;; LIFT-IN-S, and falls back over LIFT-OUT-S once it heads anywhere else (the
    ;; release is slow). On the stream's volume live; in the headless mix otherwise.
    (define MUSIC-LIFT-DB 3.5)
    (define LIFT-IN-S 0.5)
    (define LIFT-OUT-S 2.5)
    (define (music-lift s) (vector-ref s 27))
    (define (music-lift! s dt)
      (let* ((sec (vector-ref s 15))
             (top (expt 10.0 (/ MUSIC-LIFT-DB 20.0)))
             (target (if (and sec (eq? (sections-headed sec) 'alert)) top 1.0))
             (now (vector-ref s 27))
             (step (* dt (/ (- top 1.0) (if (> target now) LIFT-IN-S LIFT-OUT-S))))
             (next (if (> target now) (min target (+ now step)) (max target (- now step)))))
        (unless (= next now)
          (vector-set! s 27 next)
          (let ((st (vector-ref s 11)))
            (when st (set-audio-stream-volume! st (* MUSIC-GAIN next)))))))

    ;; headless: n frames of everything mixed (the music at its stream gain)
    (define (sound-render! s out n)
      (let ((tmp (make-bytevector (* 8 n) 0)))
        (mixer-render! (sound-mixer s) out n)
        (mixer-render! (sound-bed-mixer s) tmp n)
        (add-into! out tmp n 1.0)
        (when (vector-ref s 13)
          (music-pull! s tmp n)
          (add-into! out tmp n (* MUSIC-GAIN (music-lift s))))))

    ;; since the last call: (part . ms-spent) for each part, and (frames . n), the
    ;; frames given to the steps' sink: ms per second of audio is ms / (n / rate)
    ;; (the bank renders only while it is filling)
    (define (sound-trace s)
      (let ((c (vector-ref s 17)))
        (vector-set! s 17 (list (cons 'bank 0.0) (cons 'sfx 0.0) (cons 'music 0.0) (cons 'bed 0.0) (cons 'frames 0)))
        c))))
