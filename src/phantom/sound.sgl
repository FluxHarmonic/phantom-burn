;;; (phantom sound) - The game's sound: footsteps, the guard, the hum, the music
;;;
;;; S1 (tasks/phantom-burn-s1-sound), from S0's sketchbook. What the game calls:
;;;
;;;   (make-sound rate loader [headless?])   loader: (name) -> a tune's text or #f
;;;                                          ("track-low-embers"); headless: no sink,
;;;                                          sound-render! mixes everything instead
;;;   (sound-start! s)       on the first user gesture (the title's start press):
;;;                          opens the audio context and the streams (not headless)
;;;   (sound-frame! s dt you guards)          once a frame
;;;       you     (x y yaw moved surface speed crouched?)   moved: metres this frame;
;;;               surface: the floor's surface name (a symbol)
;;;       guards  ((x y moved state occluded?) ...)          state: 0..3 (CALM .. HUNTING);
;;;               occluded?: a wall between the guard and you
;;;   (sound-stop! s)
;;;   (sound-render! s out n)   headless: n stereo f32 frames of everything, mixed
;;;   (sound-trace s)           the ms each part spent since the last call:
;;;                             ((bank . ms) (sfx . ms) (music . ms) (bed . ms) (frames . n)), n the
;;;                             frames the sinks were given (the trace divides)
;;;
;;; How it sounds, and why (David's S0 bench, 2026-09-25: each motif player costs
;;; ~2 ms a frame on his phone even when silent):
;;;   - your steps, the guard's steps and the stings are SAMPLES from (phantom sound
;;;     bank), rendered once on one player, a slice of it each frame until done,
;;;     and mixed by (phantom sound mix): near-free per frame, positional per event;
;;;   - a guard through a wall plays the muffled sample (S0's finding: a per-step
;;;     choice is enough for footsteps). Released motif (0.7.0) cannot move a
;;;     sounding voice's cutoff; this needs nothing from it;
;;;   - motif players only for the music (Low Embers, its sections from the guards
;;;     by (phantom sound logic)) and a two-voice hum bed, no reverb.
;;; Floor 14's duct has no S0 sound: it plays the grate's metal at half gain
;;; (the leader's approval, 2026-09-25; David's call later).

(define-library (phantom sound)
  (import (sigil core)
          (sigil math)
          (sigil time)
          (sigil audio sink)
          (motif tune)
          (motif tune player)
          (phantom sound logic)
          (phantom sound bank)
          (phantom sound mix)
          (phantom sound sections))
  (export make-sound sound-start! sound-frame! sound-stop! sound-render! sound-trace
          sound-started? sound-bank sound-mixer sound-last-events sound-section
          BED-TUNE-TEXT MUSIC-TUNE SURFACE-MAP)
  (begin
    (define MUSIC-TUNE "track-low-embers")
    (define BANK-FRAMES-PER-FRAME 4096)   ; the bank renders over ~a second at 60 fps
    (define SFX-DEPTH-S 0.1)              ; the steps' sink stays shallow: heard ~0.1 s late
    (define MUSIC-DEPTH-S 0.35)
    (define BUFFER 32768)
    (define PUSH 1024)
    (define MUSIC-GAIN 0.7)
    (define BED-GAIN 0.8)
    (define GUARD-GAIN 0.9)
    (define GUARD-STRIDE-WALK 0.78)       ; the guard's walk (1.3 m/s) at a step every 0.6 s
    (define GUARD-STRIDE-HUNT 1.2)

    ;; the floor's surface names -> (bank surface . gain)
    (define SURFACE-MAP
      '((carpet carpet . 1.0) (tile tile . 1.0) (marble marble . 1.0) (grate grate . 1.0)
        (raised raised . 1.0) (duct grate . 0.5)))
    (define (surface-for name)
      (let ((e (assq name SURFACE-MAP))) (if e (cdr e) (cons 'tile 1.0))))

    ;; the in-game bed: the tube buzz and the room air of the sketchbook's floor, no reverb
    (define BED-TUNE-TEXT
      "(tune version: 1 name: \"phantom bed\" tempo: 150 speed: 3 channels: 2
  (instruments
    (instrument id: 1 name: \"tube buzz\" patch: (drone-saw attack: 1 breath-lo: 0.8 breath-rate: 0.2 bright: 24 cents: -49.4 detune: 2 excite: 1 excite-drive: 4 excite-freq: 800 level: 0.3 release: 2 seed: 41) volume: 20 gain: 2)
    (instrument id: 2 name: \"room air\" patch: (noise-bed attack: 3 centre: 1200 color: pink hp: 320 level: 1 lp: 5000 rate: 0.02 release: 4 seed: 31 wander: 0.1 width: 1.7) volume: 8 gain: 2))
  (patterns
    (pattern id: 0 rows: 16
      (row 0 (1 \"B-2\" 1 20 \"000\") (2 \"C-4\" 2 8 \"000\")))
    (pattern id: 1 rows: 256
      (row 255 (2 \"...\" 0 0 \"B01\"))))
  (order 0 1))")

    ;; --- state ------------------------------------------------------------------------
    ;; #(rate loader headless? bank mixer you-steps guards music-rule seed
    ;;   ctx sfx-stream music-stream bed-stream music-player bed-player sections
    ;;   last-events costs started?)
    ;; guards: a vector per guard index: #(steps prev-state)
    (define (make-sound rate loader . opt)
      (vector rate loader (and (pair? opt) (car opt)) (make-bank rate) (make-mixer) (make-steps)
              '() (make-music-rule) 20260925
              #f #f #f #f #f #f #f
              '() (list (cons 'bank 0.0) (cons 'sfx 0.0) (cons 'music 0.0) (cons 'bed 0.0) (cons 'frames 0)) #f))

    (define (s-rate s) (vector-ref s 0))
    (define (sound-bank s) (vector-ref s 3))
    (define (sound-mixer s) (vector-ref s 4))
    (define (sound-started? s) (vector-ref s 18))
    (define (sound-last-events s) (vector-ref s 16))
    (define (sound-section s) (let ((sec (vector-ref s 15))) (if sec (sections-playing sec) 'none)))

    ;; MINSTD for the variations (a step's sample and a little of its gain)
    (define (rand! s)
      (let ((n (modulo (* 48271 (vector-ref s 8)) 2147483647)))
        (vector-set! s 8 n)
        (/ n 2147483647.0)))

    (define (cost! s part ms)
      (let ((e (assq part (vector-ref s 17)))) (set-cdr! e (+ (cdr e) ms))))

    ;; --- start and stop -------------------------------------------------------------------
    (define (open-players! s)
      (let ((text ((vector-ref s 1) MUSIC-TUNE)))
        (when text
          (let ((p (open-tune-player (read-tune-string text) (s-rate s) loop: #t)))
            (vector-set! s 13 p)
            (vector-set! s 15 (make-sections p)))))
      (vector-set! s 14 (open-tune-player (read-tune-string BED-TUNE-TEXT) (s-rate s) loop: #t)))

    (define (sound-start! s)
      (unless (sound-started? s)
        (open-players! s)
        (unless (vector-ref s 2)
          (let ((ctx (guard (e (#t #f)) (audio-context-open))))
            (vector-set! s 9 ctx)
            (when ctx (guard (e (#t #f)) (audio-context-resume ctx)))
            (let ((open (lambda () (guard (e (#t #f)) (open-audio-stream channels: 2 buffer-frames: BUFFER)))))
              (vector-set! s 10 (open))
              (vector-set! s 11 (open))
              (vector-set! s 12 (open)))
            (when (vector-ref s 11) (set-audio-stream-volume! (vector-ref s 11) MUSIC-GAIN))
            (when (vector-ref s 12) (set-audio-stream-volume! (vector-ref s 12) BED-GAIN))))
        (vector-set! s 18 #t)))

    (define (sound-stop! s)
      (for-each (lambda (i) (let ((st (vector-ref s i))) (when st (guard (e (#t #f)) (set-audio-stream-volume! st 0.0)) (guard (e (#t #f)) (close-audio-stream! st))) (vector-set! s i #f)))
                '(10 11 12))
      (for-each (lambda (i) (let ((p (vector-ref s i))) (when p (player-close! p)) (vector-set! s i #f))) '(13 14))
      (vector-set! s 15 #f)
      (vector-set! s 18 #f))

    ;; --- a frame --------------------------------------------------------------------------------
    (define (play! s key gain pan)
      (let ((sample (bank-sample (sound-bank s) key)))
        (when sample
          (mixer-play! (sound-mixer s) sample gain pan)
          (vector-set! s 16 (cons (list key gain pan) (vector-ref s 16))))))

    (define (guard-entry s i)
      (let loop ((gs (vector-ref s 6)))
        (cond ((null? gs) (let ((e (vector (make-steps) 0))) (vector-set! s 6 (append (vector-ref s 6) (list (cons i e)))) e))
              ((= (car (car gs)) i) (cdr (car gs)))
              (else (loop (cdr gs))))))

    (define (sound-frame! s dt you guards)
      (vector-set! s 16 '())
      ;; the bank renders a slice a frame until it is complete
      (unless (bank-ready? (sound-bank s))
        (let ((t0 (current-milliseconds)))
          (bank-render! (sound-bank s) BANK-FRAMES-PER-FRAME)
          (cost! s 'bank (- (current-milliseconds) t0))))
      (let* ((lx (list-ref you 0)) (ly (list-ref you 1)) (yaw (list-ref you 2))
             (moved (list-ref you 3)) (surface (surface-for (list-ref you 4)))
             (gait (gait-for (list-ref you 5) (list-ref you 6))))
        ;; your steps: at the listener, centred
        (for-each
          (lambda (ev)
            (let* ((kind (car ev)) (k (if (eq? kind 'heel) (min 2 (exact (floor (* 3 (rand! s))))) (min 1 (exact (floor (* 2 (rand! s)))))))
                   (g (* (cdr surface) (if (eq? kind 'heel) (gait-heel gait) (gait-toe gait)) (+ 0.9 (* 0.2 (rand! s))))))
              (play! s (list 'step (car surface) kind k) g 0.0)))
          (steps-advance! (vector-ref s 5) moved dt (car surface) gait))
        ;; the guards: their steps positioned, a wall muffling them, their stings
        (let loop ((gs guards) (i 0) (states '()))
          (if (null? gs)
              (let ((sec (vector-ref s 15)))
                (when sec
                  (sections-want! sec (music-rule-want! (vector-ref s 7) states dt))
                  (sections-tick! sec)))
              (let* ((g (car gs)) (e (guard-entry s i))
                     (gx (list-ref g 0)) (gy (list-ref g 1)) (gmoved (list-ref g 2))
                     (state (list-ref g 3)) (occluded? (list-ref g 4))
                     (sp (sound-space gx gy lx ly yaw))
                     (stride (if (>= state 3) GUARD-STRIDE-HUNT GUARD-STRIDE-WALK))
                     (sting (stings-for (vector-ref e 1) state)))
                (for-each
                  (lambda (ev)
                    (when (eq? (car ev) 'heel)
                      (play! s (list 'guard (if occluded? 'muffled 'clear) (min 2 (exact (floor (* 3 (rand! s))))))
                             (* GUARD-GAIN (car sp) (+ 0.9 (* 0.2 (rand! s)))) (cdr sp))))
                  (steps-advance! (vector-ref e 0) (* gmoved (/ 1.248 stride)) dt 'guard 'walk))
                (when sting (play! s (list 'sting sting) (if (eq? sting 'there) 1.0 0.8) (cdr sp)))
                (vector-set! e 1 state)
                (loop (cdr gs) (+ i 1) (cons state states))))))
      (unless (vector-ref s 2) (pump! s)))

    ;; --- the sinks ------------------------------------------------------------------------------
    (define *buf* (make-bytevector (* 8 PUSH) 0))

    (define (pump-stream! s st depth-s fill part)
      (when st
        (let loop ()
          (let* ((depth (audio-stream-depth st))
                 (want (exact (floor (* depth-s (s-rate s)))))
                 (n (min PUSH (audio-stream-room st) (- want depth))))
            (when (> n 0)
              (let ((t0 (current-milliseconds)))
                (fill *buf* n)
                (push-audio-samples st *buf* n)
                (cost! s part (- (current-milliseconds) t0))
                (when (eq? part (quote sfx)) (cost! s (quote frames) n)))
              (loop))))))

    (define (pump! s)
      (pump-stream! s (vector-ref s 10) SFX-DEPTH-S (lambda (b n) (mixer-render! (sound-mixer s) b n)) 'sfx)
      (let ((mp (vector-ref s 13)) (bp (vector-ref s 14)))
        (when mp (pump-stream! s (vector-ref s 11) MUSIC-DEPTH-S (lambda (b n) (player-pull! mp b 0 n)) 'music))
        (when bp (pump-stream! s (vector-ref s 12) MUSIC-DEPTH-S (lambda (b n) (player-pull! bp b 0 n)) 'bed))))

    ;; headless: n frames of the three parts mixed (the stream gains applied)
    (define (sound-render! s out n)
      (let ((tmp (make-bytevector (* 8 n) 0)))
        (mixer-render! (sound-mixer s) out n)
        (for-each
          (lambda (p g)
            (when p
              (player-pull! p tmp 0 n)
              (let add ((i 0))
                (when (< i (* 2 n))
                  (bytevector-ieee-single-set! out (* 4 i)
                                               (+ (bytevector-ieee-single-ref out (* 4 i) 'little)
                                                  (* g (bytevector-ieee-single-ref tmp (* 4 i) 'little)))
                                               'little)
                  (add (+ i 1))))))
          (list (vector-ref s 13) (vector-ref s 14)) (list MUSIC-GAIN BED-GAIN))))

    ;; since the last call: (part . ms-spent) for each part, and (frames . n), the
    ;; frames given to the steps' sink: ms per second of audio is ms / (n / rate)
    ;; (the bank renders only while it is filling)
    (define (sound-trace s)
      (let ((c (vector-ref s 17)))
        (vector-set! s 17 (list (cons 'bank 0.0) (cons 'sfx 0.0) (cons 'music 0.0) (cons 'bed 0.0) (cons 'frames 0)))
        c))))
