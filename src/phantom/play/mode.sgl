;;; (phantom play mode) - P1 in the game: the guard drawn, the HUD, the
;;; capture fade and restart (D12, no quicksave D29), and the win.
;;;
;;; The game ((phantom game)) calls four hooks when play is on
;;; (game-set-play!), in this order each frame:
;;;   (play-hold?)               before a tick: #t while a fade or the win card
;;;                              holds the runner still
;;;   (play-after-tick! walker)  after each tick's walker step: the rules
;;;                              ((phantom play core)); returns a new walker
;;;                              when the attempt restarts, else #f
;;;   (play-frame! alpha cam)    before the world is drawn: the guard's pose,
;;;                              between its last two ticks
;;;   (play-hud! w h k)          after the frame is composited: the eye, the
;;;                              guard's caption and meter, the objective, fades
;;;
;;; The guard is drawn by (phantom guard body) (p0-shell's, t-9e245c): the
;;; smooth body with its walk baked as poses, in the world's own dithered
;;; pass, lit by the light where it stands (the same baked grid the
;;; runner's visibility uses), with a visor whose colour is its state: cyan
;;; calm, amber suspicious, orange searching, red hunting.

(define-library (phantom play mode)
  (import (sigil core)
          (sigil math)
          (sigil graphics)
          (phantom detmath)
          (phantom walker)
          (phantom render)
          (phantom text)
          (phantom play data)
          (phantom play core)
          (phantom guard sense)
          (phantom guard hearing)
          (phantom guard guard)
          (phantom guard body)
          (phantom play devices)
          (phantom play practice)
          (phantom deck hud))

  (export play-mode-start! play-mode-active? play-mode-core
          play-mode-reset! play-mode-set-on-win!
          play-press! play-mode-set-dev! play-mode-sound-feed
          play-hold? play-after-tick! play-frame! play-hud!
          play-held! play-mode-devices play-mode-deck play-mode-terminal
          play-mode-practice? play-mode-crash play-mode-lesson play-mode-practice-done?)

  (begin

    (define FADE-OUT 0.9)           ; s, caught: to black
    (define FADE-IN 0.6)            ; s, the floor again
    (define WIN-HOLD 6.0)           ; s on the win card, then a new attempt (or the title)

    (define *core* #f)
    (define *coll* #f)
    (define *model* (make-bytevector 64 0))
    (define *phase* 'play)          ; play, caught, won
    (define *timer* 0.0)            ; s in the phase
    (define *fade-in* 0.0)          ; s left of the fade back in
    (define *attempts* 1)
    (define *ticks-at-win* 0)
    (define *badge-flash* 0.0)
    (define *pose-x* 0.0) (define *pose-y* 0.0) (define *pose-fx* 0.0) (define *pose-fy* 1.0)
    (define *cam* #f)

    (define (play-mode-active?) (and *core* #t))

    ;; --- PRACTICE (topics/phantom-burn-practice-api) ------------------------------
    (define *practice* #f)
    (define (play-mode-practice?) (and *practice* #t))
    (define (play-mode-crash) (if *practice* (practice-crash *practice*) '()))
    (define (play-mode-lesson) (if *practice* (practice-lesson *practice*) (list 0 0 #f 'active)))
    (define (play-mode-practice-done?) (and *practice* (practice-done? *practice*)))
    ;; a command the deck or the terminal ran, for the lessons
    (define (note-command! r source)
      (when (and *practice* (pair? r) (memq (car r) '(run lights)))
        (practice-note-command! *practice* *core* (caddr r) source))
      r)
    (define (play-mode-core) *core*)

    ;; coll: the floor's collision; info: its floor.sexp datum; text: its
    ;; play.sexp; place?: put the runner at the arrival spot (#f keeps it
    ;; where a --view or ?view put it, for looking at the guard). Draws the
    ;; guard from the next frame.
    (define *place* #t)
    (define (play-mode-start! coll info text place?)
      (let ((data (play-data-from-string text)))
        (set! *coll* coll)
        (set! *place* place?)
        (set! *core* (play-reset! (make-play coll data (cdr (assq 'circuits info)))))
        ;; PRACTICE: the sim's lessons (play.sexp carries them)
        (set! *practice* (and (> (lesson-count data) 0) (make-practice data)))
        (render-set-extra-draw! draw-guard!)
        (render-hide-part! 'badge #f)
        (set! *phase* 'play)
        (set! *timer* 0.0)
        (set! *fade-in* FADE-IN)))

    ;; The runner at the arrival spot, every circuit on: the floor as it
    ;; was when you arrived (D12).
    (define (restart-walker)
      (for-each (lambda (c) (render-circuit-set! c #t)) (render-circuits))
      (play-reset! *core*)
      (when *practice* (practice-reset! *practice*))
      (set! *attempts* (+ *attempts* 1))
      (set! *phase* 'play)
      (set! *timer* 0.0)
      (set! *fade-in* FADE-IN)
      (set! *badge-flash* 0.0)
      (set! *place* #f)
      (set! *use* #f)
      (set! *feed-gx* #f)
      (render-hide-part! 'badge #f)
      (if *practice* (practice-start-walker *practice* *core*) (play-start-walker *core* *coll*)))

    ;; a fade, the win card, or the terminal (you stand at it; the floor goes on)
    ;; PRACTICE: after a capture's fade, only the lesson's room starts over
    ;; (D38): the lights on again, the room's unit and devices as they began,
    ;; you at the lesson's start. No attempt count, no patch note.
    (define (practice-restart-room)
      (for-each (lambda (c) (render-circuit-set! c #t)) (render-circuits))
      (set! *phase* 'play)
      (set! *timer* 0.0)
      (set! *fade-in* FADE-IN)
      (set! *use* #f)
      (practice-reset-room! *practice* *core*))

    (define (play-hold?) (or (not (eq? *phase* 'play)) (and *core* (play-terminal-open? *core*))))

    ;; --- keys: use, and the light keys ------------------------------------------

    ;; The game hands play each pressed key first ((phantom game)'s fifth
    ;; hook); #t means play took it. F (the phone's USE) uses what is in reach
    ;; on the next tick. Without ?dev, the light keys (1 2 3 0) are play's
    ;; to refuse: in the game the panels switch the lights (P2).
    (define *use* #f)
    (define *dev* #f)
    (define *message* #f)           ; a line that replaces the objective for a moment
    (define *message-t* 0.0)
    (define (play-mode-set-dev! on?) (set! *dev* on?))
    (define (play-press! k)
      (cond ((not *core*) #f)
            ;; at the terminal: W/S or up/down select, F (USE) runs, C closes
            ((and (eq? *phase* 'play) (play-terminal-open? *core*))
             (case k
               ((w up) (play-terminal-key! *core* 'up render-circuit-on?))
               ((s down) (play-terminal-key! *core* 'down render-circuit-on?))
               ((f use) (play-terminal-key! *core* 'run render-circuit-on?))
               ((c) (play-terminal-key! *core* 'close render-circuit-on?))
               (else #f)))
            ((memq k '(f use)) (unless (play-hold?) (set! *use* #t)) #t)
            ((and (not *dev*) (memq k LIGHT-KEYS)) #t)
            (else #f)))
    ;; the lab's light and view keys: they switch circuits and move you
    ;; (a view), which play leaves to ?dev
    (define LIGHT-KEYS (map string->symbol '("1" "2" "3" "0" "4" "5" "6" "7" "8" "9" "j" "k" "l")))

    (define (say! line) (set! *message* line) (set! *message-t* 2.5))

    ;; --- the deck (P3, the device API §3) -----------------------------------------

    ;; The game's 6th hook, once a frame before the ticks: whether the deck
    ;; is held (the right mouse button, T, the phone's DECK button).
    (define *deck-held* #f)
    (define (play-held! held?) (set! *deck-held* (and *core* (held? 'deck) #t)))

    ;; For the shell: the devices' states and the deck's prompt (§2).
    (define (play-mode-devices)
      (if *core* (devices-list (play-devices-state *core*) render-circuit-on?) '()))
    (define (play-mode-terminal)
      (if *core* (play-terminal *core* render-circuit-on?) (list '() 0 '(idle))))
    (define (play-mode-deck)
      (if *core*
          (deck-list (play-deck *core*) (play-devices-state *core*) (play-tier *core*) render-circuit-on?)
          (list 'staff #f #f 0.0 'ready)))

    (define (command-line cmd)
      (case cmd
        ((ring) "THE PHONE IS RINGING") ((print) "THE PRINTER IS RUNNING")
        ((vent-on) "THE VENT IS ON") ((vent-off) "THE VENT IS OFF")
        ((blinds-open) "BLINDS OPEN") ((blinds-close) "BLINDS CLOSED")
        (else #f)))

    ;; Apply what the deck did this tick.
    (define (apply-deck! r)
      (when (pair? r)
        (case (car r)
          ((run)
           ;; the blinds let the city in or keep it out: the city circuit is
           ;; the light through floor 14's one window (the lobby's), in the
           ;; renderer and in how lit you are
           (case (caddr r)
             ((blinds-close) (render-circuit-set! 'city #f))
             ((blinds-open) (render-circuit-set! 'city #t))
             (else #f))
           (let ((line (command-line (caddr r)))) (when line (say! line))))
          ((lights)
           (render-circuit-set! (cadr r) (eq? (caddr r) 'lights-on))
           (say! (if (eq? (caddr r) 'lights-on) "LIGHTS ON" "LIGHTS OFF")))
          ((deny) (say! "YOUR TIER CANNOT COMMAND THAT"))
          (else #f))))

    ;; Apply what a use did: the panel switches its circuit in the renderer.
    (define (apply-use! r)
      (cond ((null? r) (say! "NOTHING HERE TO USE"))
            ((memq (car r) '(panel-on panel-off))
             (render-circuit-set! (cadr r) (eq? (car r) 'panel-on))
             (say! (if (eq? (car r) 'panel-on) "LIGHTS ON" "LIGHTS OFF")))
            ((eq? (car r) 'panel-deny) (say! "THE PANEL WANTS A FACILITIES BADGE"))
            ((eq? (car r) 'reader-deny) (say! "THE READER WANTS A FACILITIES BADGE"))
            ((eq? (car r) 'terminal-open) #f)
            (else #f)))

    ;; --- the sound feed ((phantom sound), topics/phantom-sound-api) ------------

    ;; What playback needs this frame: (you guards steps events), where
    ;;   you     (x y yaw), the listener
    ;;   guards  ((x y moved state atten muffled? path-m)), atten and path-m
    ;;           through the floor's openings (P2's hearing, the other way)
    ;;   steps   ((surface gait foot) ...) your steps since the last call,
    ;;           timed by the game ((phantom sound logic)), for sound-step!
    ;;   events  ((kind x y atten muffled?) ...) for sound-event!: badge,
    ;;           panel-on, panel-off, reader-ok, reader-deny, door-open, caught;
    ;;           P3's deck-hold, deck-confirm, deck-deny, print-done,
    ;;           blinds-open, blinds-close
    ;;   sounding (P3) ((id kind x y atten muffled? path-m level) ...) every
    ;;           device sounding this frame (a ringing phone, a running
    ;;           printer, the vent on): playback loops each while it is
    ;;           listed; level #f. And every camera, always, with level its
    ;;           awareness of you 0..1 (the API §4, v8: its pips quicken)
    ;; The steps and events are taken: a second call the same frame has none.
    (define *feed-gx* #f) (define *feed-gy* #f)
    (define (play-mode-sound-feed w)
      (if (not *core*)
          (list (list 0.0 0.0 0.0) '() '() '() '())
          (let* ((g (play-guard *core*))
                 (h (play-hearing *core*))
                 (gx (guard-x g)) (gy (guard-y g))
                 (moved (if *feed-gx* (sqrt (+ (* (- gx *feed-gx*) (- gx *feed-gx*)) (* (- gy *feed-gy*) (- gy *feed-gy*)))) 0.0)))
            (set! *feed-gx* gx) (set! *feed-gy* gy)
            (play-guard-path! *core*)
            (let* ((atten (hear-gain h)) (muffled (hear-muffled? h)) (path-m (hear-path-m h))
                   (guards (list (list gx gy moved (guard-state g) atten muffled path-m))))
              (list (list (walker-x w) (walker-y w) (walker-yaw w))
                    guards
                    (play-take-steps! *core*)
                    (map (lambda (e)
                           ;; placed events pass through the rooms to you like the guard
                           (list (car e) (cadr e) (caddr e) 1.0 #f))
                         (play-take-events! *core*))
                    (sounding w))))))

    ;; The devices sounding now, each with the path from it to you.
    (define (sounding w)
      (let* ((data (play-data *core*)) (dv (play-devices-state *core*)) (h (play-hearing *core*))
             (ds (play-devices data)) (you (play-runner-room *core*)))
        (let loop ((i (- (vector-length ds) 1)) (acc '()))
          (if (< i 0)
              acc
              (let ((d (vector-ref ds i)) (s (devices-state dv i)))
                (if (or (memq s '(ringing running on)) (eq? (device-kind d) 'camera))
                    (begin
                      (hear-path! h (device-room d) (device-x d) (device-y d) you (walker-x w) (walker-y w))
                      (loop (- i 1)
                            (cons (list (device-id d) (device-kind d) (device-x d) (device-y d)
                                        (hear-gain h) (hear-muffled? h) (hear-path-m h)
                                        (and (eq? (device-kind d) 'camera)
                                             (if (eq? s 'alarmed) 1.0 (play-camera-awareness *core* i))))
                                  acc)))
                    (loop (- i 1) acc)))))))

    ;; The site's title-to-play flow: a thunk called once when the win card
    ;; has been shown (the shell goes back to the title), or #f to start a
    ;; new attempt there as before.
    (define *on-win* #f)
    (define (play-mode-set-on-win! thunk) (set! *on-win* thunk))

    ;; A fresh run from the title: every circuit on, the guard and badge
    ;; back, attempt 1, and the runner put at the arrival spot on the next
    ;; tick. (The game's floor must already be the play floor again.)
    (define (play-mode-reset!)
      (for-each (lambda (c) (render-circuit-set! c #t)) (render-circuits))
      (play-reset! *core*)
      (when *practice* (practice-reset! *practice*))
      (set! *attempts* 1)
      (set! *phase* 'play)
      (set! *timer* 0.0)
      (set! *fade-in* FADE-IN)
      (set! *badge-flash* 0.0)
      (set! *place* #t)
      (set! *use* #f)
      (set! *feed-gx* #f)
      (render-hide-part! 'badge #f)
      ;; the title cleared the guard's draw (its room is not this floor)
      (render-set-extra-draw! draw-guard!))

    (define (play-after-tick! w)
      (set! *timer* (+ *timer* TICK))
      (set! *fade-in* (max 0.0 (- *fade-in* TICK)))
      (set! *badge-flash* (max 0.0 (- *badge-flash* TICK)))
      (set! *eye-flash* (max 0.0 (- *eye-flash* TICK)))
      (cond
        ((eq? *phase* 'caught)
         (guard-hold! (play-guard *core*))
         (if (>= *timer* FADE-OUT) (if *practice* (practice-restart-room) (restart-walker)) #f))
        ((eq? *phase* 'won)
         (guard-hold! (play-guard *core*))
         (cond ((< *timer* WIN-HOLD) #f)
               (*on-win*
                ;; hold the card until the shell has gone to the title
                (when (< *timer* (+ WIN-HOLD TICK)) (*on-win*))
                #f)
               (else (restart-walker))))
        (*place*
         ;; the first tick of the first attempt: put the runner at the
         ;; arrival spot; the rules start on the next tick, from there
         (set! *place* #f)
         (if *practice* (practice-start-walker *practice* *core*) (play-start-walker *core* *coll*)))
        (else
         (when *use*
           (set! *use* #f)
           (apply-use! (play-use! *core* w render-circuit-on?)))
         (set! *message-t* (max 0.0 (- *message-t* TICK)))
         (if (play-terminal-open? *core*)
             (apply-deck! (note-command! (play-terminal-step! *core* render-circuit-on?) 'terminal))
             (apply-deck! (note-command! (play-deck! *core* w *deck-held* render-circuit-on?) 'deck)))
         (let ((o (if (eq? (play-outcome *core*) 'won)
                      'won
                      (play-tick! *core* w render-circuit-on? (render-night) (render-pools)))))
           ;; PRACTICE: the lessons, after the rules; a camera's alarm in its
           ;; lesson resets the room as a capture does
           (when (and *practice* (eq? (practice-tick! *practice* *core*) 'caught) (not (eq? o 'caught)))
             (set! *phase* 'caught) (set! *timer* 0.0))
           (cond ((eq? o 'caught) (set! *phase* 'caught) (set! *timer* 0.0))
                 ((eq? o 'won) (set! *phase* 'won) (set! *timer* 0.0)
                  (set! *ticks-at-win* (play-ticks *core*))
                  ;; the patch note's ping, on the landing (none in the sim)
                  (unless *practice* (play-event! *core* 'note (walker-x w) (walker-y w))))
                 ((eq? o 'badge) (set! *badge-flash* 2.5)
                  ;; taken: gone from the desk (the compiler's badge part)
                  (render-hide-part! 'badge #t)))
           #f))))

    ;; --- the guard's body ------------------------------------------------------

    ;; The visor's colours by state (the caption uses them too; (phantom guard
    ;; body) draws the same four) and the caption's words.
    (define VISORS '((0.302 0.949 0.851) (1.0 0.62 0.1) (1.0 0.42 0.1) (1.0 0.18 0.3)))
    (define WORDS (vector "" "?" "SEARCHING" "THERE"))


    ;; --- drawing it ------------------------------------------------------------

    (define (lerp a b t) (+ a (* t (- b a))))

    (define (play-frame! alpha cam)
      (set! *cam* cam)
      ;; the devices' LEDs, alarm and blinds, on changes only (the shell's)
      (when *core* (device-parts-update! (play-mode-devices)))
      (when *core*
        (let* ((g (play-guard *core*))
               (fx (lerp (guard-prev-fx g) (guard-fx g) alpha))
               (fy (lerp (guard-prev-fy g) (guard-fy g) alpha))
               (m (sqrt (+ (* fx fx) (* fy fy)))))
          (set! *pose-x* (lerp (guard-prev-x g) (guard-x g) alpha))
          (set! *pose-y* (lerp (guard-prev-y g) (guard-y g) alpha))
          (set! *pose-fx* (if (> m 1e-6) (/ fx m) 0.0))
          (set! *pose-fy* (if (> m 1e-6) (/ fy m) 1.0))
          (pose! *model* *pose-x* *pose-y* (guard-z g) *pose-fx* *pose-fy* 0.0 0.0 0.0))))

    ;; A column-major model matrix: the body's frame at (x y z) facing
    ;; (fx fy), offset ox along its right, and turned by angle a about its
    ;; right axis at height h (a leg swinging from the hip).
    (define (f32 m i v) (bytevector-ieee-single-set! m (* 4 i) v 'little))
    (define (pose! m x y z fx fy ox a h)
      (let* ((c (cos a)) (s (sin a))
             (rx fy) (ry (- fx)))
        (f32 m 0 rx) (f32 m 1 ry) (f32 m 2 0.0) (f32 m 3 0.0)
        (f32 m 4 (* c fx)) (f32 m 5 (* c fy)) (f32 m 6 s) (f32 m 7 0.0)
        (f32 m 8 (* (- s) fx)) (f32 m 9 (* (- s) fy)) (f32 m 10 c) (f32 m 11 0.0)
        (f32 m 12 (+ x (* ox rx) (* s h fx)))
        (f32 m 13 (+ y (* ox ry) (* s h fy)))
        (f32 m 14 (+ z (* h (- 1.0 c))))
        (f32 m 15 1.0)))

    ;; Inside the world pass ((phantom render)'s extra draw).
    (define (draw-guard!)
      (when *core*
        (let* ((g (play-guard *core*))
               (ls (play-light-state *core*))
               (_ (light-rgb-at! ls (play-data *core*) *pose-x* *pose-y* (guard-z g))))
          (guard-body-draw! *model* (guard-phase g) (guard-state g)
                            (light-r ls) (light-g ls) (light-b ls)))))

    ;; --- the HUD ---------------------------------------------------------------

    ;; A world point on the window: (x . y), or #f behind the camera or off
    ;; the view. cam is (phantom render)'s camera (x y z yaw pitch roll fov).
    (define (project cam px py pz w h k)
      (let* ((yaw (vector-ref cam 3)) (pitch (vector-ref cam 4))
             (cp (cos pitch)) (sp (sin pitch)) (sy (sin yaw)) (cy (cos yaw))
             (fx (* -1.0 sy cp)) (fy (* cy cp)) (fz sp)
             (rx cy) (ry sy)
             (ux (* ry fz)) (uy (- (* rx fz))) (uz (- (* rx fy) (* ry fx)))
             (dx (- px (vector-ref cam 0))) (dy (- py (vector-ref cam 1))) (dz (- pz (vector-ref cam 2)))
             (zc (+ (* dx fx) (* dy fy) (* dz fz))))
        (and (> zc 0.2)
             (let* ((xc (+ (* dx rx) (* dy ry)))
                    (yc (+ (* dx ux) (* dy uy) (* dz uz)))
                    (t (tan (/ (* PI (vector-ref cam 6)) 360.0)))
                    (sx (+ (/ VIEW-W 2.0) (* (/ xc (* zc t)) (/ VIEW-H 2.0))))
                    (sy (- (/ VIEW-H 2.0) (* (/ yc (* zc t)) (/ VIEW-H 2.0))))
                    (ox (floor (/ (- w (* VIEW-W k)) 2)))
                    (oy (floor (/ (- h (* VIEW-H k)) 2))))
               (and (>= sx 0.0) (< sx VIEW-W) (>= sy 0.0) (< sy VIEW-H)
                    (cons (+ ox (* k sx)) (+ oy (* k sy))))))))

    (define (play-hud! w h k)
      (when *core*
        (let ((ts (max 1 (min 4 k))))
          (draw-eye! w h ts)
          (draw-guard-caption! w h k ts)
          (draw-objective! w h ts)
          ;; the deck's prompt, bottom left (the shell's draw)
          ;; Crash's lines, stacked above the deck's prompt (the shell's draw)
          (when *practice* (crash-lines-draw! w h k (play-mode-crash)))
          (cond ((and (eq? *phase* 'play) (play-terminal-open? *core*))
                 (terminal-draw! w h k (play-mode-terminal) (play-mode-devices)))
                ((not (play-hold?)) (deck-hud-draw! w h k (play-mode-deck))))
          (draw-fades! w h ts))))

    ;; The eye (design §3): one glyph that opens in five steps with how
    ;; visible you are (light x stance x motion).
    ;; A camera's alarm flashes the eye's box amber for EYE-FLASH seconds.
    (define EYE-FLASH 1.5)
    (define *eye-flash* 0.0)
    (define *alarms-seen* 0)
    (define (draw-eye! w h ts)
      (let ((n (play-camera-alarms *core*)))
        (when (> n *alarms-seen*) (set! *eye-flash* EYE-FLASH))
        (set! *alarms-seen* n))
      (let* ((v (play-visibility *core*))
             (step (min 4 (exact (floor (* 5.0 v)))))
             (open (/ step 4.0))
             (cx (/ w 2.0))
             (cy (- h (* 20 ts)))
             (hw (* 16 ts))
             (hh (* 7 ts open)))
        (set-color 0.0 0.0 0.0 0.5)
        (with-blend-mode 'normal (draw-filled-rect (- cx (* 20 ts)) (- cy (* 11 ts)) (* 40 ts) (* 22 ts)))
        ;; a camera noticing you: an amber bar along the box's foot, filling
        ;; as it becomes sure (P3: "I can't tell when it sees me")
        (let ((watch (play-camera-watch *core*)))
          (when (> watch 0.0)
            (set-color 1.0 0.62 0.1)
            (draw-filled-rect (- cx (* 20 ts)) (+ cy (* 10 ts)) (* 40 ts watch) ts)))
        ;; and its alarm: the box's edge flashes amber
        (when (> *eye-flash* 0.0)
          (when (> (sin (* *eye-flash* 18.0)) -0.3)
            (set-color 1.0 0.62 0.1)
            (draw-filled-rect (- cx (* 20 ts)) (- cy (* 11 ts)) (* 40 ts) ts)
            (draw-filled-rect (- cx (* 20 ts)) (+ cy (* 10 ts)) (* 40 ts) ts)
            (draw-filled-rect (- cx (* 20 ts)) (- cy (* 11 ts)) ts (* 22 ts))
            (draw-filled-rect (+ cx (* 19 ts)) (- cy (* 11 ts)) ts (* 22 ts))))
        (if (= step 0)
            (begin
              (set-color 0.55 0.6 0.75)
              (draw-filled-rect (- cx hw) (- cy (* 0.5 ts)) (* 2 hw) ts))
            (let ((n 12))
              (set-color 0.85 0.88 1.0)
              ;; the lids: a lens of triangles from the centre
              (let loop ((i 0))
                (when (< i n)
                  (let* ((x0 (+ (- hw) (* (/ (* 2.0 hw) n) i)))
                         (x1 (+ x0 (/ (* 2.0 hw) n)))
                         (y0 (* hh (- 1.0 (* (/ x0 hw) (/ x0 hw)))))
                         (y1 (* hh (- 1.0 (* (/ x1 hw) (/ x1 hw))))))
                    (fill-triangle cx cy (+ cx x0) (- cy y0) (+ cx x1) (- cy y1))
                    (fill-triangle cx cy (+ cx x1) (+ cy y1) (+ cx x0) (+ cy y0))
                    (loop (+ i 1)))))
              (set-color (+ 0.3 (* 0.7 open)) (* 0.62 open) (* 0.2 (- 1.0 open)))
              (draw-filled-circle cx cy (* ts (+ 2.0 (* 3.0 open))) 12)
              (set-color 0.05 0.04 0.1)
              (draw-filled-circle cx cy (* ts 1.5) 8)))
        (set-color 1.0 1.0 1.0)))

    ;; Over the guard's head: a word for its state (design §5: ?, SEARCHING,
    ;; THERE) and its awareness as a bar, while it is on screen.
    (define (draw-guard-caption! w h k ts)
      (let* ((g (play-guard *core*))
             (s (guard-state g))
             (a (guard-awareness g))
             (p (and *cam* (project *cam* *pose-x* *pose-y* (+ (guard-z g) 2.05) w h k))))
        ;; only when you could see the guard's head from here: the caption
        ;; must not show where a guard is through a wall
        (when (and p (or (> a 0.02) (> s CALM))
                   (sight-clear? *coll* (play-glass (play-data *core*))
                                 (vector-ref *cam* 0) (vector-ref *cam* 1) (vector-ref *cam* 2)
                                 *pose-x* *pose-y* (+ (guard-z g) 1.7)))
          (let* ((word (vector-ref WORDS s))
                 (col (list-ref VISORS s))
                 (bw (* 24 ts)) (x (- (car p) (/ bw 2))) (y (cdr p)))
            (set-color 0.0 0.0 0.0 0.6)
            (with-blend-mode 'normal (draw-filled-rect (- x ts) (- y ts) (+ bw (* 2 ts)) (* 4 ts)))
            (set-color (car col) (cadr col) (caddr col))
            (draw-filled-rect x y (* bw a) (* 2 ts))
            (unless (string=? word "")
              (draw-text word (- (car p) (/ (text-width word ts) 2)) (- y (* 10 ts)) ts))
            (set-color 1.0 1.0 1.0)))))

    (define (draw-objective! w h ts)
      (let ((line (cond ((eq? *phase* 'won) #f)
                        ((> *message-t* 0.0) *message*)
                        ((> *badge-flash* 0.0) "FACILITIES BADGE. NOW THE STAIRWELL DOOR, UNDER THE MEZZANINE")
                        ((and (play-near-exit? *core*) (play-badge? *core*)) "THE READER: PRESS F (USE)")
                        ((play-near-exit? *core*) "THE READER WANTS A FACILITIES BADGE")
                        ((play-badge? *core*) "TO THE STAIRWELL DOOR, UNDER THE MEZZANINE")
                        (else "FIND THE FACILITIES BADGE: THE FM OFFICE DESK"))))
        (when line
          (let ((x (/ (- w (text-width line ts)) 2)) (y (* 8 ts)))
            (set-color 0.0 0.0 0.0 0.55)
            (with-blend-mode 'normal (draw-filled-rect (- x (* 4 ts)) (- y (* 3 ts)) (+ (text-width line ts) (* 8 ts)) (* 13 ts)))
            (set-color 0.8 0.85 1.0)
            (draw-text line x y ts)
            (set-color 1.0 1.0 1.0)))))

    (define (draw-fades! w h ts)
      (cond
        ((eq? *phase* 'caught)
         (let ((a (min 1.0 (/ *timer* FADE-OUT))))
           (set-color 0.0 0.0 0.0 a)
           (with-blend-mode 'normal (draw-filled-rect 0 0 w h))
           (set-color 1.0 0.25 0.35 a)
           (big-centred "CAUGHT" w (* 0.45 h) (* 2 ts))
           (set-color 1.0 1.0 1.0)))
        ;; PRACTICE: the sim ends on Crash, not Gibson (D38): no patch note,
        ;; the frame fades while Crash's last line stays up
        ((and (eq? *phase* 'won) *practice*)
         (set-color 0.0 0.0 0.0 (min 0.7 (/ *timer* 3.0)))
         (with-blend-mode 'normal (draw-filled-rect 0 0 w h))
         (set-color 1.0 1.0 1.0))
        ((eq? *phase* 'won)
         ;; the patch note on the landing (design §5): flat system text, then
         ;; Gibson's line in violet; a clean floor gets no Gibson line
         (let* ((a (min 0.85 (/ *timer* 1.0)))
                (secs (exact (floor (/ *ticks-at-win* 60))))
                (patches (play-patches *core*))
                (n (length (play-incidents *core*)))
                (x (/ (- w (text-width "PATCH 14-1  EMERGENCY LIGHTING: FM OFFICE" ts)) 2))
                (line (lambda (i) (+ (* 0.3 h) (* i 12 ts)))))
           (set-color 0.0 0.0 0.0 a)
           (with-blend-mode 'normal (draw-filled-rect 0 0 w h))
           (set-color 0.8 0.85 1.0)
           (draw-text "FLOOR 14 TO 27" x (line 0) ts)
           (draw-text (string-append "INCIDENTS " (number->string n)) x (line 1) ts)
           (if (null? patches)
               (draw-text "NO CHANGES" x (line 2) ts)
               (let loop ((ps patches) (i 1))
                 (unless (null? ps)
                   (draw-text (string-append "PATCH 14-" (number->string i) "  " (car (car ps))) x (line (+ i 1)) ts)
                   (loop (cdr ps) (+ i 1)))))
           (unless (null? patches)
             (set-color 0.702 0.42 1.0)
             (draw-text (string-append "# " (string-upcase* (cadr (car patches)))) x (line (+ 2 (length patches))) ts))
           (set-color 0.45 0.5 0.6)
           (draw-text (string-append (number->string (quotient secs 60)) ":"
                                     (let ((s (remainder secs 60))) (string-append (if (< s 10) "0" "") (number->string s)))
                                     "  ATTEMPT " (number->string *attempts*))
                      x (line (+ 4 (length patches))) ts)
           (set-color 1.0 1.0 1.0)))
        ((> *fade-in* 0.0)
         (set-color 0.0 0.0 0.0 (/ *fade-in* FADE-IN))
         (with-blend-mode 'normal (draw-filled-rect 0 0 w h))
         (set-color 1.0 1.0 1.0))))

    ;; Gibson's lines are sentence case; the HUD's font has capitals only, so
    ;; they are drawn in capitals until it grows lower case.
    (define (string-upcase* s) (list->string (map char-upcase (string->list s))))

    (define (big-centred text w y ts)
      (draw-text text (/ (- w (text-width text ts)) 2) y ts))))
