;;; (phantom play core) - The rules of an attempt at the floor, with no
;;; drawing: the light on the runner, the guard's tick, the badge, the exit
;;; and the capture. The game ((phantom play mode)) and the gates
;;; (test/test-guard.sgl) run this same code, headless in the gates.
;;;
;;; Once a tick, after the walker has stepped: (play-tick! p walker on? night
;;; pools) takes the runner's state and the circuits' (on? name, and the
;;; renderer's night and pools knobs), and returns what happened:
;;;   playing   nothing ended the attempt
;;;   badge     the facilities badge was picked up this tick
;;;   caught    a hunting guard reached you (D12: the floor restarts)
;;;   won       you reached the stairwell door with the badge
;;; The attempt holds its last outcome (play-outcome) until play-reset!.

(define-library (phantom play core)
  (import (sigil core)
          (sigil math)
          (sigil list)
          (phantom collide)
          (phantom walker)
          (phantom play data)
          (phantom guard nav)
          (phantom guard sense)
          (phantom guard guard)
          (phantom guard hearing)
          (phantom sound logic)
          (phantom play devices)
          (phantom detmath))

  (export make-play play? play-reset! play-tick!
          play-data play-guard play-guard-world
          play-light play-light-01 play-visibility play-shape play-light-state
          play-badge? play-outcome play-ticks play-start-walker
          play-near-exit? GUARD-START-LEG PICKUP-REACH EXIT-REACH
          play-hearing play-take-steps! play-last-heard play-runner-room
          play-guard-path! play-set-hearing!
          play-use! play-incidents play-patches play-take-events! play-event! USE-REACH
          play-devices-state play-deck play-tier play-deck! play-device-level play-device-approach
          play-mask VENT-NOISE MASK-GAIN
          play-unit-count play-active-unit play-unit-guard play-set-unit!
          play-camera-awareness play-camera-watch play-camera-alarms CAMERA-GAIN CAMERA-DECAY CAMERA-DARK
          play-terminal-open? play-terminal play-terminal-key! play-terminal-step!
          TERMINAL-TIME TERMINAL-LIGHT
          PHONE-NOISE PRINTER-NOISE ANSWER-REACH DEVICE-NOTICE)

  (begin

    ;; The guard starts each attempt at this point of its route (floor 14:
    ;; the office, so it reaches the lobby about half a minute in; at point 0
    ;; it would stand a metre and a half from the arrival spot).
    (define GUARD-START-LEG 2)
    (define PICKUP-REACH 1.1)       ; m, horizontally, from the badge
    (define EXIT-REACH 1.2)         ; m, from the stairwell door's centre

    ;; The play: a vector
    ;;  0 tag  1 data  2 guard world  3 guard  4 light state  5 target
    ;;  6 circuits (floor.sexp's)  7 badge held?  8 outcome  9 ticks
    ;;  10 light (brightness)  11 light 0..1  12 visibility  13 shape
    ;;  14 near the exit without the badge?
    ;;  P2: 15 hearing  16 your steps ((phantom sound logic))  17 18 your
    ;;  last x y  19 the steps for playback since it last took them, newest
    ;;  first: ((surface gait foot) ...)  20 the hearing threshold
    ;;  21 the loudest step the guard received this tick (a level)
    ;;  22 your room  23 hearing on? (the sight gates turn it off, to
    ;;  measure sight alone)
    ;;  24 incidents, newest first: ((kind room-name) ...)  25 the guard's
    ;;  state last tick  26 the guard's room last tick  27 events for
    ;;  playback, newest first: ((kind x y) ...)  28 the switchable circuits
    ;;  that were on when the attempt began (#f until its first tick): only
    ;;  a light that was on and is now off makes a dark room (design §3)
    ;;  P3: 29 the devices ((phantom play devices))  30 the deck
    ;;  31 each device's approach: where a unit stands to reach it (#(x y z),
    ;;  or #f)  32 the masking this tick: what a running vent adds to the
    ;;  hearing threshold where the guard stands
    ;;  33 each camera's awareness of you, 0..1 (by device index)
    ;;  34 each camera's view, found once: #(ax ay az cos-half-fov range)
    ;;  (a unit vector from its heading and pitch), or #f for a non-camera
    ;;  35 the terminal: #(open? selected running-row progress status
    ;;  status-seconds rows), rows its targets in display order, each
    ;;  (device . INDEX) or (zone . CIRCUIT)
    ;;  36 returning: the unit gave up a search and is heading back to its
    ;;  route (robot-back fires when it reaches a route point)
    ;;  PRACTICE: 37 the units: a vector of #(guard-world guard), one per
    ;;  play.sexp guard, sharing one nav; slots 2 and 3 are the active one's
    ;;  (the only one that steps: the sim wakes the unit of the room you are
    ;;  in)  38 the active unit's index
    (define (play? p) (and (vector? p) (= (vector-length p) 39) (eq? (vector-ref p 0) 'play)))
    (define (play-unit-count p) (vector-length (vector-ref p 37)))
    (define (play-active-unit p) (vector-ref p 38))
    (define (play-unit-guard p i) (vector-ref (vector-ref (vector-ref p 37) i) 1))
    ;; Make unit i the active one: it steps, perceives and hears; the others
    ;; hold where they are, as they are.
    (define (play-set-unit! p i)
      (let ((u (vector-ref (vector-ref p 37) i)))
        (vector-set! p 2 (vector-ref u 0))
        (vector-set! p 3 (vector-ref u 1))
        (vector-set! p 38 i)
        (vector-set! p 25 (guard-state (vector-ref u 1)))
        p))
    (define (play-terminal-open? p) (vector-ref (vector-ref p 35) 0))
    (define (play-camera-awareness p i) (vector-ref (vector-ref p 33) i))
    ;; for the HUD's eye: the most any camera that has you in view now is
    ;; sure of you (0 when none does), and how many cameras have alarmed
    (define (play-camera-watch p)
      (let ((dv (vector-ref p 29)) (aw (vector-ref p 33)))
        (let loop ((i 0) (m 0.0))
          (if (< i (vector-length aw))
              (loop (+ i 1) (if (eq? (devices-state dv i) 'seeing) (max m (vector-ref aw i)) m))
              m))))
    (define (play-camera-alarms p)
      (let ((dv (vector-ref p 29)) (n (vector-length (vector-ref p 33))))
        (let loop ((i 0) (c 0))
          (if (< i n) (loop (+ i 1) (if (eq? (devices-state dv i) 'alarmed) (+ c 1) c)) c))))
    (define (play-mask p) (vector-ref p 32))
    (define (play-device-approach p i) (vector-ref (vector-ref p 31) i))
    (define (play-devices-state p) (vector-ref p 29))
    (define (play-deck p) (vector-ref p 30))
    ;; the runner's tier (design §3): the facilities badge makes you FACILITIES
    (define (play-tier p) (if (vector-ref p 7) 'facilities 'staff))
    (define USE-REACH 1.3)          ; m, horizontally: the panel, the reader
    (define (play-incidents p) (reverse (vector-ref p 24)))
    ;; the events since the last call, oldest first, and forget them
    (define (play-take-events! p)
      (let ((e (reverse (vector-ref p 27)))) (vector-set! p 27 '()) e))
    (define (event! p kind x y) (vector-set! p 27 (cons (list kind x y) (vector-ref p 27))))
    (define (play-event! p kind x y) (event! p kind x y))
    (define (play-set-hearing! p on?) (vector-set! p 23 on?) p)
    (define (play-hearing p) (vector-ref p 15))
    (define (play-last-heard p) (vector-ref p 21))
    (define (play-runner-room p) (vector-ref p 22))
    ;; the steps since the last call, oldest first, and forget them
    (define (play-take-steps! p)
      (let ((s (reverse (vector-ref p 19)))) (vector-set! p 19 '()) s))
    (define (play-data p) (vector-ref p 1))
    (define (play-guard-world p) (vector-ref p 2))
    (define (play-guard p) (vector-ref p 3))
    (define (play-badge? p) (vector-ref p 7))
    (define (play-outcome p) (vector-ref p 8))
    (define (play-ticks p) (vector-ref p 9))
    (define (play-light p) (vector-ref p 10))
    (define (play-light-state p) (vector-ref p 4))
    (define (play-light-01 p) (vector-ref p 11))
    (define (play-visibility p) (vector-ref p 12))
    (define (play-shape p) (vector-ref p 13))
    (define (play-near-exit? p) (vector-ref p 14))

    ;; coll: the floor's (phantom collide) collision; data: its play data;
    ;; circuits: floor.sexp's (circuits ...) entries.
    (define (make-play coll data circuits)
      (let* ((gw (make-guard-world coll data))
             (units (make-units coll data gw))
             (p (vector 'play data gw (vector-ref (vector-ref units 0) 1) (make-light-state) (make-target)
                        circuits #f 'playing 0 0.0 0.0 0.0 0.0 #f
                        (make-hearing data) (make-steps) #f #f '() (hearing-threshold data) 0.0 -1 #t
                        '() 0 -1 '() #f
                        (make-devices data) (make-deck) (device-approaches data gw) 0.0
                        (make-vector (device-count data) 0.0) (camera-views data)
                        (vector #f 0 -1 0.0 '(idle) 0.0 (terminal-targets data)) #f
                        units 0)))
        p))

    ;; The units: the first is the one make-play's guard world was built for;
    ;; the others share its nav.
    (define (make-units coll data gw0)
      (let ((n (unit-count data)))
        (let loop ((i 0) (acc '()))
          (if (< i n)
              (let ((gw (if (= i 0) gw0 (make-guard-world coll data i (guard-world-nav gw0)))))
                (loop (+ i 1) (cons (vector gw (make-guard gw (if (= i 0) GUARD-START-LEG 0))) acc)))
              (list->vector (reverse acc))))))

    ;; A new attempt: every unit back at its start, the first active; the
    ;; badge on the desk.
    (define (play-reset! p)
      (let ((us (vector-ref p 37)))
        (let loop ((i 0))
          (when (< i (vector-length us))
            (let ((u (vector-ref us i)))
              (guard-reset! (vector-ref u 1) (vector-ref u 0) (if (= i 0) GUARD-START-LEG 0)))
            (loop (+ i 1)))))
      (play-set-unit! p 0)
      (vector-set! p 7 #f)
      (vector-set! p 8 'playing)
      (vector-set! p 9 0)
      (vector-set! p 14 #f)
      (vector-set! p 16 (make-steps))
      (vector-set! p 17 #f) (vector-set! p 18 #f) (vector-set! p 22 -1)
      (vector-set! p 19 '())
      (vector-set! p 21 0.0)
      (vector-set! p 24 '())
      (vector-set! p 25 0)
      (vector-set! p 26 -1)
      (vector-set! p 27 '())
      (vector-set! p 28 #f)
      (devices-reset! (vector-ref p 29))
      (deck-reset! (vector-ref p 30))
      (vector-set! p 32 0.0)
      (vector-fill! (vector-ref p 33) 0.0)
      (terminal-reset! (vector-ref p 35))
      (vector-set! p 36 #f)
      p)

    ;; The path from the guard to you (for playback: how much of the guard
    ;; reaches you), into (play-hearing p)'s gain, path-m and muffled?.
    (define (play-guard-path! p)
      (let* ((g (vector-ref p 3)) (d (vector-ref p 1))
             (rg (room-at d (guard-x g) (guard-y g) (guard-z g))))
        ;; before an attempt's first tick you are nowhere yet: nothing reaches you
        (hear-path! (vector-ref p 15) rg (guard-x g) (guard-y g)
                    (if (vector-ref p 17) (vector-ref p 22) -1)
                    (or (vector-ref p 17) (guard-x g)) (or (vector-ref p 18) (guard-y g)))))

    ;; Your steps this tick: timed by (phantom sound logic) from how far you
    ;; moved, on the surface under you at your gait. Each heel strike is a
    ;; noise the guard may hear through the rooms between you; each step is
    ;; kept for playback. No steps while you are in the air or climbing.
    (define (steps! p w x y z)
      (let* ((px (or (vector-ref p 17) x)) (py (or (vector-ref p 18) y))
             (moved (sqrt (+ (* (- x px) (- x px)) (* (- y py) (- y py)))))
             (data (vector-ref p 1))
             (room (room-at data x y z)))
        (vector-set! p 17 x) (vector-set! p 18 y) (vector-set! p 22 room)
        (vector-set! p 21 0.0)
        (when (and (walker-grounded? w) (not (walker-mantling? w)))
          (let* ((tag (walker-surface w))
                 (gait (gait-for (walker-speed w) (walker-crouching? w)))
                 (events (steps-advance! (vector-ref p 16) moved TICK (play-surface-name data tag) gait)))
            (for-each
             (lambda (e)
               (vector-set! p 19 (cons (list (cadr e) (caddr e) (car e)) (vector-ref p 19)))
               (when (eq? (car e) 'heel)
                 (let* ((g (vector-ref p 3)) (h (vector-ref p 15))
                        (rg (room-at data (guard-x g) (guard-y g) (guard-z g))))
                   (hear-path! h room x y rg (guard-x g) (guard-y g))
                   (let ((level (heard-level h (step-noise data tag gait))))
                     (vector-set! p 21 (max (vector-ref p 21) level))
                     ;; over the floor's threshold, raised where a vent runs
                     (when (vector-ref p 23) (guard-hear! g level (+ (vector-ref p 20) (vector-ref p 32)) x y z))))))
             events)))))

    ;; The walker at the floor's arrival spot, facing as the floor says.
    (define (play-start-walker p coll)
      (let* ((s (play-start (vector-ref p 1)))
             (x (vector-ref s 0)) (y (vector-ref s 1))
             (z (or (collide-floor coll x y -1.0 1.0) 0.0)))
        (make-walker x y z (vector-ref s 2))))

    (define (play-tick! p w on? night pools)
      (if (not (eq? (vector-ref p 8) 'playing))
          (vector-ref p 8)
          (let* ((data (vector-ref p 1))
                 (ls (vector-ref p 4))
                 (x (walker-x w)) (y (walker-y w)) (z (walker-z w))
                 (_ (light-levels! ls (vector-ref p 6) on? night pools))
                 (light (light-at ls data x y z))
                 ;; at the terminal its screen lights you (design §3)
                 (l01 (if (vector-ref (vector-ref p 35) 0) (max TERMINAL-LIGHT (light-01 light)) (light-01 light)))
                 (shape (* (stance-factor (walker-crouching? w)) (motion-factor (walker-speed w))))
                 (vis (* l01 shape))
                 (g (vector-ref p 3)))
            (vector-set! p 9 (+ (vector-ref p 9) 1))
            (vector-set! p 10 light)
            (vector-set! p 11 l01)
            (vector-set! p 12 vis)
            (vector-set! p 13 shape)
            (target-set! (vector-ref p 5) x y z (walker-eye-z w) (walker-height w) l01 vis shape)
            (mask! p)
            (steps! p w x y z)
            (guard-step! g (vector-ref p 2) (vector-ref p 5) TICK)
            (devices-tick! (vector-ref p 29) TICK
                           (lambda (i kind)
                             (when (eq? kind 'printer)
                               (let ((d (vector-ref (play-devices data) i)))
                                 (event! p 'print-done (device-x d) (device-y d))))))
            (hear-devices! p)
            (cameras! p)
            (notice! p on?)
            (let ((outcome
                   (cond
                     ((guard-caught? g) 'caught)
                     ((and (not (vector-ref p 7)) (near-badge? data x y z)) 'badge)
                     ((near-exit? data x y z) (vector-set! p 14 #t) 'playing)
                     (else (vector-set! p 14 #f) 'playing))))
              (cond ((eq? outcome 'badge) (vector-set! p 7 #t)
                                          (event! p 'badge (vector-ref (play-badge data) 0) (vector-ref (play-badge data) 1))
                                          'badge)
                    ((eq? outcome 'playing) 'playing)
                    (else (event! p 'caught x y) (vector-set! p 8 outcome) outcome))))))

    ;; --- devices (P3) ----------------------------------------------------------------

    ;; A sounding device's noise at the source, on the steps' scale (a
    ;; walk on tile is 0.6): a phone is heard across the floor, a printer
    ;; through a room or two.
    (define PHONE-NOISE 3.0)
    (define PRINTER-NOISE 1.5)
    (define DEVICE-NOTICE 0.65)     ; awareness a heard device raises: SEARCHING, toward it
    (define ANSWER-REACH 1.8)       ; m: a searching unit this near a ringing phone answers it

    ;; Where a unit stands to reach each device: the nearest place to it on
    ;; its room's floor that the guard's route connects to. A device's own
    ;; point is on a desk or up a wall, and the nearest walkable cell to it
    ;; can be the desk's top, an island no path reaches (so a search for it
    ;; would end where it began). Found once, when the play is made.
    (define APPROACH-WITHIN 3.0)    ; m: farther, the device has no approach (#f)
    (define (device-approaches data gw)
      (let* ((nav (guard-world-nav gw))
             (f (make-field nav))
             (route (play-route data))
             (_ (nav-field! nav f (vector-ref route 0) (vector-ref route 1) 0.0 #f #f #f))
             (dist (field-dist f))
             (rooms (play-rooms data))
             (ds (play-devices data)))
        (list->vector
          (map (lambda (d)
                 (let ((fz (room-floor (vector-ref rooms (device-room d)))))
                   (let scan ((i 0) (best -1) (bd (* APPROACH-WITHIN APPROACH-WITHIN)))
                     (if (< i (vector-length dist))
                         (if (and (>= (vector-ref dist i) 0) (< (abs (- (nav-node-z nav i) fz)) 0.4))
                             (let* ((dx (- (nav-node-x nav i) (device-x d))) (dy (- (nav-node-y nav i) (device-y d)))
                                    (d2 (+ (* dx dx) (* dy dy))))
                               (if (< d2 bd) (scan (+ i 1) i d2) (scan (+ i 1) best bd)))
                             (scan (+ i 1) best bd))
                         (and (>= best 0) (vector (nav-node-x nav best) (nav-node-y nav best) (nav-node-z nav best)))))))
               (vector->list ds)))))

    (define (device-noise kind state)
      (case kind
        ((phone) (if (eq? state 'ringing) PHONE-NOISE 0.0))
        ((printer) (if (eq? state 'running) PRINTER-NOISE 0.0))
        (else 0.0)))

    ;; A running vent (design §3: "loud places hide you"): its roar where
    ;; the guard stands, through the rooms like any noise, raises the
    ;; threshold he hears over by MASK-GAIN times it. It changes what the
    ;; unit hears, not what you hear. Near the vent a walk on hard floor
    ;; goes unheard; a run still carries.
    (define VENT-NOISE 1.5)
    (define MASK-GAIN 0.6)
    (define (mask! p)
      (let* ((data (vector-ref p 1)) (dv (vector-ref p 29)) (ds (play-devices data))
             (g (vector-ref p 3)) (h (vector-ref p 15))
             (rg (room-at data (guard-x g) (guard-y g) (guard-z g))))
        (let loop ((i 0) (sum 0.0))
          (if (< i (vector-length ds))
              (let ((d (vector-ref ds i)))
                (if (and (eq? (device-kind d) 'vent) (eq? (devices-state dv i) 'on))
                    (begin
                      (hear-path! h (device-room d) (device-x d) (device-y d) rg (guard-x g) (guard-y g))
                      (loop (+ i 1) (+ sum (heard-level h VENT-NOISE))))
                    (loop (+ i 1) sum)))
              (vector-set! p 32 (* MASK-GAIN sum))))))

    ;; What reaches the guard of device i now (0 when it is silent).
    (define (play-device-level p i)
      (let* ((data (vector-ref p 1)) (dv (vector-ref p 29))
             (d (vector-ref (play-devices data) i))
             (noise (device-noise (device-kind d) (devices-state dv i))))
        (if (= noise 0.0)
            0.0
            (let* ((g (vector-ref p 3)) (h (vector-ref p 15))
                   (rg (room-at data (guard-x g) (guard-y g) (guard-z g))))
              (hear-path! h (device-room d) (device-x d) (device-y d) rg (guard-x g) (guard-y g))
              (heard-level h noise)))))

    ;; The unit and the sounding devices (design §4, "the first
    ;; distractions"): one it hears over the threshold, it goes to look at
    ;; (SEARCHING, the device's floor as the place), and the noticing is an
    ;; incident; a ringing phone it reaches while searching, it answers.
    ;; It returns to its route when the search runs out (the guard's own
    ;; rule). A hunting unit carries on hunting.
    (define (hear-devices! p)
      (when (vector-ref p 23)
        (let* ((data (vector-ref p 1)) (dv (vector-ref p 29)) (g (vector-ref p 3))
               (ds (play-devices data)))
          (let loop ((i 0))
            (when (< i (vector-length ds))
              (let ((level (play-device-level p i)))
                (when (> level (+ (vector-ref p 20) (vector-ref p 32)))
                  (let* ((d (vector-ref ds i))
                         (room (device-room d))
                         (fz (room-floor (vector-ref (play-rooms data) room)))
                         (a (vector-ref (vector-ref p 31) i)))
                    ;; to where it can stand by it (its approach), else its point
                    (if a
                        (guard-notice! g DEVICE-NOTICE (vector-ref a 0) (vector-ref a 1) (vector-ref a 2))
                        (guard-notice! g DEVICE-NOTICE (device-x d) (device-y d) fz))
                    (incident! p (if (eq? (device-kind d) 'phone) 'phone-rang 'printer-ran) room)
                    (when (and (eq? (device-kind d) 'phone) (= (guard-state g) SEARCHING))
                      (let ((dx (- (guard-x g) (device-x d))) (dy (- (guard-y g) (device-y d))))
                        (when (< (+ (* dx dx) (* dy dy)) (* ANSWER-REACH ANSWER-REACH))
                          (devices-state-set! dv i 'idle 0.0))))))
                ;; changed and in plain view: a vent left running, blinds
                ;; moved, with the unit in their room (or its air volume)
                (let* ((d (vector-ref ds i)) (s (devices-state dv i)))
                  (when (and (or (and (eq? (device-kind d) 'vent) (eq? s 'on))
                                 (and (eq? (device-kind d) 'blinds) (eq? s 'closed)))
                             (same-space? data (room-at data (guard-x g) (guard-y g) (guard-z g)) (device-room d)))
                    (incident! p (if (eq? (device-kind d) 'vent) 'vent-running 'blinds-moved) (device-room d)))))
              (loop (+ i 1)))))))

    ;; --- cameras (design §4: Gibson's other eyes; observers only on floor 14) --------

    ;; A camera sees you as a unit would, weighed against the light on you,
    ;; but it is a lens: below CAMERA-DARK it sees nothing at all (a unit
    ;; still makes out a shape near it), and in dim light little. In its cone (the floor's fov and
    ;; range about its heading and pitch), with a clear line from the lens to
    ;; your chest or head, its awareness rises by CAMERA-GAIN times how
    ;; visible you are; out of it, it decays. At 1 it has you: the camera
    ;; alarms (its alarm part, the camera-alert sound), the incident is
    ;; logged, and Gibson sends his unit to where it saw you. The alarm
    ;; stays for the attempt.
    ;; P3 retune (David: "I can't tell when it sees me"): 1.5 -> 0.7, so fully
    ;; lit it takes about 1.4 s to be sure, a moment to see it coming (the
    ;; shell's pool warms, the eye's bar fills)
    (define CAMERA-GAIN 0.7)
    (define CAMERA-DECAY 0.3)
    (define CAMERA-DARK 0.12)       ; the guard's DARK-01
    ;; a lens is poor in dim light: its gain rises from nothing at
    ;; CAMERA-DARK to full at CAMERA-FULL (how lit you are, 0..1)
    (define CAMERA-FULL 0.6)
    (define (camera-light l01) (min 1.0 (max 0.0 (/ (- l01 CAMERA-DARK) (- CAMERA-FULL CAMERA-DARK)))))
    (define CAMERA-CALL 0.65)       ; the unit's awareness a camera's alarm raises: SEARCHING there
    (define CAMERA-EVERY 3)         ; ticks between looks (the unit's PERCEIVE-EVERY)
    (define DEG (/ 3.141592653589793 180.0))

    (define (camera-views data)
      (list->vector
        (map (lambda (d)
               (and (eq? (device-kind d) 'camera)
                    (let* ((a (device-args d))
                           (h (* (device-facing d) DEG)) (pr (* (vector-ref a 2) DEG))
                           (cp (dcos pr)))
                      (vector (* cp (dcos h)) (* cp (dsin h)) (dsin pr)
                              (dcos (* 0.5 (vector-ref a 0) DEG)) (vector-ref a 1)))))
             (vector->list (play-devices data)))))

    (define (cameras! p)
      (when (= 0 (remainder (vector-ref p 9) CAMERA-EVERY))
        (let* ((data (vector-ref p 1)) (dv (vector-ref p 29)) (ds (play-devices data))
               (views (vector-ref p 34)) (aw (vector-ref p 33)) (t (vector-ref p 5))
               (coll (vector-ref (vector-ref p 2) 1)) (glass (play-glass data))
               (dt (* CAMERA-EVERY TICK)))
          (let loop ((i 0))
            (when (< i (vector-length ds))
              (let ((v (vector-ref views i)))
                (when v
                  (let* ((d (vector-ref ds i))
                         (cx (device-x d)) (cy (device-y d)) (cz (device-z d))
                         (ax (vector-ref v 0)) (ay (vector-ref v 1)) (az (vector-ref v 2))
                         (px (vector-ref t 0)) (py (vector-ref t 1)) (pz (vector-ref t 2))
                         (chest (+ pz (* 0.55 (vector-ref t 4)))) (head (vector-ref t 3))
                         (dx (- px cx)) (dy (- py cy)) (dz (- chest cz))
                         (dist (sqrt (+ (* dx dx) (* dy dy) (* dz dz))))
                         (c (if (> dist 1e-6) (/ (+ (* dx ax) (* dy ay) (* dz az)) dist) 1.0))
                         ;; the lens is on the prop's front: start the line just past it
                         (ox (+ cx (* 0.12 ax))) (oy (+ cy (* 0.12 ay))) (oz (+ cz (* 0.12 az)))
                         (seen (and (< dist (vector-ref v 4))
                                    (>= c (vector-ref v 3))
                                    (>= (vector-ref t 5) CAMERA-DARK)
                                    (or (sight-clear? coll glass ox oy oz px py chest)
                                        (sight-clear? coll glass ox oy oz px py head))))
                         (a (vector-ref aw i))
                         (a (if seen
                                (min 1.0 (+ a (* CAMERA-GAIN (vector-ref t 6) (camera-light (vector-ref t 5)) dt)))
                                (max 0.0 (- a (* CAMERA-DECAY dt))))))
                    (vector-set! aw i a)
                    (cond
                      ((eq? (devices-state dv i) 'alarmed) #f)
                      ((>= a 1.0)
                       (devices-state-set! dv i 'alarmed 0.0)
                       (event! p 'camera-alert cx cy)
                       (incident! p 'camera-saw (vector-ref p 22))
                       (guard-notice! (vector-ref p 3) CAMERA-CALL px py pz))
                      ;; its awareness rides in its timer: (seeing A) for the shell
                      (else (devices-state-set! dv i (if seen 'seeing 'idle) a))))))
              (loop (+ i 1)))))))

    ;; Rooms a and b are one space: the same room, or one air volume (the
    ;; lobby and the mezzanine over it).
    (define (same-space? data a b)
      (and (>= a 0) (>= b 0)
           (or (= a b)
               (= (room-group (vector-ref (play-rooms data) a)) (room-group (vector-ref (play-rooms data) b))))))

    ;; The deck, once a tick with held? its hold (the caller's input) and on?
    ;; the circuits' state: aims from the walker's eye, steps the hold, and
    ;; runs a completed command on a device. Returns what happened:
    ;;   (hold) (deny INDEX) (run INDEX COMMAND) as deck-step! says
    ;;   (lights CIRCUIT lights-off|lights-on)  a light's zone switched: the
    ;;                                    caller switches it (the renderer
    ;;                                    holds the state, as for a panel)
    ;;   #f
    (define (play-deck! p w held? on?)
      (if (not (eq? (vector-ref p 8) 'playing))
          #f
          (let* ((data (vector-ref p 1)) (dv (vector-ref p 29)) (k (vector-ref p 30))
                 (coll (vector-ref (vector-ref p 2) 1)))
            (deck-aim! k dv coll (play-glass data) (walker-eye-x w) (walker-eye-y w) (walker-eye-z w)
                       (walker-yaw w) (walker-pitch w))
            (let ((r (deck-step! k dv held? (play-tier p) TICK on?)))
              (if (pair? r)
                  (case (car r)
                    ((hold) (event! p 'deck-hold (walker-x w) (walker-y w)) r)
                    ((deny) (event! p 'deck-deny (walker-x w) (walker-y w)) r)
                    ((run)
                     (event! p 'deck-confirm (walker-x w) (walker-y w))
                     (let ((c (deck-circuit k dv)))
                       (if c
                           ;; a lighting zone: the panel's click, where you are
                           (begin (event! p (if (eq? (caddr r) 'lights-off) 'panel-off 'panel-on) (walker-x w) (walker-y w))
                                  (list 'lights c (caddr r)))
                           (let* ((i (cadr r)) (d (vector-ref (play-devices data) i))
                                  (ev (devices-run! dv i (caddr r))))
                             (when ev (event! p ev (device-x d) (device-y d)))
                             r))))
                    (else r))
                  r)))))

    ;; --- incidents (design §5, D19) ------------------------------------------------

    ;; An incident is anything out of the ordinary a guard noticed: you (his
    ;; state rising to SUSPICIOUS or beyond, by sight or by ear), or an
    ;; effect of something you did (a room whose switchable light was on
    ;; when the attempt began and is off now, with the guard in it). Each
    ;; kind is logged once per room. A trick
    ;; nobody noticed is not an incident: a light switched off and back on
    ;; while no guard was in its room logs nothing.
    (define (incident! p kind room)
      (let ((name (if (>= room 0) (room-name (vector-ref (play-rooms (vector-ref p 1)) room)) 'none)))
        (unless (member (list kind name) (vector-ref p 24))
          (vector-set! p 24 (cons (list kind name) (vector-ref p 24))))))

    (define (notice! p on?)
      (unless (vector-ref p 28)
        (vector-set! p 28 (filter on? (map car (filter (lambda (c) (list-ref c 6)) (vector-ref p 6))))))
      (let* ((g (vector-ref p 3)) (data (vector-ref p 1))
             (state (guard-state g)) (was (vector-ref p 25))
             (groom (room-at data (guard-x g) (guard-y g) (guard-z g))))
        ;; you: the moment he turns suspicious or worse, when it was you he
        ;; sensed (a rise from something else, the dark room, is not you)
        (when (and (>= state SUSPICIOUS) (< was SUSPICIOUS))
          (cond ((guard-sees? g) (incident! p 'you-seen (vector-ref p 22)))
                ((guard-heard? g) (incident! p 'you-heard (vector-ref p 22)))))
        ;; a dark room: his room's light is a switchable circuit that is off
        (when (>= groom 0)
          (let* ((c (room-circuit (vector-ref (play-rooms data) groom)))
                 (sw (and c (assq c (vector-ref p 6)))))
            (when (and sw (list-ref sw 6) (memq c (vector-ref p 28)) (not (on? c)))
              (unless (member (list 'dark-room (room-name (vector-ref (play-rooms data) groom))) (vector-ref p 24))
                (incident! p 'dark-room groom)
                ;; he comes to check: to the circuit's panel if it has one
                (let ((panel (assq c (play-panels data))))
                  (if panel
                      (guard-notice! g 0.65 (cadr panel) (caddr panel) 0.0)
                      (guard-notice! g 0.65 (guard-x g) (guard-y g) (guard-z g))))))))
        (speak! p was state)
        (vector-set! p 25 state)
        (vector-set! p 26 groom)))

    ;; Robot speak (S1, the device API §4 v9): one event on each change of
    ;; the unit's state, at its position, for a garbled mutter.
    ;;   robot-suspicious  calm to suspicious (the "?")
    ;;   robot-searching   into searching (from calm too: a device heard)
    ;;   robot-there       into hunting (it has you)
    ;;   robot-lost        a hunt given up (to searching), or a search (to calm)
    ;;   robot-back        back on its route: at a route point after a search,
    ;;                     or at once from suspicious (it never left it)
    (define (speak! p was state)
      (let* ((g (vector-ref p 3)) (x (guard-x g)) (y (guard-y g)))
        (unless (= was state)
          (cond
            ((= state HUNTING) (event! p 'robot-there x y))
            ((and (= state SEARCHING) (= was HUNTING)) (event! p 'robot-lost x y))
            ((= state SEARCHING) (event! p 'robot-searching x y))
            ((and (= state SUSPICIOUS) (= was CALM)) (event! p 'robot-suspicious x y))
            ((and (= state CALM) (= was SUSPICIOUS)) (event! p 'robot-back x y))
            ((= state CALM) (event! p 'robot-lost x y) (vector-set! p 36 #t))))
        ;; heading back after a search: at a route point, it is back
        (when (and (vector-ref p 36) (= state CALM))
          (let ((r (guard-world-route (vector-ref p 2))))
            (let loop ((k 0))
              (when (< k (vector-length r))
                (let ((dx (- x (vector-ref r k))) (dy (- y (vector-ref r (+ k 1)))))
                  (if (< (+ (* dx dx) (* dy dy)) 0.36)
                      (begin (vector-set! p 36 #f) (event! p 'robot-back x y))
                      (loop (+ k 2))))))))
        (when (> state CALM) (vector-set! p 36 #f))))

    ;; The patch note (design §5): up to two patches, the most serious first,
    ;; each (system-line gibson-line). A badge seen in use is always one.
    (define PATCHES
      '((badge-seen "BADGE REVOKED: FACILITIES" "Nice badge. It isn't yours anymore.")
        (you-seen "PATROLS TIGHTENED" "Found you. Now I know what you look like.")
        (you-heard "PATROLS TIGHTENED" "You walk loudly for a ghost.")
        ;; P3: seen by a camera ranks with being seen
        (camera-saw "CAMERA COVERAGE EXTENDED" "Smile. You were on my camera.")
        (dark-room "EMERGENCY LIGHTING: ~" "You like the dark. I've fixed the dark.")
        ;; P3 (the device API, §5), drafts for David (D18)
        (phone-rang "PHONES MUTED ON THIS FLOOR" "Nobody was calling. I know who dialled.")
        (printer-ran "PRINTERS LOCKED" "Print jobs from nobody. Cute.")
        (vent-running "HVAC OVERRIDES REVOKED" "Loud in here, wasn't it? Not anymore.")
        (blinds-moved "BLINDS LOCKED" "Keeping the city out? It's my city.")))
    (define DUCT-PATCH '("DUCT GRATES BOLTED" "Crawling through my walls? I've bolted them."))

    (define (patch-for inc)
      (let ((kind (car inc)) (room (cadr inc)))
        (if (and (memq kind '(you-seen you-heard)) (eq? room 'duct))
            DUCT-PATCH
            (let ((e (assq kind PATCHES)))
              (list (subst-room (cadr e) room) (caddr e))))))
    (define (subst-room s room)
      (let loop ((i 0))
        (cond ((>= i (string-length s)) s)
              ((char=? (string-ref s i) #\~)
               (string-append (substring s 0 i) (upcase (symbol->string room)) (substring s (+ i 1) (string-length s))))
              (else (loop (+ i 1))))))
    (define (upcase s) (list->string (map (lambda (ch) (if (char=? ch #\-) #\space (char-upcase ch))) (string->list s))))

    ;; The patches, as ((system-line gibson-line) ...), at most two, by the
    ;; order of PATCHES (the duct's with you), one per system line.
    (define (play-patches p)
      (let* ((incs (play-incidents p))
             (rank (lambda (inc) (let loop ((ks (map car PATCHES)) (i 0))
                                   (cond ((null? ks) 99) ((eq? (car ks) (car inc)) i) (else (loop (cdr ks) (+ i 1)))))))
             (sorted (list-sort (lambda (a b) (< (rank a) (rank b))) incs)))
        (let loop ((is sorted) (acc '()))
          (if (or (null? is) (= (length acc) 2))
              (reverse acc)
              (let ((pt (patch-for (car is))))
                (loop (cdr is) (if (assoc (car pt) acc) acc (cons pt acc))))))))

    ;; --- use (F; the phone's USE) ------------------------------------------------------

    ;; Use what is within reach: a circuit's light panel, the stairwell door's
    ;; card reader. Returns what happened:
    ;;   (panel-on C) (panel-off C)  the circuit C switched (the caller
    ;;                               switches it: the renderer holds the state)
    ;;   (panel-deny C)              the panel wants a credential you lack
    ;;   (reader-ok)                 the badge opens the stairwell door: won
    ;;   (reader-deny)               no badge
    ;;   ()                          nothing in reach
    ;; on? is the circuits' state, as play-tick! takes it.
    (define (play-use! p w on?)
      (if (not (eq? (vector-ref p 8) 'playing))
          '()
          (let* ((data (vector-ref p 1)) (x (walker-x w)) (y (walker-y w)) (z (walker-z w))
                 (reach? (lambda (px py) (let ((dx (- x px)) (dy (- y py)))
                                          (and (< z 0.5) (< (+ (* dx dx) (* dy dy)) (* USE-REACH USE-REACH))))))
                 (panel (let find ((ps (play-panels data)))
                          (cond ((null? ps) #f) ((reach? (cadr (car ps)) (caddr (car ps))) (car ps)) (else (find (cdr ps))))))
                 (exit (play-exit data))
                 (term (terminal-at data x y z)))
            (cond
              ((>= term 0)
               (terminal-open! p term)
               (event! p 'terminal-open (device-x (vector-ref (play-devices data) term)) (device-y (vector-ref (play-devices data) term)))
               (list 'terminal-open))
              (panel
               (let ((c (car panel)) (needs (cadddr panel)))
                 (cond ((and needs (not (vector-ref p 7)))
                        (event! p 'reader-deny (cadr panel) (caddr panel))
                        (list 'panel-deny c))
                       ((on? c) (event! p 'panel-off (cadr panel) (caddr panel)) (list 'panel-off c))
                       (else (event! p 'panel-on (cadr panel) (caddr panel)) (list 'panel-on c)))))
              ((reach? (vector-ref exit 0) (vector-ref exit 1))
               (if (vector-ref p 7)
                   (begin
                     ;; a badge seen in use is always patched (design §5)
                     (when (guard-sees? (vector-ref p 3)) (incident! p 'badge-seen (vector-ref p 22)))
                     (event! p 'reader-ok (vector-ref exit 0) (vector-ref exit 1))
                     (event! p 'door-open (vector-ref exit 0) (vector-ref exit 1))
                     (vector-set! p 8 'won)
                     (list 'reader-ok))
                   (begin (event! p 'reader-deny (vector-ref exit 0) (vector-ref exit 1))
                          (list 'reader-deny))))
              (else '())))))

    ;; --- the terminal (design §3; the device API §3) ------------------------------

    ;; F at a terminal opens it; you hold still at it while the floor goes
    ;; on. It lists every device and lighting zone with the command it would
    ;; run, whether your tier allows it, and the tier it needs; a command
    ;; takes TERMINAL-TIME (longer than the deck's hold, but from anywhere and
    ;; with no line of sight) and the screen lights you (TERMINAL-LIGHT, a
    ;; floor under how lit you are) while it is open.
    (define TERMINAL-TIME 2.5)
    (define TERMINAL-LIGHT 0.6)
    (define TERMINAL-REACH 1.4)     ; m from the terminal, horizontally
    (define TERMINAL-SHOW 1.5)      ; s the status shows done or denied

    (define (terminal-targets data)
      (let* ((ds (vector->list (play-devices data)))
             (idx (let loop ((i 0) (l ds) (acc '()))
                    (if (null? l) (reverse acc)
                        (loop (+ i 1) (cdr l) (if (eq? (device-kind (car l)) 'terminal) acc (cons (cons 'device i) acc))))))
             (circuits (let loop ((l (vector->list (play-fixtures data))) (acc '()))
                         (cond ((null? l) (reverse acc))
                               ((memq (vector-ref (car l) 3) acc) (loop (cdr l) acc))
                               (else (loop (cdr l) (cons (vector-ref (car l) 3) acc)))))))
        (list->vector (append idx (map (lambda (c) (cons 'zone c)) circuits)))))

    (define (terminal-reset! tm)
      (vector-set! tm 0 #f) (vector-set! tm 1 0) (vector-set! tm 2 -1) (vector-set! tm 3 0.0)
      (vector-set! tm 4 '(idle)) (vector-set! tm 5 0.0))

    ;; the terminal device within reach of (x y z), or -1
    (define (terminal-at data x y z)
      (let ((ds (play-devices data)))
        (let loop ((i 0))
          (cond ((>= i (vector-length ds)) -1)
                ((and (eq? (device-kind (vector-ref ds i)) 'terminal) (< z 0.5)
                      (let ((dx (- x (device-x (vector-ref ds i)))) (dy (- y (device-y (vector-ref ds i)))))
                        (< (+ (* dx dx) (* dy dy)) (* TERMINAL-REACH TERMINAL-REACH))))
                 i)
                (else (loop (+ i 1)))))))

    (define (terminal-open! p i)
      (let ((tm (vector-ref p 35)))
        (terminal-reset! tm)
        (vector-set! tm 0 #t)
        (devices-state-set! (vector-ref p 29) i 'in-use 0.0)))

    (define (terminal-close! p)
      (let* ((tm (vector-ref p 35)) (data (vector-ref p 1)) (ds (play-devices data)))
        (terminal-reset! tm)
        (let loop ((i 0))
          (when (< i (vector-length ds))
            (when (eq? (device-kind (vector-ref ds i)) 'terminal)
              (devices-state-set! (vector-ref p 29) i 'idle 0.0)
              (event! p 'terminal-close (device-x (vector-ref ds i)) (device-y (vector-ref ds i))))
            (loop (+ i 1))))))

    ;; A row's ID, kind, command (by on?, the circuits' state) and tier.
    (define (row-of p target on?)
      (let ((dv (vector-ref p 29)) (data (vector-ref p 1)))
        (if (eq? (car target) 'device)
            (let ((d (vector-ref (play-devices data) (cdr target))))
              (list (device-id d) (device-kind d) (devices-command dv (cdr target)) (device-tier d)))
            (let ((c (cdr target)))
              (list (string->symbol (string-append "lights-" (symbol->string c))) 'lights
                    (if (on? c) 'lights-off 'lights-on) 'facilities)))))

    ;; For the shell (the API, §3): (ROWS SELECTED STATUS), each row
    ;; (ID KIND COMMAND-OR-#f ALLOWED? TIER).
    (define (play-terminal p on?)
      (let* ((tm (vector-ref p 35)) (tier (play-tier p)))
        (list (map (lambda (t)
                     (let ((r (row-of p t on?)))
                       (list (car r) (cadr r) (caddr r) (and (caddr r) (tier-allows? tier (cadddr r)) #t) (cadddr r))))
                   (vector->list (vector-ref tm 6)))
              (vector-ref tm 1)
              (let ((st (vector-ref tm 4)))
                (if (>= (vector-ref tm 2) 0) (list 'running (vector-ref tm 3)) st)))))

    ;; A key at the open terminal: up, down, run or close. Returns #t.
    (define (play-terminal-key! p key on?)
      (let* ((tm (vector-ref p 35)) (n (vector-length (vector-ref tm 6))) (running (>= (vector-ref tm 2) 0)))
        (case key
          ((up) (unless running (vector-set! tm 1 (max 0 (- (vector-ref tm 1) 1)))))
          ((down) (unless running (vector-set! tm 1 (min (- n 1) (+ (vector-ref tm 1) 1)))))
          ((close) (terminal-close! p))
          ((run)
           (unless running
             (let* ((sel (vector-ref tm 1)) (r (row-of p (vector-ref (vector-ref tm 6) sel) on?)))
               (cond ((not (caddr r)) #f)
                     ((not (tier-allows? (play-tier p) (cadddr r)))
                      (vector-set! tm 4 (list 'denied (car r))) (vector-set! tm 5 TERMINAL-SHOW)
                      (event! p 'deck-deny (or (vector-ref p 17) 0.0) (or (vector-ref p 18) 0.0)))
                     (else
                      (vector-set! tm 2 sel) (vector-set! tm 3 0.0)
                      (event! p 'deck-hold (or (vector-ref p 17) 0.0) (or (vector-ref p 18) 0.0))))))))
        #t))

    ;; The open terminal, a tick on: a running command's progress, and at
    ;; TERMINAL-TIME it runs. Returns (run INDEX COMMAND) for a device (run
    ;; here), (lights CIRCUIT COMMAND) for a zone (the caller switches it),
    ;; or #f.
    (define (play-terminal-step! p on?)
      (let ((tm (vector-ref p 35)))
        (when (> (vector-ref tm 5) 0.0)
          (vector-set! tm 5 (max 0.0 (- (vector-ref tm 5) TICK)))
          (when (= (vector-ref tm 5) 0.0) (vector-set! tm 4 '(idle))))
        (if (or (not (vector-ref tm 0)) (< (vector-ref tm 2) 0))
            #f
            (begin
              (vector-set! tm 3 (+ (vector-ref tm 3) (/ TICK TERMINAL-TIME)))
              (if (< (vector-ref tm 3) 1.0)
                  #f
                  (let* ((target (vector-ref (vector-ref tm 6) (vector-ref tm 2)))
                         (r (row-of p target on?)) (cmd (caddr r)))
                    (vector-set! tm 2 -1) (vector-set! tm 3 0.0)
                    (vector-set! tm 4 (list 'done (car r) cmd)) (vector-set! tm 5 TERMINAL-SHOW)
                    (event! p 'deck-confirm (or (vector-ref p 17) 0.0) (or (vector-ref p 18) 0.0))
                    (cond
                      ((not cmd) #f)
                      ((eq? (car target) 'zone) (list 'lights (cdr target) cmd))
                      (else
                       (let* ((i (cdr target)) (d (vector-ref (play-devices (vector-ref p 1)) i))
                              (ev (devices-run! (vector-ref p 29) i cmd)))
                         (when ev (event! p ev (device-x d) (device-y d)))
                         (list 'run i cmd))))))))))

    (define (near-badge? data x y z)
      (let* ((b (play-badge data))
             (dx (- x (vector-ref b 0))) (dy (- y (vector-ref b 1))))
        (and (< (+ (* dx dx) (* dy dy)) (* PICKUP-REACH PICKUP-REACH))
             (< (abs (- z 0.0)) 0.5))))

    (define (near-exit? data x y z)
      (let* ((e (play-exit data))
             (dx (- x (vector-ref e 0))) (dy (- y (vector-ref e 1))))
        (and (< (+ (* dx dx) (* dy dy)) (* EXIT-REACH EXIT-REACH))
             (< z 0.5))))))
