;;; (phantom play data) - What P1's guard and game loop read from a floor:
;;; its play.sexp (scripts/play-import.mjs), read once at load.
;;;
;;;   guards   one patrol: its route ((x y) ...) and the wait at each point
;;;   start    where the runner arrives, and facing
;;;   exit     the stairwell door, and the badge it wants
;;;   badge    the facilities badge on the FM office's desk (x y z)
;;;   glass    the collision's glass triangles, which sight passes through
;;;   light    the floor's baked per-vertex circuit light, sampled on a grid
;;;            over every upward surface: per cell, one layer per floor
;;;            height (the lobby and the mezzanine over it), each with the
;;;            intensity of circuits 0 to 5 there
;;;
;;; The light grid answers "how much of each circuit reaches the floor where
;;; you stand"; (phantom play light) turns that and the live circuit state
;;; into how lit you are. Everything here is plain vectors and numbers, read
;;; once, so the per-tick lookups allocate nothing.

(define-library (phantom play data)
  (import (sigil core)
          (sigil math)
          (sigil io))

  (export play-data-from-string play-data?
          play-route play-waits play-start play-exit play-badge play-badge-drawer? play-glass
          light-cell light-grid-x0 light-grid-y0 light-grid-w light-grid-h
          light-sample! light-sample-z NCIRCUITS
          play-rooms play-edges play-surface-noise play-surface-name play-panels play-reader play-noise-ambient
          room-at room-count
          room-name room-floor room-ceiling room-group room-circuit room-crouch-only?
          edge-kind edge-a edge-b edge-x edge-y edge-width edge-zlo edge-zhi edge-walk edge-sight edge-sound edge-needs
          play-devices device-count device-id device-kind device-x device-y device-z device-facing device-tier
          device-room device-args device-index
          play-fixtures fixture-count
          play-nav-bounds play-units unit-count unit-route unit-waits
          play-lessons lesson-count lesson-id lesson-rooms lesson-x lesson-y lesson-facing lesson-goal
          lesson-on-enter lesson-on-success lesson-on-fail room-index-named)

  (begin

    (define NCIRCUITS 6)
    (define LAYER 7)                ; z, then circuits 0..5

    ;; The data: a vector
    ;;  0 tag  1 route (vector of x y pairs, flat)  2 waits (vector)
    ;;  3 start (x y facing)  4 exit (x y)  5 badge (x y z)
    ;;  6 glass (flat vector, 9 per triangle)
    ;;  7 cell  8 x0  9 y0  10 w  11 h
    ;;  12 starts (vector w*h + 1: each cell's first layer)
    ;;  13 layers (flat vector, LAYER per layer)
    ;;  14 the z of the last sample
    ;;  P2: 15 rooms (vector of room vectors)  16 edges (vector of edge vectors)
    ;;  17 surfaces (vector by the collision's surface tag: (name . noise-class-or-#f))
    ;;  18 panels ((circuit x y needs) ...)  19 the exit's reader (a symbol or #f)
    ;;  20 noise ambient (an alist)  21 room grid starts  22 room grid layers
    ;;  (z room, 2 per layer; on the light grid's cells)
    ;;  P3: 23 devices (vector of device vectors, in play.sexp's order)
    ;;  24 fixtures: the switchable ceiling lights, #(x y z circuit) each
    ;;  PRACTICE: 25 the guards' nav bounds #(x0 y0 x1 y1) (floor 14's when
    ;;  play.sexp has none)  26 the units: a vector of #(route waits), each as
    ;;  slots 1 and 2 hold the first (the sim has one in several rooms)
    ;;  27 the lessons (PRACTICE; empty on a real floor): a vector of
    ;;  #(id rooms x y facing goal on-enter on-success on-fail), rooms a
    ;;  vector of room indices, goal the floor file's list
    (define (play-data? d) (and (vector? d) (= (vector-length d) 28) (eq? (vector-ref d 0) 'play-data)))
    (define (play-lessons d) (vector-ref d 27))
    (define (lesson-count d) (vector-length (vector-ref d 27)))
    (define (lesson-id l) (vector-ref l 0))
    (define (lesson-rooms l) (vector-ref l 1))
    (define (lesson-x l) (vector-ref l 2))
    (define (lesson-y l) (vector-ref l 3))
    (define (lesson-facing l) (vector-ref l 4))
    (define (lesson-goal l) (vector-ref l 5))
    (define (lesson-on-enter l) (vector-ref l 6))
    (define (lesson-on-success l) (vector-ref l 7))
    (define (lesson-on-fail l) (vector-ref l 8))
    ;; the index of the room named name, or -1
    (define (room-index-named d name)
      (let ((rs (vector-ref d 15)))
        (let loop ((i 0))
          (cond ((>= i (vector-length rs)) -1)
                ((eq? (room-name (vector-ref rs i)) name) i)
                (else (loop (+ i 1)))))))
    (define (play-nav-bounds d) (vector-ref d 25))
    (define (play-units d) (vector-ref d 26))
    (define (unit-count d) (vector-length (vector-ref d 26)))
    (define (unit-route u) (vector-ref u 0))
    (define (unit-waits u) (vector-ref u 1))
    (define (play-fixtures d) (vector-ref d 24))
    (define (fixture-count d) (vector-length (vector-ref d 24)))
    (define (play-rooms d) (vector-ref d 15))
    (define (play-edges d) (vector-ref d 16))
    (define (play-surface-noise d) (vector-ref d 17))
    ;; the surface name for a collision tag (tile when unknown)
    (define (play-surface-name d tag)
      (let ((v (vector-ref d 17)))
        (if (and (>= tag 0) (< tag (vector-length v))) (car (vector-ref v tag)) 'tile)))
    (define (play-panels d) (vector-ref d 18))
    (define (play-reader d) (vector-ref d 19))
    (define (play-noise-ambient d) (vector-ref d 20))
    (define (room-count d) (vector-length (vector-ref d 15)))
    (define (play-devices d) (vector-ref d 23))
    (define (device-count d) (vector-length (vector-ref d 23)))

    ;; a device (topics/phantom-burn-device-api §1):
    ;; #(id kind x y z facing tier room args), args a vector: a camera's
    ;; (fov range pitch) with facing its heading (degrees from +x,
    ;; counter-clockwise); the blinds' window edge (x0 y0 x1 y1)
    (define (device-id v) (vector-ref v 0))
    (define (device-kind v) (vector-ref v 1))
    (define (device-x v) (vector-ref v 2))
    (define (device-y v) (vector-ref v 3))
    (define (device-z v) (vector-ref v 4))
    (define (device-facing v) (vector-ref v 5))
    (define (device-tier v) (vector-ref v 6))
    (define (device-room v) (vector-ref v 7))
    (define (device-args v) (vector-ref v 8))
    ;; the index of the device named id, or -1
    (define (device-index d id)
      (let ((ds (vector-ref d 23)))
        (let loop ((i 0))
          (cond ((>= i (vector-length ds)) -1)
                ((eq? (device-id (vector-ref ds i)) id) i)
                (else (loop (+ i 1)))))))

    ;; a room: #(index name floor ceiling group circuit crouch-only?)
    (define (room-name r) (vector-ref r 1))
    (define (room-floor r) (vector-ref r 2))
    (define (room-ceiling r) (vector-ref r 3))
    (define (room-group r) (vector-ref r 4))
    (define (room-circuit r) (vector-ref r 5))
    (define (room-crouch-only? r) (vector-ref r 6))
    ;; an edge: #(kind a b x y width zlo zhi walk sight sound needs), b -1 outside
    (define (edge-kind e) (vector-ref e 0))
    (define (edge-a e) (vector-ref e 1))
    (define (edge-b e) (vector-ref e 2))
    (define (edge-x e) (vector-ref e 3))
    (define (edge-y e) (vector-ref e 4))
    (define (edge-width e) (vector-ref e 5))
    (define (edge-zlo e) (vector-ref e 6))
    (define (edge-zhi e) (vector-ref e 7))
    (define (edge-walk e) (vector-ref e 8))
    (define (edge-sight e) (vector-ref e 9))
    (define (edge-sound e) (vector-ref e 10))
    (define (edge-needs e) (vector-ref e 11))

    ;; The room of the floor under (x, y) for feet at z: the highest room
    ;; layer at or below z + 0.4, or -1.
    (define (room-at d x y z)
      (let ((k (cell-of d x y)))
        (if (< k 0)
            -1
            (let* ((starts (vector-ref d 21)) (layers (vector-ref d 22))
                   (a (vector-ref starts k)) (b (vector-ref starts (+ k 1))))
              (let pick ((i a) (best -1) (bz -1e9))
                (if (< i b)
                    (let ((lz (vector-ref layers (* 2 i))))
                      (if (and (<= lz (+ z 0.4)) (> lz bz))
                          (pick (+ i 1) (vector-ref layers (+ (* 2 i) 1)) lz)
                          (pick (+ i 1) best bz)))
                    best))))))
    (define (play-route d) (vector-ref d 1))
    (define (play-waits d) (vector-ref d 2))
    (define (play-start d) (vector-ref d 3))
    (define (play-exit d) (vector-ref d 4))
    (define (play-badge d) (vector-ref d 5))
    ;; the badge is in its desk's drawer, taken with use (Phantom 0.1)
    (define (play-badge-drawer? d)
      (let ((b (vector-ref d 5))) (and (> (vector-length b) 3) (eq? (vector-ref b 3) 'drawer))))
    (define (play-glass d) (vector-ref d 6))
    (define (light-cell d) (vector-ref d 7))
    (define (light-grid-x0 d) (vector-ref d 8))
    (define (light-grid-y0 d) (vector-ref d 9))
    (define (light-grid-w d) (vector-ref d 10))
    (define (light-grid-h d) (vector-ref d 11))
    (define (light-sample-z d) (vector-ref d 14))

    (define (entry datum key)
      (let ((e (assq key datum)))
        (unless e (error (string-append "play.sexp: no (" (symbol->string key) " ...)")))
        (cdr e)))

    (define (flo x) (* 1.0 x))
    (define (drop l n) (if (= n 0) l (drop (cdr l) (- n 1))))

    ;; The play.sexp text as play data, or an error naming what is missing.
    (define (play-data-from-string s)
      (let* ((datum (read (open-input-string s)))
             (_ (unless (pair? datum) (error "play.sexp: not a list")))
             (guard (car (entry datum 'guards)))
             (_ (unless (and (pair? guard) (eq? (car guard) 'patrol))
                  (error "play.sexp: the first guard is not a patrol")))
             (points (cadr guard))
             (waits (caddr guard))
             (route (list->vector (apply append (map (lambda (p) (list (flo (car p)) (flo (cadr p)))) points))))
             (glass (list->vector (map flo (entry datum 'glass))))
             (light (entry datum 'light))
             (cell (flo (list-ref light 0)))
             (x0 (flo (list-ref light 1)))
             (y0 (flo (list-ref light 2)))
             (w (list-ref light 3))
             (h (list-ref light 4))
             (n (list-ref light 5))
             (starts (make-vector (+ 1 (* w h)) 0))
             (layers (make-vector (* LAYER n) 0.0))
             (rg (read-room-grid datum w h)))
        (unless (= (length points) (length waits))
          (error "play.sexp: the guard's route and waits differ in length"))
        (unless (= (remainder (vector-length glass) 9) 0)
          (error "play.sexp: the glass is not whole triangles"))
        ;; the layers, sorted by cell: count per cell, then prefix sums
        (let fill ((rest (drop light 6)) (i 0) (prev -1))
          (cond ((null? rest)
                 (unless (= i n) (error "play.sexp: the light grid has fewer layers than it says")))
                ((>= i n) (error "play.sexp: the light grid has more layers than it says"))
                (else
                 (let ((k (car rest)))
                   (when (or (< k prev) (< k 0) (>= k (* w h)))
                     (error "play.sexp: a light cell is out of order or out of range"))
                   (vector-set! starts (+ k 1) (+ (vector-ref starts (+ k 1)) 1))
                   (let copy ((j 0) (vs (cdr rest)))
                     (if (< j LAYER)
                         (begin
                           (vector-set! layers (+ (* LAYER i) j) (flo (car vs)))
                           (copy (+ j 1) (cdr vs)))
                         (fill vs (+ i 1) k)))))))
        (let sum ((k 1))
          (when (<= k (* w h))
            (vector-set! starts k (+ (vector-ref starts k) (vector-ref starts (- k 1))))
            (sum (+ k 1))))
        (vector 'play-data route (list->vector (map flo waits))
                (list->vector (map flo (entry datum 'start)))
                (list->vector (map flo (entry datum 'exit)))
                (list->vector (map (lambda (a) (if (symbol? a) a (flo a))) (entry datum 'badge)))
                glass cell x0 y0 w h starts layers 0.0
                (list->vector (map (lambda (r) (vector (car r) (cadr r) (flo (list-ref r 2)) (flo (list-ref r 3))
                                                       (list-ref r 4) (list-ref r 5) (list-ref r 6)))
                                   (entry datum 'rooms)))
                (list->vector (map (lambda (e) (vector (car e) (list-ref e 1) (list-ref e 2)
                                                       (flo (list-ref e 3)) (flo (list-ref e 4)) (flo (list-ref e 5))
                                                       (flo (list-ref e 6)) (flo (list-ref e 7)) (flo (list-ref e 8))
                                                       (flo (list-ref e 9)) (flo (list-ref e 10)) (list-ref e 11)))
                                   (entry datum 'edges)))
                (list->vector (map (lambda (s) (cons (car s) (cadr s))) (entry datum 'surfaces)))
                (map (lambda (p) (list (car p) (flo (cadr p)) (flo (caddr p)) (cadddr p))) (entry datum 'panels))
                (car (entry datum 'reader))
                (let pairs ((l (entry datum 'noise-ambient)))
                  (if (or (null? l) (null? (cdr l))) '() (cons (cons (car l) (flo (cadr l))) (pairs (cddr l)))))
                (car rg) (cdr rg)
                ;; P3's devices; a floor without them (P2's) has none
                (let ((e (assq 'devices datum)))
                  (list->vector
                    (map (lambda (v) (vector (car v) (cadr v) (flo (list-ref v 2)) (flo (list-ref v 3)) (flo (list-ref v 4))
                                             (flo (list-ref v 5)) (list-ref v 6) (list-ref v 7)
                                             (list->vector (map (lambda (a) (if (symbol? a) a (flo a))) (drop v 8)))))
                         (if e (cdr e) '()))))
                (let ((e (assq 'fixtures datum)))
                  (list->vector
                    (map (lambda (v) (vector (flo (car v)) (flo (cadr v)) (flo (caddr v)) (cadddr v)))
                         (if e (cdr e) '()))))
                (let ((e (assq 'nav datum)))
                  (if e (list->vector (map flo (cdr e))) (vector -0.5 -0.5 27.0 22.0)))
                (list->vector
                  (map (lambda (g)
                         (unless (and (pair? g) (eq? (car g) 'patrol) (= (length (cadr g)) (length (caddr g))))
                           (error "play.sexp: a guard is not a patrol with a wait per point"))
                         (vector (list->vector (apply append (map (lambda (p) (list (flo (car p)) (flo (cadr p)))) (cadr g))))
                                 (list->vector (map flo (caddr g)))))
                       (entry datum 'guards)))
                (let ((e (assq 'lessons datum)))
                  (list->vector
                    (map (lambda (l)
                           (vector (car l) (list->vector (cadr l)) (flo (list-ref l 2)) (flo (list-ref l 3))
                                   (flo (list-ref l 4)) (list-ref l 5) (list-ref l 6) (list-ref l 7) (list-ref l 8)))
                         (if e (cdr e) '())))))))

    ;; The room grid: (roomgrid N k z room ...) on the light grid's cells,
    ;; as (starts . layers).
    (define (read-room-grid datum w h)
      (let* ((rg (entry datum 'roomgrid))
             (n (car rg))
             (starts (make-vector (+ 1 (* w h)) 0))
             (layers (make-vector (* 2 n) 0.0)))
        (let fill ((rest (cdr rg)) (i 0) (prev -1))
          (unless (null? rest)
            (let ((k (car rest)))
              (when (or (< k prev) (>= k (* w h))) (error "play.sexp: a room cell is out of order or out of range"))
              (vector-set! starts (+ k 1) (+ 1 (vector-ref starts (+ k 1))))
              (vector-set! layers (* 2 i) (flo (cadr rest)))
              (vector-set! layers (+ 1 (* 2 i)) (caddr rest))
              (fill (cdddr rest) (+ i 1) k))))
        (let sum ((k 1))
          (when (<= k (* w h))
            (vector-set! starts k (+ (vector-ref starts k) (vector-ref starts (- k 1))))
            (sum (+ k 1))))
        (cons starts layers)))

    ;; The grid cell of (x, y), or -1 off the grid.
    (define (cell-of d x y)
      (let ((col (exact (floor (/ (- x (vector-ref d 8)) (vector-ref d 7)))))
            (row (exact (floor (/ (- y (vector-ref d 9)) (vector-ref d 7))))))
        (if (and (>= col 0) (< col (vector-ref d 10)) (>= row 0) (< row (vector-ref d 11)))
            (+ (* row (vector-ref d 10)) col)
            -1)))

    ;; The light at the floor under (x, y) for feet at z: the highest layer
    ;; at or below z + 0.4 (the floor you stand on, not the mezzanine over
    ;; you), each circuit's intensity into out (a vector of NCIRCUITS).
    ;; Returns #t, or #f with out zeroed where no floor was sampled.
    (define (light-sample! d x y z out)
      (vector-fill! out 0.0)
      (let ((k (cell-of d x y)))
        (if (< k 0)
            #f
            (let* ((starts (vector-ref d 12))
                   (layers (vector-ref d 13))
                   (a (vector-ref starts k))
                   (b (vector-ref starts (+ k 1))))
              (let pick ((i a) (best -1))
                (if (< i b)
                    (let ((lz (vector-ref layers (* LAYER i))))
                      (pick (+ i 1)
                            (if (and (<= lz (+ z 0.4))
                                     (or (< best 0) (> lz (vector-ref layers (* LAYER best)))))
                                i
                                best)))
                    (if (< best 0)
                        #f
                        (begin
                          (vector-set! d 14 (vector-ref layers (* LAYER best)))
                          (let copy ((j 0))
                            (when (< j NCIRCUITS)
                              (vector-set! out j (vector-ref layers (+ (* LAYER best) 1 j)))
                              (copy (+ j 1))))
                          #t))))))))))
