;;; (phantom deck preview) - The native --deck-preview and --terminal-preview:
;;; the prompt and the terminal drawn from made-up data, before play's P3
;;; logic exists, for shots of the shell's half of the device API (v4). A
;;; play hook vector with nothing but a HUD: the runner walks freely.
;;;
;;; The map is floor 14's rooms and openings from floors/14-slice.floor, and
;;; the devices at the places the API note proposes; the compiler's outlines
;;; replace it once floor.sexp carries them.

(define-library (phantom deck preview)
  (import (sigil core)
          (sigil math)
          (sigil time)
          (phantom deck hud))

  (export deck-preview-hooks)

  (begin

    (define FLOOR-14
      '((outlines
         (lobby 0.0 (0 0) (12 0) (14 2) (14 10) (0 10))
         (corridor 0.0 (14 5) (22 13) (19 13) (14 8))
         (office 0.0 (16 13) (26 13) (26 17) (22 17) (22 21) (16 21))
         (fm-office 0.0 (22 17) (26 17) (26 21) (22 21))
         (mezzanine 3.0 (0 7) (12 7) (12 4) (14 4) (14 10) (0 10))
         (duct 3.0 (14 5) (23.4 14.4) (22.4 14.4) (14 6)))
        (openings
         (door 14 5.4 14 7.6)
         (door 19.9 13 21.1 13)
         (window 22 17 22 21)
         (door 23.55 17 24.45 17)
         (hatch 21.9 13.4 22.5 14.0)
         (window 1 0 11 0)
         (door 2.5 10 3.5 10))
        (devices
         (fm-phone phone 18.0 18.0 0.75 270 staff office)
         (printer printer 20.5 20.3 0.0 270 staff office)
         (corridor-vent vent 17.5 9.2 2.8 0 facilities corridor)
         (lobby-blinds blinds 6.0 0.1 3.0 90 facilities lobby 1 0 11 0)
         (lift-cam camera 0.3 3.5 2.7 0 security lobby 70.0 9.0 20.0)
         (fm-terminal terminal 24.0 19.5 0.75 270 staff fm-office))))

    ;; seconds since the preview first drew, so a shot's delay picks its state
    (define *t0* #f)
    (define (now)
      (let ((t (/ (* 1.0 (current-jiffy)) (jiffies-per-second))))
        (unless *t0* (set! *t0* t))
        (- t *t0*)))

    ;; the prompt: a 14 s round through what the deck can say
    (define (preview-deck t)
      (let* ((s (- t (* 14.0 (floor (/ t 14.0)))))
             (step (exact (floor (/ s 2.0)))) (f (/ (- s (* 2.0 step)) 2.0)))
        (case step
          ((0) '(staff fm-phone ring 0.0 ready))
          ((1) (list 'staff 'fm-phone 'ring (min 1.0 (/ f 0.8)) (if (< f 0.8) 'holding 'done)))
          ((2) '(staff fm-phone ring 0.0 done))
          ((3) '(staff corridor-vent vent-on 0.0 denied))
          ((4) '(staff printer print 0.0 blocked))
          ((5) '(staff #f #f 0.0 ready))
          (else '(facilities lobby-blinds blinds-close 0.0 ready)))))

    (define ROWS
      '((fm-phone phone ring #t staff)
        (printer printer print #t staff)
        (corridor-vent vent vent-on #f facilities)
        (lobby-blinds blinds blinds-close #f facilities)
        (lift-cam camera #f #f security)
        (lights-c1 terminal lights-off #f facilities)))

    (define (preview-terminal t)
      (let* ((sel (modulo (exact (floor (/ t 1.5))) (length ROWS)))
             (s (- t (* 8.0 (floor (/ t 8.0))))))
        (list ROWS sel
              (cond ((< s 2.0) '(idle))
                    ((< s 4.5) (list 'running (/ (- s 2.0) 2.5)))
                    ((< s 6.0) '(done fm-phone ring))
                    (else '(denied corridor-vent))))))

    (define (preview-devices t)
      (list (list 'fm-phone 'phone 18.0 18.0 0.75 (list 'ringing 3.0))
            (list 'printer 'printer 20.5 20.3 0.0 'running)
            (list 'corridor-vent 'vent 17.5 9.2 2.8 'off)
            (list 'lobby-blinds 'blinds 6.0 0.1 3.0 'open)
            (list 'lift-cam 'camera 0.3 3.5 2.7 (if (< (- t (floor t)) 0.5) 'seeing 'idle))
            (list 'fm-terminal 'terminal 24.0 19.5 0.75 'in-use)))

    ;; (hold? after-tick! frame! hud! key hold!): a HUD and nothing else
    (define (deck-preview-hooks terminal?)
      (when terminal? (deck-hud-use-map! FLOOR-14))
      (vector (lambda () #f)
              (lambda (w) #f)
              (lambda (alpha cam) #f)
              (lambda (w h k)
                (let ((t (now)))
                  (if terminal?
                      (terminal-draw! w h k (preview-terminal t) (preview-devices t))
                      (deck-hud-draw! w h k (preview-deck t)))))
              (lambda (key) #f)
              (lambda (held?) #f)))))
