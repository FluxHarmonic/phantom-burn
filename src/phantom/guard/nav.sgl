;;; (phantom guard nav) - Where a guard can walk, and the way to anywhere.
;;;
;;; The ground floor is rasterised once per floor load into a grid of CELL
;;; metres. A cell is walkable when the collision has a floor under its
;;; centre within a step of z 0, nothing overhead lower than a standing
;;; guard, and a guard's body (a cylinder GUARD-R wide) fits there without
;;; touching anything: walls, desks, the cabinet, the stair's sides. Guards
;;; stay on the ground (no stairs, no duct), which is why the duct and the
;;; mezzanine are places a hunt can lose you (design §5, "get into a vent").
;;;
;;; A field is a breadth-first distance from one target cell to every cell
;;; (8 neighbours; a diagonal only when both of its sides are walkable, so
;;; nothing cuts a corner). A guard steers by following the field downhill
;;; a few cells ahead and aiming at the farthest of them it can walk to in a
;;; straight line, which smooths the grid's staircase into straight walks.
;;;
;;; Everything is preallocated at load: building a field and steering
;;; allocate nothing, so a hunt can rebuild its field while it runs.

(define-library (phantom guard nav)
  (import (sigil core)
          (sigil math)
          (phantom collide))

  (export make-nav nav? nav-cell nav-w nav-h nav-walkable-count
          nav-walkable? nav-cell-of nav-cell-x nav-cell-y
          make-field field-target nav-field! nav-steer! nav-steer-x nav-steer-y
          nav-line-clear? nav-nearest-walkable GUARD-R NAV-CELL)

  (begin

    (define NAV-CELL 0.25)
    (define GUARD-R 0.3)
    (define GUARD-H 1.8)
    (define STEP-H 0.36)
    (define LOOKAHEAD 12)

    ;; The nav: a vector
    ;;  0 tag  1 x0  2 y0  3 w  4 h  5 walk (bytevector w*h, 1 walkable)
    ;;  6 queue (vector w*h)  7 steer x  8 steer y  9 walkable count
    (define (nav? n) (and (vector? n) (= (vector-length n) 10) (eq? (vector-ref n 0) 'nav)))
    (define (nav-cell n) NAV-CELL)
    (define (nav-w n) (vector-ref n 3))
    (define (nav-h n) (vector-ref n 4))
    (define (nav-walkable-count n) (vector-ref n 9))
    (define (nav-steer-x n) (vector-ref n 7))
    (define (nav-steer-y n) (vector-ref n 8))

    ;; The nav over [x0, x1] x [y0, y1] from the collision.
    (define (make-nav coll x0 y0 x1 y1)
      (let* ((w (+ 1 (exact (ceiling (/ (- x1 x0) NAV-CELL)))))
             (h (+ 1 (exact (ceiling (/ (- y1 y0) NAV-CELL)))))
             (walk (make-bytevector (* w h) 0)))
        (let rows ((r 0) (count 0))
          (if (< r h)
              (let cols ((c 0) (count count))
                (if (< c w)
                    (let* ((x (+ x0 (* NAV-CELL (+ c 0.5))))
                           (y (+ y0 (* NAV-CELL (+ r 0.5))))
                           (ok (cell-walkable? coll x y)))
                      (when ok (bytevector-u8-set! walk (+ (* r w) c) 1))
                      (cols (+ c 1) (if ok (+ count 1) count)))
                    (rows (+ r 1) count)))
              (vector 'nav (* 1.0 x0) (* 1.0 y0) w h walk (make-vector (* w h) 0) 0.0 0.0 count)))))

    (define (cell-walkable? coll x y)
      (let ((f (collide-floor coll x y -0.3 STEP-H)))
        (and f
             (not (collide-ceiling coll x y (+ f 0.05) (+ f GUARD-H)))
             (= 0 (collide-resolve! coll x y GUARD-R (+ f STEP-H) (+ f GUARD-H))))))

    ;; --- cells ------------------------------------------------------------------

    (define (nav-cell-of n x y)
      (let ((c (exact (floor (/ (- x (vector-ref n 1)) NAV-CELL))))
            (r (exact (floor (/ (- y (vector-ref n 2)) NAV-CELL)))))
        (if (and (>= c 0) (< c (vector-ref n 3)) (>= r 0) (< r (vector-ref n 4)))
            (+ (* r (vector-ref n 3)) c)
            -1)))
    (define (nav-cell-x n k) (+ (vector-ref n 1) (* NAV-CELL (+ 0.5 (remainder k (vector-ref n 3))))))
    (define (nav-cell-y n k) (+ (vector-ref n 2) (* NAV-CELL (+ 0.5 (quotient k (vector-ref n 3))))))

    (define (walk-at? n k)
      (and (>= k 0) (= 1 (bytevector-u8-ref (vector-ref n 5) k))))

    (define (nav-walkable? n x y) (walk-at? n (nav-cell-of n x y)))

    ;; The walkable cell nearest (x, y) within 2 m (by rings of cells), or -1.
    (define (nav-nearest-walkable n x y)
      (let ((k (nav-cell-of n x y)))
        (if (walk-at? n k)
            k
            (let* ((w (vector-ref n 3)) (h (vector-ref n 4))
                   (c0 (exact (floor (/ (- x (vector-ref n 1)) NAV-CELL))))
                   (r0 (exact (floor (/ (- y (vector-ref n 2)) NAV-CELL)))))
              (let ring ((d 1))
                (if (> d 8)
                    -1
                    (let scan ((dr (- d)) (best -1) (best-d2 1e30))
                      (if (> dr d)
                          (if (>= best 0) best (ring (+ d 1)))
                          (let col ((dc (- d)) (best best) (best-d2 best-d2))
                            (if (> dc d)
                                (scan (+ dr 1) best best-d2)
                                (let ((r (+ r0 dr)) (c (+ c0 dc)))
                                  (if (and (or (= (abs dr) d) (= (abs dc) d))
                                           (>= r 0) (< r h) (>= c 0) (< c w)
                                           (walk-at? n (+ (* r w) c)))
                                      (let* ((kk (+ (* r w) c))
                                             (dx (- (nav-cell-x n kk) x)) (dy (- (nav-cell-y n kk) y))
                                             (d2 (+ (* dx dx) (* dy dy))))
                                        (if (< d2 best-d2)
                                            (col (+ dc 1) kk d2)
                                            (col (+ dc 1) best best-d2)))
                                      (col (+ dc 1) best best-d2)))))))))))))

    ;; --- fields -----------------------------------------------------------------

    ;; A field: a vector (tag target dist...), dist -1 where unreachable.
    (define (make-field n) (vector 'field -1 (make-vector (* (vector-ref n 3) (vector-ref n 4)) -1)))
    (define (field-target f) (vector-ref f 1))
    (define (field-dist f) (vector-ref f 2))

    ;; Fill f with the distance (in steps) from the walkable cell nearest
    ;; (x, y); returns that cell, or -1 when there is none (f is then empty).
    (define (nav-field! n f x y)
      (let ((dist (vector-ref f 2))
            (q (vector-ref n 6))
            (w (vector-ref n 3))
            (h (vector-ref n 4))
            (t (nav-nearest-walkable n x y)))
        (vector-fill! dist -1)
        (vector-set! f 1 t)
        (when (>= t 0)
          (vector-set! dist t 0)
          (vector-set! q 0 t)
          (let loop ((head 0) (tail 1))
            (when (< head tail)
              (let* ((k (vector-ref q head))
                     (r (quotient k w)) (c (remainder k w))
                     (d (+ 1 (vector-ref dist k)))
                     (tail (visit! n dist q tail d r c 0 1 w h)))
                (let* ((tail (visit! n dist q tail d r c 0 -1 w h))
                       (tail (visit! n dist q tail d r c 1 0 w h))
                       (tail (visit! n dist q tail d r c -1 0 w h))
                       (tail (visit-diag! n dist q tail d r c 1 1 w h))
                       (tail (visit-diag! n dist q tail d r c 1 -1 w h))
                       (tail (visit-diag! n dist q tail d r c -1 1 w h))
                       (tail (visit-diag! n dist q tail d r c -1 -1 w h)))
                  (loop (+ head 1) tail))))))
        t))

    (define (visit! n dist q tail d r c dr dc w h)
      (let ((rr (+ r dr)) (cc (+ c dc)))
        (if (and (>= rr 0) (< rr h) (>= cc 0) (< cc w))
            (let ((k (+ (* rr w) cc)))
              (if (and (walk-at? n k) (< (vector-ref dist k) 0))
                  (begin (vector-set! dist k d) (vector-set! q tail k) (+ tail 1))
                  tail))
            tail)))

    (define (visit-diag! n dist q tail d r c dr dc w h)
      (let ((rr (+ r dr)) (cc (+ c dc)))
        (if (and (>= rr 0) (< rr h) (>= cc 0) (< cc w)
                 (walk-at? n (+ (* rr w) c))
                 (walk-at? n (+ (* r w) cc)))
            (visit! n dist q tail d r c dr dc w h)
            tail)))

    ;; --- steering ---------------------------------------------------------------

    ;; Where a body at (x, y) should head to follow f: the farthest of the
    ;; next LOOKAHEAD cells downhill that it can walk to in a straight line,
    ;; into (nav-steer-x n) (nav-steer-y n). Returns the steps left from the
    ;; body's cell to the target (0: there), or #f when f cannot reach it.
    (define (nav-steer! n f x y)
      (let* ((dist (vector-ref f 2))
             (k0 (nav-nearest-walkable n x y)))
        (cond
          ((or (< k0 0) (< (vector-ref dist k0) 0)) #f)
          ((= (vector-ref dist k0) 0)
           (vector-set! n 7 (nav-cell-x n k0))
           (vector-set! n 8 (nav-cell-y n k0))
           0)
          (else
           ;; aim at the first step, then at any later one that is in line
           (let walk ((k (downhill n dist k0)) (i 0))
             (when (and (>= k 0) (< i LOOKAHEAD))
               (when (or (= i 0) (nav-line-clear? n x y (nav-cell-x n k) (nav-cell-y n k)))
                 (vector-set! n 7 (nav-cell-x n k))
                 (vector-set! n 8 (nav-cell-y n k)))
               (unless (= (vector-ref dist k) 0)
                 (walk (downhill n dist k) (+ i 1)))))
           (vector-ref dist k0)))))

    ;; The neighbour of k with the smallest distance below k's (the fixed
    ;; order breaks ties, so the path is the same on every target), or -1.
    (define (downhill n dist k)
      (let* ((w (vector-ref n 3)) (h (vector-ref n 4))
             (r (quotient k w)) (c (remainder k w)))
        (let try ((i 0) (best -1) (bd (vector-ref dist k)))
          (if (>= i 8)
              best
              (let* ((dr (vector-ref DR i)) (dc (vector-ref DC i))
                     (rr (+ r dr)) (cc (+ c dc)))
                (if (and (>= rr 0) (< rr h) (>= cc 0) (< cc w)
                         (or (= dr 0) (= dc 0)
                             (and (walk-at? n (+ (* rr w) c)) (walk-at? n (+ (* r w) cc)))))
                    (let* ((kk (+ (* rr w) cc)) (dk (vector-ref dist kk)))
                      (if (and (>= dk 0) (< dk bd))
                          (try (+ i 1) kk dk)
                          (try (+ i 1) best bd)))
                    (try (+ i 1) best bd)))))))
    (define DR (vector 1 -1 0 0 1 1 -1 -1))
    (define DC (vector 0 0 1 -1 1 -1 1 -1))

    ;; Whether every cell the segment crosses is walkable (sampled every
    ;; half cell).
    (define (nav-line-clear? n x0 y0 x1 y1)
      (let* ((dx (- x1 x0)) (dy (- y1 y0))
             (len (sqrt (+ (* dx dx) (* dy dy))))
             (steps (+ 1 (exact (ceiling (/ len (* 0.5 NAV-CELL)))))))
        (let loop ((i 0))
          (or (> i steps)
              (let ((t (/ (* 1.0 i) steps)))
                (and (nav-walkable? n (+ x0 (* t dx)) (+ y0 (* t dy)))
                     (loop (+ i 1))))))))))
