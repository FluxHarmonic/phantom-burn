;;; Keep Phantom's public API while Substratic owns the PCM sample mixer.
(define-library (phantom sound mix)
  (import
    (rename
      (only (substratic audio mixer)
            make-sample-mixer sample-mixer-play! sample-mixer-loop!
            sample-mixer-render! sample-mixer-voices sample-mixer-silent?
            MAX-VOICES)
      (make-sample-mixer make-mixer)
      (sample-mixer-play! mixer-play!)
      (sample-mixer-loop! mixer-loop!)
      (sample-mixer-render! mixer-render!)
      (sample-mixer-voices mixer-voices)
      (sample-mixer-silent? mixer-silent?)))
  (export make-mixer mixer-play! mixer-loop! mixer-render!
          mixer-voices mixer-silent? MAX-VOICES))
