;;; (phantom sound sections) - A track's named states on a live player
;;;
;;; The game's music controller (S1). A track has three steady states, calm,
;;; aware and alert, each a region of its order that loops on its own, and
;;; composed transitions between them, each a region whose last pattern's Bxx
;;; lands on its destination state. The route table is the track's (its
;;; composer's handoff: docs/music/INTEGRATION.md for False Identity,
;;; docs/music/HEAT-TRACE-TRAINING.md for Heat Trace): which mark to jump to,
;;; from which steady state, for which wanted state. Heat Trace has separate
;;; transition marks where False Identity has one `release`, so no fixed table
;;; fits both.
;;;
;;;   (make-sections player routes sr)  starts looping calm (sr: the player's rate); #f if the tune lacks a
;;;                                  state or transition mark the routes name
;;;   (sections-want! s 'calm|'aware|'alert)   cheap to call every frame
;;;   (sections-tick! s)             once a frame (or a pull): lands jumps, keeps
;;;                                  the region right, and re-routes
;;;   (sections-playing s)           the section the walk is in (a state or a transition)
;;;   (sections-wanted s)
;;;   (desire-from-states states)    the guards' state integers -> the wanted state
;;;   (track-routes name)            the route table for a track's name, or #f
;;;
;;; The rules (both handoffs):
;;; - A jump waits for the next bar (motif's player-jump-to-mark!); a second
;;;   ask replaces the first. A queued jump owns the region until it lands.
;;; - Landed in a transition: the region is cleared, so its Bxx finishes it at
;;;   its destination. Landed in a state: that state's region.
;;; - The route is chosen from where the walk is headed: a state, or a
;;;   transition's destination. So a return interrupted by new suspicion
;;;   replaces the return, and a detection pickup is never restarted while
;;;   alert is still wanted.
;;; - When the wanted state is already where the walk is headed but another
;;;   jump is queued (the want changed and changed back), the queued jump is
;;;   replaced by one to where the walk is headed. motif has no cancel, so a
;;;   state restarts its loop at that bar; rare, and on the grid.
;;; - No music timer: the wanted state is the guards' own (the AI's search
;;;   expiry ends aware, not a clock here).
;;; - FAST IN, SLOW OUT (David, 2026-09-26: the detection must be heard at once):
;;;   the jump into a pickup that leads to alert lands on the next BEAT, not the
;;;   next bar. motif's mark jumps land only on bar rows, so the music's pull
;;;   (sections-pull!) renders exactly up to the next beat's sample and cuts there
;;;   (player-jump!: the scheduled notes flushed, the walk restarted at the pickup's
;;;   row 0; every pattern of both scores starts with notes or releases on all
;;;   channels, so the cut is clean). The same mark is also queued as the bar
;;;   jump, which replaces any stale one and, landing at the pickup's own row 0
;;;   right after the cut, changes nothing. If the bar comes first, motif lands it
;;;   and the beat jump is dropped. Every other move waits for its bar.
;;;
;;;   (sections-pull! s out n)       the music's n frames: the player's pull, cut at
;;;                                  the beat when a pickup is armed
;;;   (sections-headed s)            where the walk is headed (a state)

(define-library (phantom sound sections)
  (import (sigil core)
          (sigil struct)
          (motif tune)
          (motif tune player))
  (export make-sections sections-want! sections-tick! sections-playing sections-wanted
          sections-player sections-routes desire-from-states track-routes routes-mark
          routes-destination STATES sections-pull! sections-headed)
  (begin
    (define STATES '(calm aware alert))

    ;; routes: #(destinations table): destinations ((transition . state) ...);
    ;; table (((from . want) . mark) ...), from a state
    (define (routes dests table) (vector dests table))
    (define (routes-destination r sec) (let ((e (assq sec (vector-ref r 0)))) (and e (cdr e))))
    (define (routes-mark r from want)
      (let ((e (assoc (cons from want) (vector-ref r 1)))) (and e (cdr e))))

    (define FALSE-IDENTITY
      (routes '((detected . alert) (release . calm))
              '(((calm . aware) . aware) ((calm . alert) . detected)
                ((aware . alert) . detected) ((aware . calm) . release)
                ((alert . aware) . aware) ((alert . calm) . release))))

    (define HEAT-TRACE
      (routes '((investigate . aware) (detected . alert) (settle-aware . calm)
                (settle-alert . calm) (search-again . aware))
              '(((calm . aware) . investigate) ((calm . alert) . detected)
                ((aware . alert) . detected) ((aware . calm) . settle-aware)
                ((alert . aware) . search-again) ((alert . calm) . settle-alert))))

    (define (track-routes name)
      (cond ((member name '("music-false-identity" "false-identity")) FALSE-IDENTITY)
            ((member name '("music-heat-trace" "heat-trace")) HEAT-TRACE)
            (else #f)))

    ;; the guards' states (0 CALM, 1 SUSPICIOUS, 2 SEARCHING, 3 HUNTING): the
    ;; most aware one wins; one unit going calm never lowers the music while
    ;; another still searches or hunts
    (define (desire-from-states states)
      (let ((top (let loop ((ss states) (m 0)) (if (null? ss) m (loop (cdr ss) (max m (car ss)))))))
        (cond ((>= top 3) 'alert) ((>= top 1) 'aware) (else 'calm))))

    (define-struct sections
      (player)
      (routes)
      (regions)                      ; ((name from . to) ...), the tune's
      (wanted mutable: #t)
      (installed mutable: #t)        ; the section whose region the tick last set
      (beat-mark mutable: #t)        ; a pickup armed to cut in at the next beat, or #f
      (sr))                          ; the player's sample rate

    (define (region s name) (let ((r (assq name (sections-regions s)))) (and r (cdr r))))

    (define (make-sections p routes sr)
      (let* ((t (player-tune p))
             (regions (tune-mark-regions t))
             (need (append STATES (map car (vector-ref routes 0)))))
        (and (let all ((ns need)) (or (null? ns) (and (assq (car ns) regions) (all (cdr ns)))))
             (let ((s (sections player: p routes: routes regions: regions wanted: 'calm installed: 'calm
                                beat-mark: #f sr: sr)))
               (let ((c (region s 'calm))) (player-set-region! p (car c) (cdr c)))
               s))))

    ;; the walker's newest scheduled position, not the render position: motif lands a
    ;; queued jump (and clears player-pending-mark) when the WALKER reaches the bar,
    ;; a lookahead before the render position gets there. Read from the render
    ;; position, the old section looked current with nothing queued, and the route
    ;; was asked again (Heat Trace played settle-aware twice: the first test run)
    (define (walk-pos s)
      (let ((tl (player-timeline (sections-player s)))) (and (pair? tl) (vector-ref (car tl) 0))))

    ;; the section the walk is in: the region holding its order position
    (define (sections-playing s)
      (let ((pos (walk-pos s)))
        (if (not pos) 'calm
            (let loop ((rs (sections-regions s)))
              (cond ((null? rs) 'calm)
                    ((and (>= pos (cadr (car rs))) (< pos (cddr (car rs)))) (car (car rs)))
                    (else (loop (cdr rs))))))))

    ;; where the walk is headed: a state, or a transition's destination
    (define (headed s sec)
      (if (memq sec STATES) sec (or (routes-destination (sections-routes s) sec) 'calm)))

    ;; ask for the mark the route gives, unless it is already queued
    (define (route! s)
      (let* ((p (sections-player s))
             (sec (sections-playing s))
             (to (headed s sec))
             (mark (or (routes-mark (sections-routes s) to (sections-wanted s))
                       ;; nothing to do, unless a stale jump is queued: replace it
                       (let ((q (player-pending-mark p))) (and q (not (eq? (car q) to)) to))))
             (queued (player-pending-mark p)))
        (when (and mark (not (and queued (eq? (car queued) mark))))
          (player-jump-to-mark! p mark)
          ;; a pickup into alert also cuts in at the next beat (fast in)
          (set-sections-beat-mark! s (and (not (memq mark STATES))
                                          (eq? (routes-destination (sections-routes s) mark) 'alert)
                                          mark)))))

    (define (sections-headed s) (headed s (sections-playing s)))

    ;; frames from the render position to the next beat's first sample, if it is
    ;; within n, else #f: from the newest timeline entry at or before the render
    ;; position and the row's length (2.5 / tempo x speed seconds), with beats
    ;; every meter-rows rows of a pattern (both scores' patterns are whole bars)
    (define (beat-offset p sr n)
      (let* ((now (player-rendered p))
             (e (let find ((es (player-timeline p)))
                  (cond ((null? es) #f) ((<= (vector-ref (car es) 2) now) (car es)) (else (find (cdr es))))))
             (beat (car (tune-meter (player-tune p)))))
        (and e
             (let* ((rs (/ (* sr 2.5 (player-speed p)) (player-tempo p)))
                    (rowf (+ (vector-ref e 1) (/ (- now (vector-ref e 2)) rs)))
                    (next (* beat (ceiling (/ (- rowf 1e-9) beat))))
                    (off (exact (round (- (+ (vector-ref e 2) (* (- next (vector-ref e 1)) rs)) now)))))
               (and (>= off 0) (< off n) off)))))

    ;; the music's n stereo frames into out: the player's own pull, except that an
    ;; armed pickup still queued cuts in at the next beat inside these frames
    (define (sections-pull! s out n)
      (let* ((p (sections-player s))
             (m (sections-beat-mark s))
             (q (player-pending-mark p)))
        (cond
          ((not m) (player-pull! p out 0 n))
          ((not (and q (eq? (car q) m)))       ; landed at a bar already, or replaced
           (set-sections-beat-mark! s #f)
           (player-pull! p out 0 n))
          (else
           (let ((off (beat-offset p (sections-sr s) n)))
             (if (not off)
                 (player-pull! p out 0 n)
                 (begin
                   (when (> off 0) (player-pull! p out 0 off))
                   ;; the pickup is a transition: no region (the installed state's would
                   ;; walk it straight back), its Bxx finishes it; the queued bar jump
                   ;; becomes its destination, which lands where that Bxx goes anyway
                   ;; (a queued pickup would restart it at its end)
                   (player-set-region! p #f #f)
                   (player-jump! p (cdr q) 0)
                   (player-jump-to-mark! p (routes-destination (sections-routes s) m))
                   (set-sections-installed! s m)
                   (set-sections-beat-mark! s #f)
                   (player-pull! p out (* 8 off) (- n off)))))))))

    (define (sections-want! s state)
      (unless (eq? state (sections-wanted s))
        (unless (memq state STATES) (error "sections-want!: calm, aware or alert" state))
        (set-sections-wanted! s state)
        (route! s)))

    (define (sections-tick! s)
      (let ((p (sections-player s)))
        (when (and (walk-pos s) (not (player-pending-mark p)))
          (let ((sec (sections-playing s)))
            (unless (eq? sec (sections-installed s))
              (set-sections-installed! s sec)
              (if (memq sec STATES)
                  (let ((r (region s sec))) (player-set-region! p (car r) (cdr r)))
                  (player-set-region! p #f #f)))))
        ;; a landed transition, or a state reached, may need the next jump
        (route! s)))))
