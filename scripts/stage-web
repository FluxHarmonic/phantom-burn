#!/bin/sh
# Stage phantomburn.net: the site from site/, the news generated from news/,
# and the game at /badge-in/ (David, 2026-09-29: the public path for 0.1, a
# sibling of Crash's /jack-in/).
#
#   PHANTOM_WEB_DIR=build/remote-web-<sha> scripts/stage-web build/site
#
# The tree:
#   /                 site/ as it is (the landing, style.css, fonts/, shots/,
#                     the icons, the Flux Harmonic mark), copied whole
#   /404.html         a real 404 for any missing path (without it Pages answers
#                     a missing path with the root page and a 200:
#                     topics/cloudflare-pages-serves-index-for-a-missing-path)
#   /robots.txt       allows everything (public from 0.1)
#   /news/            generated from news/*.md by scripts/build-news.mjs, with
#                     /news/feed.xml (RSS 2.0) and /news/feed.json (JSON Feed)
#   /version.json     generated by the same: package.sgl's version, today's
#                     date, the build's commit, and that version's post
#                     (Harkfell's D38 shape; _headers serves it no-store)
#   /_redirects       the game's earlier paths (/p-<10>/, /beta/, /play/) 301 to /badge-in/:splat
#                     (links shared before the move keep working)
#   /<game>/          the game's web build (page, bridges, assets/)
#   /w/<sha16>/phantom-burn.wasm
#                     the game's wasm, named by its content (the first 16 hex
#                     of its sha256), at the root so no route names the slug.
#                     The page's data-wasm is rewritten to point there. In
#                     production it is not a file: publish-web moves it to R2
#                     (bucket phantomburn-wasm) and functions/w/[[path]].js
#                     serves it same-origin (t-5b3251, Harkfell's model); here
#                     it stays a plain file so check-site.mjs can serve it.
#
# The game's path is read from $PHANTOM_SITE_SLUG, else ~/.config/phantomburn/slug,
# else it is badge-in; a short lowercase name. It is written into the manifest's
# header (# game NAME), where check-site.mjs and verify-live.mjs read it.
#
# PHANTOM_WEB_DIR: the game build to stage (default build/web; a runner build
# is build/remote-web-<sha>, which carries BUILD-SHA). Writes DIR.manifest
# (scripts/tree-manifest, with a header naming HEAD and the build's commit).
# Refuses a DIR that exists: remove it first.
set -eu
cd "$(dirname "$0")/.." || exit 1
DIR="${1:?usage: stage-web DIR}"
DIR="${DIR%/}"
WEB="${PHANTOM_WEB_DIR:-build/web}"
SLUG="${PHANTOM_SITE_SLUG:-$(cat "$HOME/.config/phantomburn/slug" 2>/dev/null || true)}"
SLUG="${SLUG:-badge-in}"
say() { echo "stage-web: $*" >&2; }
printf '%s' "$SLUG" | grep -Eqx '[a-z][a-z0-9-]{1,31}' || { say "REFUSED: the game's path '$SLUG' is not a short lowercase name"; exit 1; }
[ "$SLUG" != w ] || { say "REFUSED: /w/ is the wasm's route"; exit 1; }
[ ! -e "$DIR" ] || { say "REFUSED: $DIR exists; remove it to restage"; exit 1; }
for f in index.html phantom-burn.wasm assets; do
  [ -e "$WEB/$f" ] || { say "REFUSED: $WEB/$f missing (build the web config, or point PHANTOM_WEB_DIR at a runner build)"; exit 1; }
done
[ -f "$WEB/assets/floors/14/floor.sexp" ] || { say "REFUSED: $WEB has no compiled floor 14"; exit 1; }
for f in index.html 404.html robots.txt _headers _redirects style.css; do [ -f "site/$f" ] || { say "REFUSED: site/$f missing"; exit 1; }; done
# news/ and version.json are generated below; a copy in site/ would be
# overwritten or, worse, shipped stale
for f in news version.json w "$SLUG"; do
  [ ! -e "site/$f" ] || { say "REFUSED: site/$f exists; /news/ and /version.json are generated, /w/ and /$SLUG/ are staged"; exit 1; }
done
[ -n "$(find news -name '*.md' 2>/dev/null | head -1)" ] || { say "REFUSED: news/*.md missing (the release posts)"; exit 1; }
VERSION="$(sed -n 's/^  version: "\([0-9][0-9.]*\)".*/\1/p' package.sgl | head -1)"
case "$VERSION" in [0-9]*.[0-9]*.[0-9]*) ;; *) say "REFUSED: cannot read the package version from package.sgl ('$VERSION')"; exit 1 ;; esac
grep -c 'data-wasm="phantom-burn"' "$WEB/index.html" | grep -qx 1 || { say "REFUSED: $WEB/index.html does not say data-wasm=\"phantom-burn\" exactly once; the page changed shape"; exit 1; }

mkdir -p "$DIR"
cp -r site/. "$DIR/"
mkdir -p "$DIR/$SLUG"
cp "$WEB/index.html" "$DIR/$SLUG/"
SHA16="$(sha256sum "$WEB/phantom-burn.wasm" | cut -c1-16)"
mkdir -p "$DIR/w/$SHA16"
cp "$WEB/phantom-burn.wasm" "$DIR/w/$SHA16/phantom-burn.wasm"
sed -i "s|data-wasm=\"phantom-burn\"|data-wasm=\"/w/$SHA16/phantom-burn\"|" "$DIR/$SLUG/index.html"
grep -c "data-wasm=\"/w/$SHA16/phantom-burn\"" "$DIR/$SLUG/index.html" | grep -qx 1 || { say "REFUSED: the page's data-wasm was not rewritten"; exit 1; }
for f in "$WEB"/sigil-wasm-bridges.*; do [ -f "$f" ] && cp "$f" "$DIR/$SLUG/"; done
cp -r "$WEB/assets" "$DIR/$SLUG/assets"

BUILT="local build/web"
STAMP="local-$(git rev-parse --short=12 HEAD)"
[ -f "$WEB/BUILD-SHA" ] && BUILT="$(cat "$WEB/BUILD-SHA") (runner build)" && STAMP="$(cut -c1-12 "$WEB/BUILD-SHA")"

# /news/, its feeds and /version.json, into the tree the gate will check
node scripts/build-news.mjs news "$DIR" --version "$VERSION" --stamp "$STAMP" >&2
[ -f "$DIR/version.json" ] && [ -f "$DIR/news/index.html" ] && [ -f "$DIR/news/feed.xml" ] && [ -f "$DIR/news/feed.json" ] \
  || { say "REFUSED: build-news wrote no version.json, news/index.html or feeds"; exit 1; }
{
  echo "# head $(git rev-parse HEAD)"
  echo "# built $BUILT"
  echo "# wasm $SHA16"
  echo "# game $SLUG"
  scripts/tree-manifest "$DIR"
} > "$DIR.manifest"
say "staged $(grep -vc '^#' "$DIR.manifest") entries ($(du -sh "$DIR" | cut -f1)) to $DIR; the game at /$SLUG/, its wasm at /w/$SHA16/phantom-burn.wasm; manifest $DIR.manifest"
