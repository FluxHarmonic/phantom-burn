#!/bin/sh
# site-shots BUILD OUT - retake phantomburn.net's pictures from a web build
# (after Harkfell's scripts/site-shots). Writes OUT/<name>.png for each row
# below at the game's own 480x270, plus og.png (the link preview, 1200x630)
# and favicon.png / favicon.ico (the title's P), all from the game's own
# renderer through scripts/shot-web.mjs (headless Chrome, muted, into the
# worker-null sink). Look at them, then copy the keepers into site/shots/ and
# site/ by hand: the timing of the patrol's frame depends on how fast
# headless Chrome runs the game, so a retake can miss the torch.
#
#   scripts/site-shots build/remote-web-<sha> /tmp/shots
#
# The rows: NAME|QUERY|WAIT-MS. On floor 14, view=K is the floor's view K
# (1 arrival: the lobby from the entrance, 7 fm-desk), and logo.png is the title's letters alone; on=... sets the
# switchable circuits (emergency,screens,city: every room light off). Crash's
# transmission types over floor 14 for about 20 s after arrival, so the lit
# shot waits it out. The patrol reaches the lobby about 44 s in (measured on
# 1dc7d0e: 42 s the beam at the far wall, 44 s across the marble, 48 s at the
# camera and suspicious).
set -eu
cd "$(dirname "$0")/.." || exit 1
BUILD="${1:?usage: site-shots BUILD OUT}"
OUT="${2:?usage: site-shots BUILD OUT}"
[ -f "$BUILD/index.html" ] || { echo "site-shots: SETUP-FAILED: $BUILD/index.html missing"; exit 2; }
command -v convert > /dev/null || { echo "site-shots: SETUP-FAILED: ImageMagick's convert is not on PATH"; exit 2; }
mkdir -p "$OUT"
while IFS='|' read -r name query wait; do
  [ -n "$name" ] || continue
  node scripts/shot-web.mjs "$BUILD" "$OUT/$name.png" --query "$query" --wait "$wait" | tail -1
  [ -s "$OUT/$name.png" ] || { echo "site-shots: no $OUT/$name.png"; exit 1; }
done <<'ROWS'
floor-14|view=1&hud=0|27000
lobby-dark|view=1&on=emergency,screens,city&hud=0|44000
fm-desk|view=7&on=emergency,screens,city&hud=0|20000
practice|floor=sim&view=1&hud=0|6000
title|title=1&hud=0|7000
ROWS
# the logo: the title screen at 2x with the room's lights off and fogged to
# the dark, then the dark (exactly #0D0A1A, C-BG) keyed out; cropped 8 px
# (4 frame pixels) round the letters, on even offsets so the 2x blocks hold
node scripts/shot-web.mjs "$BUILD" "$OUT/title-2x.png" --query "title=1&on=none&fog=0.01&hud=0" --wait 7000 --scale 2 | tail -1
convert "$OUT/title-2x.png" -crop 950x136+4+108 +repage -fuzz 0 -transparent '#0D0A1A' "$OUT/logo.png"
[ "$(convert "$OUT/title-2x.png" -fuzz 0 -fill none -opaque '#0D0A1A' -trim -format '%wx%h%O' info:)" = "934x120+12+116" ] \
  || echo "site-shots: WARNING: the letters moved; check logo.png's crop (want the trim 934x120+12+116)"
# the link preview: the title screen at 2.5x (1200x675), the middle 630 rows
convert "$OUT/title.png" -filter point -resize 1200x675 -gravity center -crop 1200x630+0+0 +repage "$OUT/og.png"
# the icon: the title's P, its magenta burn and all, on the dark
convert "$OUT/title.png" -crop 44x64+2+56 +repage -background '#0d0a1a' -gravity center -extent 64x64 "$OUT/p64.png"
convert "$OUT/p64.png" -filter box -resize 32x32 "$OUT/favicon.png"
convert "$OUT/p64.png" -filter box -resize 16x16 "$OUT/favicon-16.png"
convert "$OUT/favicon-16.png" "$OUT/favicon.png" "$OUT/favicon.ico"
for f in logo.png og.png favicon.png favicon.ico; do [ -s "$OUT/$f" ] || { echo "site-shots: no $OUT/$f"; exit 1; }; done
echo "site-shots: $(ls "$OUT" | wc -l) files in $OUT; og.png $(identify -format '%wx%h' "$OUT/og.png")"
