#!/usr/bin/env bash
# Build HEAD on an azoth runner (the web config), optionally run test files
# there, and fetch the served tree back. After Crash The Stack's
# scripts/build-remote (crash-the-stack master 7724b9c); see folio
# procedures/azoth-remote-builds for the runners and the helper.
#
#   scripts/build-remote                              build HEAD's web config, fetch it
#   scripts/build-remote --test test/test-walker.sgl  ... and run that test file
#                                                     (dev config) on the runner
#   scripts/build-remote --no-web --test test/test-walker.sgl --test test/test-stand-in.sgl
#                                                     tests only, no web build
#   scripts/build-remote --no-web --release --command "--floor-reach floors/14-slice.floor" \
#                        --output build/floors
#                                                     build the release config, run the
#                                                     release binary with those arguments
#                                                     (DISPLAY unset), and fetch named
#                                                     outputs (paths in the checkout) to
#                                                     build/remote-out-<sha>/
#
#   --release         build the native release config (after the web build, if any)
#   --command "ARGS"  run build/release/bin/phantom-burn ARGS after the builds and
#                     tests (implies --release); repeatable, in order. Each one's
#                     output streams back, and its rc is on its
#                     "=== COMMAND-RESULT rc=" line. ARGS is split on spaces.
#   --output PATH     after everything, fetch the checkout's PATH (a file or a
#                     directory) to build/remote-out-<sha>/PATH; repeatable
#
# WHAT IS BUILT IS EXACTLY HEAD, OR IT IS REFUSED.
#   - a tree with tracked changes is refused before anything is leased;
#   - the source travels as a git bundle of HEAD and is checked out at its
#     full sha on the runner;
#   - the page carries no version stamp, so the check is the runner's
#     checkout itself: after `sigil deps install` and every build it must
#     have no tracked changes (a rewritten sigil.lock would make the build
#     another commit's), or the cycle is refused (125) with the diff;
#   - the tree lands in build/remote-web-<sha>/ (refused if it exists), never
#     build/web, with BUILD-SHA naming the commit, and only when the cycle
#     ended 0 or 1, the runner wrote its completion marker after a checked
#     copy, and the wasm is present.
#
# Exit: 0 all green; 1 a test failed (builds fine); 2 a build failed; 125
# refused or SETUP-FAILED; 126/127 from azoth-remote; 124/255 timeout / lost.
# Each test's own rc is on its "=== TEST-RESULT rc=" line.
#
# Environment: AZOTH_REMOTE (path to azoth.works bin/azoth-remote), BUILD_TIMEOUT
# (seconds, default 5400).
set -euo pipefail
cd "$(dirname "$0")/.."
say() { printf 'build-remote: %s\n' "$*" >&2; }

TESTS=()
COMMANDS=()
OUTPUTS=()
WEB=1
RELEASE=0
FETCH=1
while [ $# -gt 0 ]; do
  case "$1" in
    --test)     [ $# -ge 2 ] || { say "--test needs a file"; exit 125; }; TESTS+=("$2"); shift 2 ;;
    --no-web)   WEB=0; FETCH=0; shift ;;
    --no-fetch) FETCH=0; shift ;;
    --release)  RELEASE=1; shift ;;
    --command)  [ $# -ge 2 ] || { say "--command needs its arguments"; exit 125; }; COMMANDS+=("$2"); RELEASE=1; shift 2 ;;
    --output)   [ $# -ge 2 ] || { say "--output needs a path"; exit 125; }
                case "$2" in /*|*..*) say "--output $2: a path inside the checkout, please"; exit 125 ;; esac
                OUTPUTS+=("$2"); shift 2 ;;
    *) say "unknown argument '$1'"; exit 125 ;;
  esac
done
for f in "${TESTS[@]+"${TESTS[@]}"}"; do
  [ -f "$f" ] || { say "--test $f: no such file"; exit 125; }
  git ls-files --error-unmatch "$f" >/dev/null 2>&1 || { say "--test $f is not tracked, so it is not in the bundle"; exit 125; }
done
[ "$WEB" = 1 ] || [ "$RELEASE" = 1 ] || [ ${#TESTS[@]} -gt 0 ] || { say "nothing to do (--no-web, no --release, no --test)"; exit 125; }

REMOTE=${AZOTH_REMOTE:-$HOME/Projects/Sites/azoth.works/bin/azoth-remote}
[ -x "$REMOTE" ] || { say "azoth-remote not found at $REMOTE (set AZOTH_REMOTE)"; exit 125; }

dirty=$(git status --porcelain --untracked-files=no)
if [ -n "$dirty" ]; then
  say "REFUSED: the tree has tracked changes; the build would not be HEAD's. Commit first."
  printf '%s\n' "$dirty" | head -5 >&2
  exit 125
fi
SHA=$(git rev-parse --short=12 HEAD)
FULL=$(git rev-parse HEAD)
DEST="build/remote-web-$SHA"
OUTDEST="build/remote-out-$SHA"
if [ ${#OUTPUTS[@]} -gt 0 ] && [ -e "$OUTDEST" ]; then
  say "REFUSED: $OUTDEST already exists; remove it to fetch this sha's outputs again"
  exit 125
fi
if [ "$FETCH" = 1 ] && [ -e "$DEST" ]; then
  say "REFUSED: $DEST already exists; remove it to rebuild this sha"
  exit 125
fi
SIGIL_V=$(sigil --version 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $2}') || SIGIL_V=""
case "$SIGIL_V" in [0-9]*.[0-9]*.[0-9]*) ;; *) say "cannot read this box's sigil version ('$SIGIL_V')"; exit 125 ;; esac
say "HEAD $SHA ($FULL), sigil $SIGIL_V, web: $WEB, tests: ${TESTS[*]:-none}"

STAGE=$(mktemp -d "${TMPDIR:-/tmp}/phantom-build-remote.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT
git bundle create "$STAGE/src.bundle" HEAD 2>/dev/null
: > "$STAGE/tests"
for f in "${TESTS[@]+"${TESTS[@]}"}"; do printf '%s\n' "$f" >> "$STAGE/tests"; done
: > "$STAGE/commands"
for c in "${COMMANDS[@]+"${COMMANDS[@]}"}"; do printf '%s\n' "$c" >> "$STAGE/commands"; done
: > "$STAGE/outputs"
for o in "${OUTPUTS[@]+"${OUTPUTS[@]}"}"; do printf '%s\n' "$o" >> "$STAGE/outputs"; done

cat > "$STAGE/remote.sh" <<'EOF'
#!/usr/bin/env bash
# Runs ON THE RUNNER, in ~/work. Args: <full sha> <sigil version> <web 0|1>
set -uo pipefail
cd "$HOME/work"
FULL=$1; SIGIL_V=$2; WEB=$3; RELEASE=${4:-0}
mkdir -p out
t() { date +%s; }
T0=$(t)
echo "remote: runner nproc=$(nproc) load=$(cut -d' ' -f1-3 /proc/loadavg)"
git clone --quiet src.bundle checkout || { echo "SETUP-FAILED: clone"; exit 125; }
git -C checkout checkout --quiet "$FULL" || { echo "SETUP-FAILED: checkout $FULL"; exit 125; }
[ "$(git -C checkout rev-parse HEAD)" = "$FULL" ] || { echo "SETUP-FAILED: checkout is not $FULL"; exit 125; }
"$HOME/.sigil/bin/sigil" cli use "$SIGIL_V" >/dev/null 2>&1 || { echo "SETUP-FAILED: sigil cli use $SIGIL_V"; exit 125; }
export PATH="$HOME/.sigil/bin:$PATH"
# The runner's login environment carries the system profile's header paths;
# zig's stdatomic.h include_next then finds the system C++ stdatomic.h and
# every native C compile fails ('bits/c++config.h' file not found; measured
# at 63cd7d3, every test and the release build). A local shell does not set
# them. Build without them, as sigil's release-build.sh does for its android
# cross build (scripts/dev sets CPATH itself).
echo "remote: inherited include paths: C_INCLUDE_PATH='${C_INCLUDE_PATH:-}' CPLUS_INCLUDE_PATH='${CPLUS_INCLUDE_PATH:-}' CPATH='${CPATH:-}'"
unset C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH CPATH
echo "remote: sigil $(sigil --version 2>&1 | sed 's/\x1b\[[0-9;]*m//g')"
cd checkout
clean() {  # refuse when the checkout is no longer exactly the commit
  local d; d=$(git status --porcelain --untracked-files=no)
  if [ -n "$d" ]; then
    echo "REFUSED ($1): tracked changes in the runner's checkout:"; printf '%s\n' "$d" | sed 's/^/  /'
    git diff | head -40 | sed 's/^/  | /'
    exit 125
  fi
}
T1=$(t); sigil deps install > ../out/deps.log 2>&1 || { echo "BUILD-FAILED: deps install (out/deps.log)"; tail -20 ../out/deps.log; exit 2; }
clean "after deps install"
T2=$(t); echo "remote: deps install $((T2-T1))s"
guix shell -m manifest.scm -- true > ../out/guix.log 2>&1 || { echo "SETUP-FAILED: guix shell -m manifest.scm (out/guix.log)"; tail -20 ../out/guix.log; exit 125; }
T3=$(t); echo "remote: guix environment $((T3-T2))s"
RC=0
if [ "$WEB" = 1 ]; then
  scripts/dev sigil build --config web > ../out/build.log 2>&1; brc=$?
  T4=$(t); echo "remote: web build rc=$brc $((T4-T3))s"
  [ $brc -eq 0 ] || { echo "BUILD-FAILED rc=$brc (out/build.log)"; tail -30 ../out/build.log; exit 2; }
  grep -a -q 'OPTIMIZE' ../out/build.log || { echo "BUILD-FAILED: no OPTIMIZE step in the log (wasm-opt missing?)"; exit 2; }
  clean "after the web build"
  echo "remote: wasm $(stat -c %s build/web/phantom-burn.wasm) bytes sha256 $(sha256sum build/web/phantom-burn.wasm | cut -c1-16)"
fi
while IFS= read -r f; do
  [ -n "$f" ] || continue
  Ta=$(t)
  echo "=== TEST $f"
  scripts/dev sigil test --sgl "$f" < /dev/null 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -E '✓|✗|passed|failed|Error|error:' ; r=${PIPESTATUS[0]}
  echo "=== TEST-RESULT rc=$r $(( $(t) - Ta ))s $f"
  [ $r -eq 0 ] || RC=1
done < ../tests
clean "after the tests"
if [ "$RELEASE" = 1 ]; then
  Tr=$(t); env -u DISPLAY scripts/dev sigil build --config release > ../out/release.log 2>&1; brc=$?
  echo "remote: release build rc=$brc $(( $(t) - Tr ))s"
  [ $brc -eq 0 ] || { echo "BUILD-FAILED rc=$brc (out/release.log)"; tail -30 ../out/release.log; exit 2; }
  clean "after the release build"
  echo "remote: release binary sha256 $(sha256sum build/release/bin/phantom-burn | cut -c1-16)"
fi
while IFS= read -r c; do
  [ -n "$c" ] || continue
  Tc=$(t)
  echo "=== COMMAND phantom-burn $c"
  # the arguments split on spaces, as documented
  env -u DISPLAY scripts/dev ./build/release/bin/phantom-burn $c < /dev/null 2>&1; r=$?
  echo "=== COMMAND-RESULT rc=$r $(( $(t) - Tc ))s $c"
  [ $r -eq 0 ] || RC=1
done < ../commands
clean "after the commands"
while IFS= read -r o; do
  [ -n "$o" ] || continue
  if [ -e "$o" ]; then mkdir -p "../out/outputs/$(dirname "$o")" && cp -r "$o" "../out/outputs/$o" && echo "remote: output $o"; else echo "remote: output $o: not there"; fi
done < ../outputs
if [ "$WEB" = 1 ]; then
  mkdir -p ../out/web
  if tar -C build/web --exclude=./native --exclude=./bin --exclude=./.sigil-package-cache -cf - . | tar -C ../out/web -xf -; then
    printf '%s\n' "$FULL" > ../out/web.complete
  else
    echo "STAGING-FAILED: could not copy build/web to out/web"; RC=2
  fi
fi
echo "remote: total $(( $(t) - T0 ))s"
exit $RC
EOF

T0=$(date +%s)
set +e
"$REMOTE" --label "phantom-burn $SHA" --timeout "${BUILD_TIMEOUT:-5400}" --detach \
  --put "$STAGE/src.bundle:src.bundle" --put "$STAGE/remote.sh:remote.sh" --put "$STAGE/tests:tests" \
  --put "$STAGE/commands:commands" --put "$STAGE/outputs:outputs" \
  --get "out:$STAGE/fetched" -- bash remote.sh "$FULL" "$SIGIL_V" "$WEB" "$RELEASE"
rc=$?
set -e
say "remote cycle rc=$rc in $(( $(date +%s) - T0 ))s"

if [ "$FETCH" = 1 ] && [ -f "$STAGE/fetched/web/index.html" ]; then
  if { [ "$rc" = 0 ] || [ "$rc" = 1 ]; } && [ "$(cat "$STAGE/fetched/web.complete" 2>/dev/null)" = "$FULL" ] \
     && [ -f "$STAGE/fetched/web/phantom-burn.wasm" ]; then
    mkdir -p build
    mv "$STAGE/fetched/web" "$DEST"
    printf '%s\n' "$FULL" > "$DEST/BUILD-SHA"
    say "fetched the web build of $SHA to $DEST (wasm sha256 $(sha256sum "$DEST/phantom-burn.wasm" | cut -c1-16))"
  else
    say "NOT filing the fetched tree as a build of $SHA: cycle rc=$rc, completion marker '$(cat "$STAGE/fetched/web.complete" 2>/dev/null)'"
  fi
fi
if [ ${#OUTPUTS[@]} -gt 0 ] && [ -d "$STAGE/fetched/outputs" ]; then
  mkdir -p build
  mv "$STAGE/fetched/outputs" "$OUTDEST"
  printf '%s\n' "$FULL" > "$OUTDEST/BUILD-SHA"
  say "fetched the outputs of $SHA to $OUTDEST"
fi
if [ -d "$STAGE/fetched" ]; then
  LOGS="build/remote-web-$SHA.logs"
  rm -rf "$LOGS"; mkdir -p "$LOGS"
  for l in build.log release.log deps.log guix.log; do
    [ -f "$STAGE/fetched/$l" ] && cp "$STAGE/fetched/$l" "$LOGS/$l"
  done
  say "runner logs in $LOGS"
fi
exit $rc
