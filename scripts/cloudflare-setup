#!/bin/sh
# The one-time Cloudflare account changes phantomburn.net needs. DAVID RUNS
# THIS; workers do not create projects or DNS records, and do not hold the
# tokens that can. After Harkfell's scripts/cloudflare-setup, R2 bucket and
# all (t-5b3251: one deployment model for every game, the wasm in R2).
#
#   scripts/cloudflare-setup             report only: what exists, what each
#                                        step would do (no writes)
#   scripts/cloudflare-setup --create    create the Pages project `phantomburn`
#                                        (production branch master) and the
#                                        private R2 bucket `phantomburn-wasm`,
#                                        each only if missing. Nothing is public
#                                        after this: no deployment, no domain,
#                                        and the bucket has no public access
#   scripts/cloudflare-setup --domain    attach phantomburn.net and
#                                        www.phantomburn.net to the project, and
#                                        create their proxied CNAMEs to the
#                                        project's pages.dev name where no record
#                                        exists. Refuses before the first
#                                        production deployment, and where a name
#                                        already points somewhere else
#
# Environment (every mode): eval "$(~/Ops/scripts/cf-env phantomburn)" first,
# or set PHANTOM_ENV_FILE to a file to source:
#   CLOUDFLARE_API_TOKEN   the token (scopes below)
#   CLOUDFLARE_ACCOUNT_ID  the account id (wrangler whoami prints it)
#
# TOKEN SCOPES: ONE token for this script and scripts/publish-web, bucket-scoped
# since 2026-09-26 (pass cloudflare/phantomburn-site):
#   REPLACE=1 ~/Ops/scripts/cloudflare-token-site.sh phantomburn phantomburn.net phantomburn-wasm
#     Account  Cloudflare Pages      Edit   create the project, attach the domains, deploy
#     R2 bucket phantomburn-wasm ONLY: Bucket Item Read and Write
#                                           put and read back the wasm, through R2's
#                                           S3 API (scripts/r2-s3; wrangler's
#                                           `r2 object` REST path refuses this scope)
#     Zone     DNS                   Edit   phantomburn.net only (--domain)
#     Zone     Zone                  Read   phantomburn.net only (the zone id)
# This token cannot see or create buckets. The bucket exists (2026-09-25); to
# create one again, use an account-wide R2 Storage Edit token for --create only.
#
# The bucket stays private: the only way to its objects is the Pages Function
# (functions/w/[[path]].js, bound by wrangler.jsonc). Nothing here or in
# publish-web ever deletes an object: keys are content-named and kept, so a
# cached page always finds the wasm it was built against.
#
# The site is public from 0.1 (David, 2026-09-29): robots.txt allows
# everything, only the 404 page says noindex, and the game lives at /badge-in/
# (/play/, /beta/ and the first unguessable path redirect there). A pages.dev
# preview URL is public too; it serves the same tree.
set -eu
# Credentials: from the environment, or sourced from $PHANTOM_ENV_FILE when
# that is set (the old default ~/Ops/.env-phantomburn is gone: tokens live in
# pass since 2026-09-26). This script never prints them.
ENV_FILE="${PHANTOM_ENV_FILE:-}"
if [ -n "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi
# every wrangler call runs from an empty scratch directory: wrangler 4 edits
# the wrangler config it finds in its cwd (Harkfell's setup, 2026-09-24)
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/phantomburn-cloudflare-setup-XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT
cd "$SCRATCH" || exit 1
PROJECT="${PHANTOM_PAGES_PROJECT:-phantomburn}"
BUCKET="${PHANTOM_WASM_BUCKET:-phantomburn-wasm}"
ZONE_NAME=phantomburn.net
DOMAINS="phantomburn.net www.phantomburn.net"
MODE=report
case "${1:-}" in
  "") ;;
  --create) MODE=create ;;
  --domain) MODE=domain ;;
  *) echo "cloudflare-setup: unknown argument ${1}"; exit 2 ;;
esac
say() { echo "cloudflare-setup: $*"; }
command -v wrangler > /dev/null || { say "wrangler not on PATH"; exit 1; }
command -v jq > /dev/null || { say "jq not on PATH"; exit 1; }
[ -n "${CLOUDFLARE_API_TOKEN:-}" ] || { say "CLOUDFLARE_API_TOKEN not set"; exit 1; }
[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ] || { say "CLOUDFLARE_ACCOUNT_ID not set (wrangler whoami prints it)"; exit 1; }
API=https://api.cloudflare.com/client/v4
api() {   # METHOD PATH [JSON] -> the body; exits on success:false
  if [ -n "${3:-}" ]; then
    out="$(curl -sS -X "$1" "$API$2" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "Content-Type: application/json" --data "$3")"
  else
    out="$(curl -sS -X "$1" "$API$2" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN")"
  fi
  if [ "$(printf '%s' "$out" | jq -r '.success')" != true ]; then
    say "API $1 $2 refused: $(printf '%s' "$out" | jq -c '.errors')" >&2
    exit 1
  fi
  printf '%s' "$out"
}
say "account $CLOUDFLARE_ACCOUNT_ID, project $PROJECT, bucket $BUCKET, mode $MODE"

PROJ_JSON="$(curl -sS "$API/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$PROJECT" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN")"
TARGET=""
if [ "$(printf '%s' "$PROJ_JSON" | jq -r '.success')" = true ]; then
  HAVE_PROJECT=1
  TARGET="$(printf '%s' "$PROJ_JSON" | jq -r '.result.subdomain')"
  say "Pages project $PROJECT exists: production branch $(printf '%s' "$PROJ_JSON" | jq -r '.result.production_branch'), $TARGET, domains $(printf '%s' "$PROJ_JSON" | jq -r '.result.domains | join(" ")')"
else
  HAVE_PROJECT=0
  say "Pages project $PROJECT does not exist ($(printf '%s' "$PROJ_JSON" | jq -c '.errors[0].message'))"
fi

# the token reaches curl on stdin (-K -), not on its command line
BUCKET_JSON="$(printf 'header = "Authorization: Bearer %s"\n' "$CLOUDFLARE_API_TOKEN" | curl -sS -K - "$API/accounts/$CLOUDFLARE_ACCOUNT_ID/r2/buckets/$BUCKET")" || BUCKET_JSON='{}'
# three answers, not two: the bucket-scoped token cannot see buckets at all,
# and "the token can't tell" must not read as "missing, create it"
if [ "$(printf '%s' "$BUCKET_JSON" | jq -r '.success' 2>/dev/null)" = true ]; then
  HAVE_BUCKET=1
  say "R2 bucket $BUCKET exists (created $(printf '%s' "$BUCKET_JSON" | jq -r '.result.creation_date // "?"'))"
elif printf '%s' "$BUCKET_JSON" | jq -e '[.errors[]?.code] | index(10006)' > /dev/null 2>&1; then
  HAVE_BUCKET=0
  say "R2 bucket $BUCKET does not exist ($(printf '%s' "$BUCKET_JSON" | jq -c '.errors[0].message'))"
else
  HAVE_BUCKET=unknown
  say "R2 bucket $BUCKET: unknown to this token ($(printf '%s' "$BUCKET_JSON" | jq -c '.errors[0]' 2>/dev/null || echo 'no JSON reply')); a bucket-scoped token cannot see buckets"
fi

if [ "$MODE" = create ]; then
  if [ "$HAVE_PROJECT" = 0 ]; then
    wrangler pages project create "$PROJECT" --production-branch master
    say "created Pages project $PROJECT (no deployment, no custom domain: nothing is public)"
  fi
  if [ "$HAVE_BUCKET" = 0 ]; then
    wrangler r2 bucket create "$BUCKET"
    say "created R2 bucket $BUCKET (private: only the Pages Function reads it)"
  elif [ "$HAVE_BUCKET" = unknown ]; then
    say "NOT creating R2 bucket $BUCKET: this token cannot tell whether it exists. Creating a bucket needs an account-wide R2 Storage Edit token"
  fi
  say "next: scripts/publish-web DIR \"<line>\" --preview, checked on its pages.dev URL"
  exit 0
fi

ZONE_ID="$(api GET "/zones?name=$ZONE_NAME" | jq -r '.result[0].id // empty')"
[ -n "$ZONE_ID" ] || { say "no zone $ZONE_NAME visible to this token"; exit 1; }
say "zone $ZONE_NAME is $ZONE_ID; its records for the site's names:"
for d in $DOMAINS; do
  recs="$(api GET "/zones/$ZONE_ID/dns_records?name=$d" | jq -r '.result[] | "\(.type) \(.name) -> \(.content) proxied=\(.proxied)"')"
  say "  $d: ${recs:-none}"
done
if [ "$MODE" = report ]; then
  say "report only. --create would make the project and the bucket if missing; --domain would attach $DOMAINS"
  say "to $PROJECT and create proxied CNAMEs to ${TARGET:-<its pages.dev name>} where no record exists (and refuse where one does)"
  exit 0
fi

[ "$HAVE_PROJECT" = 1 ] || { say "REFUSED: the project does not exist; --create first"; exit 1; }
case "$TARGET" in *.pages.dev) ;; *) say "REFUSED: cannot read the project's pages.dev name ('$TARGET')"; exit 1 ;; esac
DEPLOYS="$(api GET "/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$PROJECT/deployments?env=production" | jq '.result | length')"
[ "$DEPLOYS" -gt 0 ] || { say "REFUSED: $PROJECT has no production deployment yet; publish and check it on $TARGET first"; exit 1; }
for d in $DOMAINS; do
  existing="$(api GET "/zones/$ZONE_ID/dns_records?name=$d" | jq -r '.result[] | select(.type == "A" or .type == "AAAA" or .type == "CNAME") | "\(.type) \(.content)"')"
  if [ -n "$existing" ] && [ "$existing" != "CNAME $TARGET" ]; then
    say "REFUSED: $d already points somewhere ($existing); not replacing it"
    exit 1
  fi
done
for d in $DOMAINS; do
  if printf '%s' "$PROJ_JSON" | jq -e --arg d "$d" '.result.domains | index($d)' > /dev/null; then
    say "$d is already attached to $PROJECT"
  else
    api POST "/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects/$PROJECT/domains" "{\"name\":\"$d\"}" > /dev/null
    say "attached $d to $PROJECT"
  fi
  if [ -z "$(api GET "/zones/$ZONE_ID/dns_records?name=$d" | jq -r '.result[]? | select(.type == "A" or .type == "AAAA" or .type == "CNAME") | .id')" ]; then
    api POST "/zones/$ZONE_ID/dns_records" "{\"type\":\"CNAME\",\"name\":\"$d\",\"content\":\"$TARGET\",\"proxied\":true,\"comment\":\"phantomburn.net on Pages (scripts/cloudflare-setup)\"}" > /dev/null
    say "created CNAME $d -> $TARGET (proxied)"
  fi
done
say "done. Cloudflare validates the domains and issues certificates (minutes); then"
say "node scripts/verify-live.mjs https://phantomburn.net <the staged DIR that was published>"
