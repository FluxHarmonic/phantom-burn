#!/bin/sh
# scripts/host         snapshot build/web into $HOSTDIR/site and (re)start the
#                      servers: https on 8811 and http on 8812, wg0 only.
# scripts/host --stop  stop the servers this script started.
#
# HOSTDIR defaults to ~/Projects/Code/sigil/phantom-burn-hosted (outside the
# repo, so a rebuild does not change what is served until this runs again,
# and removing a worktree does not take the site down). The servers are
# scripts/serve.mjs copied there, with a self-signed certificate for the wg0
# address made once. $HOSTDIR/site/version.txt names the wasm's hash and the
# commit it was built from.
set -eu
REPO="$(cd "$(dirname "$0")/.." && pwd)"
HOSTDIR="${HOSTDIR:-$HOME/Projects/Code/sigil/phantom-burn-hosted}"
# the build to serve: build/web, or a runner build (WEB=build/remote-web-SHA),
# relative to the repo; made absolute before the cd below
WEB="$(cd "$REPO" && cd "${WEB:-build/web}" && pwd)"
# PORT_TLS / PORT_HTTP: other ports, so a second build can be hosted beside
# the first (P1: HOSTDIR=...-p1 PORT_TLS=8815 PORT_HTTP=8816)
PORT_TLS="${PORT_TLS:-8811}"
PORT_HTTP="${PORT_HTTP:-8812}"
mkdir -p "$HOSTDIR"
cd "$HOSTDIR"
HERE="$(pwd)"

live_pid() {   # the PID in host-PORT.pid if it is our node serve.mjs, else nothing
  f="host-$1.pid"; [ -f "$f" ] || return 0
  pid="$(cat "$f")"
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || true)"
  [ "$(basename "${exe% (deleted)}")" = node ] || return 0
  [ "$cwd" = "$HERE" ] || return 0
  tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "serve.mjs site $1" || return 0
  echo "$pid"
}
stop_port() {
  pid="$(live_pid "$1")"
  if [ -n "$pid" ]; then kill "$pid" && echo "host: stopped pid $pid (port $1)"; fi
  rm -f "host-$1.pid"
}
stop_port $PORT_TLS
stop_port $PORT_HTTP
# and scripts/host-site's servers on the same ports (its site-PORT.pid, the
# same checks: our node, this directory, serve-site.mjs)
for p in $PORT_TLS $PORT_HTTP; do
  f="site-$p.pid"; [ -f "$f" ] || continue
  pid="$(cat "$f")"
  if [ "$(basename "$(readlink "/proc/$pid/exe" 2>/dev/null || true)")" = node ] &&
     [ "$(readlink "/proc/$pid/cwd" 2>/dev/null || true)" = "$HERE" ] &&
     tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "serve-site.mjs"; then
    kill "$pid" && echo "host: stopped host-site's pid $pid (port $p)"
  fi
  rm -f "$f"
done
[ "${1:-}" = "--stop" ] && exit 0

[ -f "$WEB/phantom-burn.wasm" ] || { echo "host: build/web/phantom-burn.wasm missing; build --config web first"; exit 1; }
[ -f "$WEB/assets/stand-in/floor14.collide.b64" ] || { echo "host: build/web/assets/stand-in missing"; exit 1; }
rm -rf site
mkdir -p site
cp -r "$WEB/index.html" "$WEB/phantom-burn.wasm" "$WEB/assets" site/
for f in "$WEB"/sigil-wasm-bridges.*; do [ -f "$f" ] && cp "$f" site/; done
cp "$REPO/scripts/serve.mjs" serve.mjs
printf 'phantom-burn %s\ncommit %s\nhosted %s\n' \
  "$(sha256sum site/phantom-burn.wasm | cut -c1-12)" \
  "$(if [ -f "$WEB/BUILD-SHA" ]; then cut -c1-7 "$WEB/BUILD-SHA"; echo " (runner build)"; else git -C "$REPO" rev-parse --short HEAD; git -C "$REPO" diff --quiet HEAD || echo -dirty; fi | tr -d "\n")" \
  "$(date -u +%FT%TZ)" > site/version.txt

HOST="$(ip -4 -o addr show dev wg0 | awk '{print $4}' | cut -d/ -f1)"
[ -n "$HOST" ] || { echo "host: no wg0 address"; exit 1; }
if [ ! -f tls/cert.pem ]; then
  mkdir -p tls
  guix shell openssl -- openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
    -keyout tls/key.pem -out tls/cert.pem -subj "/CN=$HOST" -addext "subjectAltName=IP:$HOST" 2>/dev/null
fi
nohup node serve.mjs site $PORT_TLS --tls > host-$PORT_TLS.log 2>&1 &
echo $! > host-$PORT_TLS.pid
nohup node serve.mjs site $PORT_HTTP > host-$PORT_HTTP.log 2>&1 &
echo $! > host-$PORT_HTTP.pid
sleep 1
cat host-$PORT_TLS.log host-$PORT_HTTP.log
cat site/version.txt
