#!/bin/sh
# Gate for the R2 step of scripts/publish-web, run against scripts/r2-s3-mock.cjs:
# no network, no token, nothing deployed.
#
#   scripts/test-publish-r2 [PUBLISH]   (default scripts/publish-web; another
#                                        path for sabotage runs)
#
# It fakes what publish-web's earlier refusals need (a staged tree with one
# content-named wasm, DIR.manifest, DIR.verified naming the gate files as they
# are now, HEAD, a clean checkout), so it must run on a CLEAN checkout: commit
# first. `wrangler` is a stub on PATH that records its arguments and fails, so
# every real publish stops at the Pages deploy, after the R2 step. The mock is
# scoped to the bucket in wrangler.jsonc, or to another one for the refusals.
# Last line is VERDICT; rc 0 only if every check passed.
set -u
cd "$(dirname "$0")/.." || exit 1
PUBLISH="${1:-scripts/publish-web}"
GAME=phantom-burn
GATES="scripts/check-site.mjs scripts/serve-site.mjs scripts/tree-manifest"
BUCKET="$(sed -n 's/.*"bucket_name": "\([^"]*\)".*/\1/p' wrangler.jsonc | head -1)"
[ -n "$BUCKET" ] || { echo "SETUP-FAILED: no bucket in wrangler.jsonc"; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "SETUP-FAILED: tracked changes; publish-web would refuse before R2. Commit first."; exit 1; }
T=$(mktemp -d "${TMPDIR:-/tmp}/test-publish-r2.XXXXXX"); M=""
trap '[ -n "$M" ] && kill $M 2>/dev/null; rm -rf "$T"' EXIT

# ---- the fake verified tree
HEAD_FULL=$(git rev-parse HEAD); HEAD12=$(git rev-parse --short=12 HEAD)
head -c 200000 /dev/urandom > "$T/game.wasm"
SHA16=$(sha256sum "$T/game.wasm" | cut -c1-16)
KEY="w/$SHA16/$GAME.wasm"
DIR="$T/site"; mkdir -p "$DIR/w/$SHA16"
echo '<!doctype html><title>test</title>' > "$DIR/index.html"
cp "$T/game.wasm" "$DIR/$KEY"
{ echo "# test-publish-r2 fake tree"; echo "# built test-publish-r2"; echo "# head $HEAD_FULL"; scripts/tree-manifest "$DIR"; } > "$DIR.manifest" \
  || { echo "SETUP-FAILED: tree-manifest"; exit 1; }
{ echo "manifest-sha256 $(sha256sum "$DIR.manifest" | cut -d' ' -f1)"
  for g in $GATES; do echo "gate $(sha256sum "$g" | cut -d' ' -f1) $g"; done
  echo "gate-head $HEAD_FULL"; echo "gate-clean yes"; echo "at test-publish-r2"; } > "$DIR.verified"

# ---- stubs and the mock
mkdir "$T/bin"
printf '#!/bin/sh\necho "wrangler $*" >> "%s/wrangler.log"\necho "stub wrangler: refusing to deploy" >&2\nexit 1\n' "$T" > "$T/bin/wrangler"
chmod +x "$T/bin/wrangler"
TOKEN=tok-test-publish-r2
start_mock() {   # scope-bucket [mode]
  [ -n "$M" ] && kill $M 2>/dev/null; wait 2>/dev/null
  node scripts/r2-s3-mock.cjs 0 "$TOKEN" "$1" ${2:-honest} > "$T/mock.log" 2>&1 & M=$!
  i=0; until grep -q listening "$T/mock.log" 2>/dev/null; do i=$((i+1)); [ $i -le 100 ] || { echo "SETUP-FAILED: the mock did not start"; cat "$T/mock.log"; exit 1; }; sleep 0.1; done
  PORT=$(sed -n 's/^mock-r2 listening \([0-9]*\).*/\1/p' "$T/mock.log")
  : > "$T/wrangler.log"
}
run() {   # [creds|nocreds] args... -> rc in RC, output in $T/out
  c=$1; shift
  if [ "$c" = creds ]; then
    env PATH="$T/bin:$PATH" CLOUDFLARE_API_TOKEN="$TOKEN" CLOUDFLARE_ACCOUNT_ID=acct \
      R2_API_BASE="http://127.0.0.1:$PORT" R2_S3_ENDPOINT="http://127.0.0.1:$PORT" sh "$PUBLISH" "$@" > "$T/out" 2>&1
  else
    env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID PATH="$T/bin:$PATH" \
      R2_API_BASE="http://127.0.0.1:$PORT" R2_S3_ENDPOINT="http://127.0.0.1:$PORT" sh "$PUBLISH" "$@" > "$T/out" 2>&1
  fi
  RC=$?; }
N=0; F=0
ok() { N=$((N+1)); if eval "$2"; then echo "PASS $1"; else echo "FAIL $1"; F=$((F+1)); sed 's/^/    | /' "$T/out" | tail -6; fi; }
puts() { grep -c "^PUT /$BUCKET/$KEY -> 200" "$T/mock.log"; }
s3reqs() { grep -cE '^(GET|PUT|HEAD|DELETE) /' "$T/mock.log"; }
deployed() { grep -q 'pages deploy' "$T/wrangler.log"; }

start_mock "$BUCKET"
run nocreds "$DIR" --dry-run
ok "dry run, no credentials: rc 0, says R2 not checked, no S3 request" '[ $RC = 0 ] && grep -q "R2 was not checked" "$T/out" && [ "$(s3reqs)" = 0 ]'
ok "  presence: this is the r2-s3 publish-web" 'grep -q "scripts/r2-s3" "$T/out"'
run creds "$DIR" --dry-run
ok "dry run, in scope, key absent: rc 0, says absent" '[ $RC = 0 ] && grep -q "is absent (the token reads the bucket)" "$T/out"'
ok "  dry run wrote nothing and deployed nothing" '[ "$(puts)" = 0 ] && ! deployed'
start_mock "$BUCKET"   # a fresh log: the count below must see only this run
run nocreds "$DIR" "test message" --preview
ok "publish without credentials: refused before R2 and deploy" '[ $RC = 1 ] && grep -q "must be set" "$T/out" && [ "$(s3reqs)" = 0 ] && ! deployed'
run creds "$DIR" "test message" --preview
ok "publish, key absent: put once, read back identical" '[ "$(puts)" = 1 ] && grep -q "put $KEY" "$T/out" && grep -q "read back, identical" "$T/out"'
ok "  the put was followed by a GET of the key" 'grep -A99 "^PUT /$BUCKET/$KEY -> 200" "$T/mock.log" | grep -q "^GET /$BUCKET/$KEY -> 200"'
ok "  stored as application/wasm" 'grep -qx "stored-type $BUCKET/$KEY application/wasm" "$T/mock.log"'
ok "  and only then the deploy ran (the stub refused it)" '[ $RC = 1 ] && deployed && grep -q "pages deploy tree" "$T/wrangler.log"'
run creds "$DIR" "test message" --preview
ok "publish again: already there, no second put, deploy ran" 'grep -q "is already in $BUCKET" "$T/out" && [ "$(puts)" = 1 ] && deployed'
run creds "$DIR" --dry-run
ok "dry run, key present: says already there" '[ $RC = 0 ] && grep -q "is already there (the token reads the bucket)" "$T/out"'

start_mock "some-other-bucket"
run creds "$DIR" --dry-run
ok "dry run, token out of scope: rc 1, REFUSED" '[ $RC = 1 ] && grep -q "REFUSED: the token cannot read $BUCKET" "$T/out"'
run creds "$DIR" "test message" --preview
ok "publish, token out of scope: REFUSED, no put, no deploy" '[ $RC = 1 ] && grep -q "REFUSED: could not read $BUCKET/$KEY" "$T/out" && ! grep -q "^PUT" "$T/mock.log" && ! deployed'
ok "  and says 403, not absent" 'grep -q "HTTP 403" "$T/out"'

start_mock "$BUCKET"
head -c 1000 /dev/urandom > "$T/other.bin"
env CLOUDFLARE_API_TOKEN="$TOKEN" CLOUDFLARE_ACCOUNT_ID=acct R2_API_BASE="http://127.0.0.1:$PORT" R2_S3_ENDPOINT="http://127.0.0.1:$PORT" \
  scripts/r2-s3 put "$BUCKET" "$KEY" "$T/other.bin" application/wasm 2>/dev/null || { echo "SETUP-FAILED: could not plant other bytes at the key"; exit 1; }
run creds "$DIR" "test message" --preview
ok "publish, key holds OTHER bytes: REFUSED, not overwritten, no deploy" '[ $RC = 1 ] && grep -q "is not the verified wasm" "$T/out" && [ "$(puts)" = 1 ] && ! deployed'
ok "  nothing was ever deleted" '! grep -q "^DELETE" "$T/mock.log"'


start_mock "$BUCKET" corruptget
run creds "$DIR" "test message" --preview
ok "publish, read-back differs from what was put: REFUSED, no deploy" '[ $RC = 1 ] && [ "$(puts)" = 1 ] && grep -q "is not the verified wasm" "$T/out" && ! deployed'

echo "VERDICT: $((N-F))/$N passed"; [ "$F" = 0 ]
